// C1a/C1c/C1d de-escalation cluster — live measurement
//
// Sends varied work prompts to a real model, records per-turn:
//   coherence, signals fired, composite pressure, governance level
//
// 25 turns of varied software engineering work (the C1d shape).
// Prompts are diverse on purpose — consecutive turns ask about
// different aspects of the same project, which is what triggers
// S10 and S15.

use agent
use governance
use log
use string

main {
    let prompts = [
        "Design the API for a task management system. Define the main entities: Task, Project, and User. Show the struct definitions with their fields and relationships.",
        "Implement the Task.create() method. It should validate required fields (title, project_id), generate a UUID, set created_at to now, and return the new Task.",
        "Write the Project.add_member() method. It needs to check if the user already exists in the project, verify the user has an active account, and handle the role assignment.",
        "Design the database schema for the task system. Define tables for tasks, projects, users, and the join table for project membership. Include indices.",
        "Implement the search function for tasks. It should support filtering by status, assignee, date range, and free-text search across title and description.",
        "Write unit tests for Task.create(). Cover: valid creation, missing title error, invalid project_id error, and verify the UUID format.",
        "Implement the notification system. When a task is assigned, send an email to the assignee. Define the NotificationService interface and the EmailNotifier implementation.",
        "Design the REST API endpoints for the task system. Define routes for CRUD operations on tasks, projects, and users. Include request/response schemas.",
        "Implement rate limiting for the API. Use a token bucket algorithm with configurable limits per user. Show the middleware implementation.",
        "Write the data migration script to add a 'priority' field to tasks. Handle the default value assignment for existing records and add the index.",
        "Implement the task dependency system. Tasks can block other tasks. Design the data model and implement cycle detection to prevent circular dependencies.",
        "Write the authentication middleware. Verify JWT tokens, extract user info, and attach it to the request context. Handle expired tokens gracefully.",
        "Design the caching layer for frequently accessed project data. Use Redis with a write-through strategy. Define cache keys and TTL policies.",
        "Implement the audit log system. Record all mutations to tasks and projects with the actor, timestamp, and a diff of changes.",
        "Write the CLI tool for the task system. Implement the 'task list', 'task create', and 'task assign' subcommands with flag parsing.",
        "Implement webhook support. When task status changes, notify registered webhook URLs. Handle retries with exponential backoff.",
        "Design the permissions model. Define roles (admin, member, viewer) with granular permissions. Implement the authorization check function.",
        "Write integration tests for the task search API. Test pagination, combined filters, empty results, and verify the response schema.",
        "Implement the task comment system. Users can add threaded comments to tasks. Design the data model and implement the add_comment and list_comments methods.",
        "Design the file attachment system for tasks. Handle upload, storage (S3-compatible), and retrieval. Include virus scanning integration.",
        "Implement the dashboard aggregation queries. Show: tasks per status, overdue tasks, team velocity (tasks completed per week), and project progress.",
        "Write the configuration management module. Load settings from environment variables with defaults, validate required fields, and support hot-reload.",
        "Implement the task template system. Users can create reusable templates with predefined fields. Implement create_from_template().",
        "Design the event sourcing architecture for the task system. Define events, the event store interface, and the projection for the current task state.",
        "Write the load testing script. Use k6 to simulate 100 concurrent users creating and searching tasks. Define success criteria and report metrics."
    ]

    let handle = agent.create("worker")
    let turn = 0
    let health = governance.health()

    log.info("=== C1 MEASUREMENT START ===")
    log.info("Initial level: " + string(health.get("mode")))

    for prompt in prompts {
        turn = turn + 1
        log.info("--- TURN " + string(turn) + " ---")
        log.info("Prompt: " + string.substring(prompt, 0, 60) + "...")

        try {
            let resp = agent.send(handle, prompt)
            let env = agent.environment(handle)
            let state = env.get("state")
            let coh = state.get("coherence") ?? "?"
            let level_str = state.get("governance_level") ?? "?"
            let content = resp.get("content") ?? ""
            let deesc = state.get("deescalate_calm_turns") ?? -1
            log.info("  coherence=" + string(coh) + " level=" + string(level_str) + " calm=" + string(deesc) + " len=" + string(string.length(content)))
        } catch (e) {
            log.info("  ERROR: " + string(e))
            // Read state even on error
            let env = agent.environment(handle)
            let state = env.get("state")
            let coh = state.get("coherence") ?? "?"
            let level_str = state.get("governance_level") ?? "?"
            log.info("  coherence=" + string(coh) + " level=" + string(level_str) + " (after error)")
        }
    }

    log.info("=== C1 MEASUREMENT END ===")
    log.info("Final coherence: " + string(agent.environment(handle).get("state").get("coherence")))
    log.info("Final level: " + string(agent.environment(handle).get("governance_level")))
}

      "provider": "gemini",
      "model": "gemini-3.1-flash-lite",
      "api_key_env": ["GK1", "GK2", "GK3", "GK4", "GK5", "GK6"],
      "max_tokens": 2048,
      "min_tokens": 1024,
      "thinking_budget": 1024,
      "max_turns": 15,
      "max_total_tokens": 200000,
      "system_prompt": "You are an integration engineer verifying that the build engine (Python), deploy script (Shell), and test harness work together correctly. Check that build outputs feed into the deploy script, that the deploy script's smoke tests match the test harness expectations, and that end-to-end flows work. Report integration issues with specific component attribution.",
      "response_format": "text",

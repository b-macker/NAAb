async function compute(n) {
    let sum = 0
    for i in 0..n {
        sum = sum + i
    }
    return sum
}

async function add(a, b) {
    return a + b
}

async function returns_string() {
    return "hello async"
}

main {
    let passed = 0
    let total = 0

    total = total + 1
    let f1 = compute(10)
    let r1 = await f1
    if r1 == 45 {
        passed = passed + 1
        io.println("PASS: basic async")
    } else {
        io.println("FAIL: basic async, got " + string(r1))
    }

    total = total + 1
    let r2 = await compute(5)
    if r2 == 10 {
        passed = passed + 1
        io.println("PASS: await inline")
    } else {
        io.println("FAIL: await inline, got " + string(r2))
    }

    total = total + 1
    let fa = compute(100)
    let fb = compute(50)
    let ra = await fa
    let rb = await fb
    if ra == 4950 && rb == 1225 {
        passed = passed + 1
        io.println("PASS: multiple async")
    } else {
        io.println("FAIL: multiple async")
    }

    total = total + 1
    let r4 = await add(3, 7)
    if r4 == 10 {
        passed = passed + 1
        io.println("PASS: async two params")
    } else {
        io.println("FAIL: async two params")
    }

    total = total + 1
    let r5 = await returns_string()
    if r5 == "hello async" {
        passed = passed + 1
        io.println("PASS: async string return")
    } else {
        io.println("FAIL: async string return")
    }

    total = total + 1
    let r6 = await 42
    if r6 == 42 {
        passed = passed + 1
        io.println("PASS: await non-future")
    } else {
        io.println("FAIL: await non-future")
    }

    total = total + 1
    let r7 = await compute(0)
    if r7 == 0 {
        passed = passed + 1
        io.println("PASS: async zero")
    } else {
        io.println("FAIL: async zero")
    }

    total = total + 1
    let r8a = await compute(3)
    let r8b = await add(r8a, 10)
    if r8b == 13 {
        passed = passed + 1
        io.println("PASS: chained async")
    } else {
        io.println("FAIL: chained async")
    }

    total = total + 1
    let r9 = (await compute(4)) + 100
    if r9 == 106 {
        passed = passed + 1
        io.println("PASS: async in expression")
    } else {
        io.println("FAIL: async in expression")
    }

    total = total + 1
    let shared = compute(6)
    let r10a = await shared
    let r10b = await shared
    if r10a == 15 && r10b == 15 {
        passed = passed + 1
        io.println("PASS: multiple await same future")
    } else {
        io.println("FAIL: multiple await same future")
    }

    io.println("")
    io.println("Async: " + string(passed) + "/" + string(total) + " passed")
}

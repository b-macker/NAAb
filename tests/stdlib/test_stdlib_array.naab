function test_basic_ops() {
    let passed = 0
    let total = 0

    let arr = [1, 2, 3]

    total = total + 1
    if array.length(arr) == 3 { passed = passed + 1 }
    else { io.println("[FAIL] length: expected 3, got " + ("" + array.length(arr))) }

    total = total + 1
    arr.push(4)
    if array.length(arr) == 4 { passed = passed + 1 }
    else { io.println("[FAIL] push length: expected 4") }

    total = total + 1
    let last_val = array.last(arr)
    if last_val == 4 { passed = passed + 1 }
    else { io.println("[FAIL] last after push: expected 4, got " + ("" + last_val)) }

    total = total + 1
    let popped_val = array.pop(arr)
    if popped_val == 4 { passed = passed + 1 }
    else { io.println("[FAIL] pop returns element: expected 4, got " + ("" + popped_val)) }

    total = total + 1
    if array.length(arr) == 3 { passed = passed + 1 }
    else { io.println("[FAIL] arr length after pop: expected 3, got " + ("" + array.length(arr))) }

    total = total + 1
    let shift_arr = [10, 20, 30]
    let shifted_val = array.shift(shift_arr)
    if shifted_val == 10 { passed = passed + 1 }
    else { io.println("[FAIL] shift returns element: expected 10, got " + ("" + shifted_val)) }

    total = total + 1
    if array.length(shift_arr) == 2 { passed = passed + 1 }
    else { io.println("[FAIL] arr length after shift: expected 2, got " + ("" + array.length(shift_arr))) }

    total = total + 1
    let unshifted = array.unshift([2, 3], 1)
    if unshifted[0] == 1 { passed = passed + 1 }
    else { io.println("[FAIL] unshift[0]: expected 1, got " + ("" + unshifted[0])) }

    total = total + 1
    let fst = array.first([5, 6, 7])
    if fst == 5 { passed = passed + 1 }
    else { io.println("[FAIL] first: expected 5, got " + ("" + fst)) }

    total = total + 1
    let lst = array.last([5, 6, 7])
    if lst == 7 { passed = passed + 1 }
    else { io.println("[FAIL] last: expected 7, got " + ("" + lst)) }

    total = total + 1
    if array.contains([1, 2, 3], 2) { passed = passed + 1 }
    else { io.println("[FAIL] contains true") }

    total = total + 1
    if array.contains([1, 2, 3], 9) == false { passed = passed + 1 }
    else { io.println("[FAIL] contains false") }

    total = total + 1
    let idx = array.index_of([10, 20, 30], 20)
    if idx == 1 { passed = passed + 1 }
    else { io.println("[FAIL] index_of: expected 1, got " + ("" + idx)) }

    total = total + 1
    let idx_miss = array.index_of([10, 20, 30], 99)
    if idx_miss == -1 { passed = passed + 1 }
    else { io.println("[FAIL] index_of miss: expected -1, got " + ("" + idx_miss)) }

    total = total + 1
    let j = array.join(["a", "b", "c"], "-")
    if j == "a-b-c" { passed = passed + 1 }
    else { io.println("[FAIL] join: expected a-b-c, got " + j) }

    return [passed, total]
}

function test_hof() {
    let passed = 0
    let total = 0

    let nums = [1, 2, 3, 4, 5]

    total = total + 1
    let doubled = array.map_fn(nums, fn(x) { return x * 2 })
    if doubled[0] == 2 { passed = passed + 1 }
    else { io.println("[FAIL] map_fn[0]: expected 2, got " + ("" + doubled[0])) }

    total = total + 1
    if doubled[4] == 10 { passed = passed + 1 }
    else { io.println("[FAIL] map_fn[4]: expected 10, got " + ("" + doubled[4])) }

    total = total + 1
    let evens = array.filter_fn(nums, fn(x) { return x % 2 == 0 })
    if array.length(evens) == 2 { passed = passed + 1 }
    else { io.println("[FAIL] filter_fn length: expected 2, got " + ("" + array.length(evens))) }

    total = total + 1
    let sum = array.reduce_fn(nums, fn(acc, x) { return acc + x }, 0)
    if sum == 15 { passed = passed + 1 }
    else { io.println("[FAIL] reduce_fn: expected 15, got " + ("" + sum)) }

    total = total + 1
    let found = array.find(nums, fn(x) { return x > 3 })
    if found == 4 { passed = passed + 1 }
    else { io.println("[FAIL] find: expected 4, got " + ("" + found)) }

    total = total + 1
    let sliced = array.slice(nums, 1, 3)
    if array.length(sliced) == 2 { passed = passed + 1 }
    else { io.println("[FAIL] slice length: expected 2, got " + ("" + array.length(sliced))) }

    total = total + 1
    if sliced[0] == 2 { passed = passed + 1 }
    else { io.println("[FAIL] slice[0]: expected 2, got " + ("" + sliced[0])) }

    total = total + 1
    let rev = array.reverse([1, 2, 3])
    if rev[0] == 3 { passed = passed + 1 }
    else { io.println("[FAIL] reverse[0]: expected 3, got " + ("" + rev[0])) }

    total = total + 1
    let sorted = array.sort([3, 1, 2])
    if sorted[0] == 1 { passed = passed + 1 }
    else { io.println("[FAIL] sort[0]: expected 1, got " + ("" + sorted[0])) }

    total = total + 1
    if sorted[2] == 3 { passed = passed + 1 }
    else { io.println("[FAIL] sort[2]: expected 3, got " + ("" + sorted[2])) }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_basic_ops()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_hof()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    io.println("stdlib/array: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests { throw "stdlib test failures" }
}

use regex

function test_matches() {
    let passed = 0
    let total = 0

    total = total + 1
    if regex.matches("hello", "h.*o") { passed = passed + 1 }
    else { io.println("[FAIL] matches h.*o on hello") }

    total = total + 1
    if regex.matches("world", "^world$") { passed = passed + 1 }
    else { io.println("[FAIL] matches ^world$") }

    total = total + 1
    if regex.matches("abc", "^[0-9]+$") == false { passed = passed + 1 }
    else { io.println("[FAIL] matches digits on abc should be false") }

    return [passed, total]
}

function test_search() {
    let passed = 0
    let total = 0

    total = total + 1
    if regex.search("test 123 abc", "[0-9]+") { passed = passed + 1 }
    else { io.println("[FAIL] search digits in string") }

    total = total + 1
    if regex.search("no digits here", "[0-9]+") == false { passed = passed + 1 }
    else { io.println("[FAIL] search no digits should be false") }

    return [passed, total]
}

function test_find() {
    let passed = 0
    let total = 0

    total = total + 1
    let found = regex.find("foo123bar", "[0-9]+")
    if found == "123" { passed = passed + 1 }
    else { io.println("[FAIL] find digits: expected 123, got " + ("" + found)) }

    return [passed, total]
}

function test_find_all() {
    let passed = 0
    let total = 0

    total = total + 1
    let all = regex.find_all("1a2b3c", "[0-9]")
    if array.length(all) == 3 { passed = passed + 1 }
    else { io.println("[FAIL] find_all count: expected 3, got " + ("" + array.length(all))) }

    total = total + 1
    if all[0] == "1" { passed = passed + 1 }
    else { io.println("[FAIL] find_all[0]: expected 1, got " + all[0]) }

    total = total + 1
    if all[2] == "3" { passed = passed + 1 }
    else { io.println("[FAIL] find_all[2]: expected 3, got " + all[2]) }

    return [passed, total]
}

function test_replace() {
    let passed = 0
    let total = 0

    total = total + 1
    let r = regex.replace("foo bar baz", " ", "-")
    if r == "foo-bar-baz" { passed = passed + 1 }
    else { io.println("[FAIL] replace spaces: expected foo-bar-baz, got " + r) }

    return [passed, total]
}

function test_split() {
    let passed = 0
    let total = 0

    total = total + 1
    let parts = regex.split("a1b2c", "[0-9]")
    if array.length(parts) == 3 { passed = passed + 1 }
    else { io.println("[FAIL] split count: expected 3, got " + ("" + array.length(parts))) }

    total = total + 1
    if parts[0] == "a" { passed = passed + 1 }
    else { io.println("[FAIL] split[0]: expected a, got " + parts[0]) }

    total = total + 1
    if parts[2] == "c" { passed = passed + 1 }
    else { io.println("[FAIL] split[2]: expected c, got " + parts[2]) }

    return [passed, total]
}

function test_groups() {
    let passed = 0
    let total = 0

    total = total + 1
    let g = regex.groups("2024-01-15", "([0-9]+)-([0-9]+)-([0-9]+)")
    if array.length(g) == 4 { passed = passed + 1 }
    else { io.println("[FAIL] groups count: expected 4 (full+3 groups), got " + ("" + array.length(g))) }

    total = total + 1
    if g[1] == "2024" { passed = passed + 1 }
    else { io.println("[FAIL] groups[1]: expected 2024, got " + g[1]) }

    return [passed, total]
}

function test_is_valid() {
    let passed = 0
    let total = 0

    total = total + 1
    if regex.is_valid("[a-z]+") { passed = passed + 1 }
    else { io.println("[FAIL] is_valid good pattern") }

    total = total + 1
    if regex.is_valid("[bad") == false { passed = passed + 1 }
    else { io.println("[FAIL] is_valid bad pattern should be false") }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_matches()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_search()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_find()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    let r4 = test_find_all()
    total_passed = total_passed + r4[0]
    total_tests = total_tests + r4[1]

    let r5 = test_replace()
    total_passed = total_passed + r5[0]
    total_tests = total_tests + r5[1]

    let r6 = test_split()
    total_passed = total_passed + r6[0]
    total_tests = total_tests + r6[1]

    let r7 = test_groups()
    total_passed = total_passed + r7[0]
    total_tests = total_tests + r7[1]

    let r8 = test_is_valid()
    total_passed = total_passed + r8[0]
    total_tests = total_tests + r8[1]

    io.println("stdlib/regex: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests { throw "stdlib test failures" }
}

use time

function test_now() {
    let passed = 0
    let total = 0

    total = total + 1
    let ts = time.now()
    if ts > 1000000000 { passed = passed + 1 }
    else { io.println("[FAIL] now() > 1000000000: got " + ("" + ts)) }

    total = total + 1
    let ms = time.now_millis()
    if ms > 1000000000000 { passed = passed + 1 }
    else { io.println("[FAIL] now_millis() > 1e12: got " + ("" + ms)) }

    return [passed, total]
}

function test_components() {
    let passed = 0
    let total = 0

    total = total + 1
    let yr = time.year()
    if yr >= 2024 { passed = passed + 1 }
    else { io.println("[FAIL] year >= 2024: got " + ("" + yr)) }

    total = total + 1
    let mo = time.month()
    if mo >= 1 { passed = passed + 1 }
    else { io.println("[FAIL] month >= 1: got " + ("" + mo)) }

    total = total + 1
    if mo <= 12 { passed = passed + 1 }
    else { io.println("[FAIL] month <= 12: got " + ("" + mo)) }

    total = total + 1
    let dy = time.day()
    if dy >= 1 { passed = passed + 1 }
    else { io.println("[FAIL] day >= 1: got " + ("" + dy)) }

    total = total + 1
    if dy <= 31 { passed = passed + 1 }
    else { io.println("[FAIL] day <= 31: got " + ("" + dy)) }

    total = total + 1
    let hr = time.hour()
    if hr >= 0 { passed = passed + 1 }
    else { io.println("[FAIL] hour >= 0: got " + ("" + hr)) }

    total = total + 1
    if hr <= 23 { passed = passed + 1 }
    else { io.println("[FAIL] hour <= 23: got " + ("" + hr)) }

    return [passed, total]
}

function test_sleep() {
    let passed = 0
    let total = 0

    total = total + 1
    time.sleep(0.001)
    passed = passed + 1

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_now()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_components()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_sleep()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    io.println("stdlib/time: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests { throw "stdlib test failures" }
}

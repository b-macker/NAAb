use csv

function test_parse_row() {
    let passed = 0
    let total = 0

    let rows = csv.parse("a,b,c")

    total = total + 1
    if array.length(rows) == 1 { passed = passed + 1 }
    else { io.println("[FAIL] parse rows: expected 1, got " + ("" + array.length(rows))) }

    total = total + 1
    let row = rows[0]
    if array.length(row) == 3 { passed = passed + 1 }
    else { io.println("[FAIL] parse cols: expected 3, got " + ("" + array.length(row))) }

    total = total + 1
    if row[0] == "a" { passed = passed + 1 }
    else { io.println("[FAIL] parse[0]: expected a, got " + row[0]) }

    total = total + 1
    if row[2] == "c" { passed = passed + 1 }
    else { io.println("[FAIL] parse[2]: expected c, got " + row[2]) }

    return [passed, total]
}

function test_parse_multirow() {
    let passed = 0
    let total = 0

    let rows = csv.parse("1,2\n3,4")

    total = total + 1
    if array.length(rows) == 2 { passed = passed + 1 }
    else { io.println("[FAIL] multirow count: expected 2, got " + ("" + array.length(rows))) }

    total = total + 1
    if rows[1][0] == "3" { passed = passed + 1 }
    else { io.println("[FAIL] row2[0]: expected 3, got " + rows[1][0]) }

    return [passed, total]
}

function test_format_row() {
    let passed = 0
    let total = 0

    total = total + 1
    let r = csv.format_row(["x", "y", "z"])
    if r == "x,y,z" { passed = passed + 1 }
    else { io.println("[FAIL] format_row: expected x,y,z, got " + r) }

    return [passed, total]
}

function test_parse_dict() {
    let passed = 0
    let total = 0

    let rows = csv.parse_dict("name,age\nAlice,30\nBob,25")

    total = total + 1
    if array.length(rows) == 2 { passed = passed + 1 }
    else { io.println("[FAIL] parse_dict rows: expected 2, got " + ("" + array.length(rows))) }

    total = total + 1
    let first = rows[0]
    if first["name"] == "Alice" { passed = passed + 1 }
    else { io.println("[FAIL] parse_dict name: expected Alice, got " + first["name"]) }

    total = total + 1
    if first["age"] == "30" { passed = passed + 1 }
    else { io.println("[FAIL] parse_dict age: expected 30, got " + first["age"]) }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_parse_row()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_parse_multirow()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_format_row()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    let r4 = test_parse_dict()
    total_passed = total_passed + r4[0]
    total_tests = total_tests + r4[1]

    io.println("stdlib/csv: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests { throw "stdlib test failures" }
}

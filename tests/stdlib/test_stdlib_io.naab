// stdlib/io tests — write, println, write_file, read_file, exists, list_dir
use io
use string
use array

function test_console_write() {
    let passed = 0
    let total = 0

    // io.write — returns null (no crash)
    total = total + 1
    let r = io.write("test-io-write ")
    if r == null { passed = passed + 1 } else { io.println("[FAIL] io.write returns null") }

    // io.println — returns null (no crash)
    total = total + 1
    let r2 = io.println("")
    if r2 == null { passed = passed + 1 } else { io.println("[FAIL] io.println returns null") }

    // io.print — alias, returns null
    total = total + 1
    let r3 = io.print("")
    if r3 == null { passed = passed + 1 } else { io.println("[FAIL] io.print returns null") }

    return [passed, total]
}

function test_file_roundtrip() {
    let passed = 0
    let total = 0
    let path = "/tmp/.naab_io_test.txt"
    let content = "naab io test content line1\nline2\n"

    // write_file succeeds (returns true)
    total = total + 1
    let wrote = io.write_file(path, content)
    if wrote { passed = passed + 1 } else { io.println("[FAIL] io.write_file returned false") }

    // read_file round-trip
    total = total + 1
    let back = io.read_file(path)
    if back == content { passed = passed + 1 }
    else { io.println("[FAIL] io.read_file round-trip, got: " + back) }

    return [passed, total]
}

function test_exists() {
    let passed = 0
    let total = 0
    let path = "/tmp/.naab_io_test.txt"
    let nonexistent = "/tmp/.naab_io_test_MISSING_XYZ123.txt"

    // Existing file (written by test_file_roundtrip)
    total = total + 1
    io.write_file(path, "exists-check")
    if io.exists(path) { passed = passed + 1 } else { io.println("[FAIL] io.exists true") }

    // Non-existing file
    total = total + 1
    if !(io.exists(nonexistent)) { passed = passed + 1 } else { io.println("[FAIL] io.exists false") }

    return [passed, total]
}

function test_list_dir() {
    let passed = 0
    let total = 0
    let dir = "/tmp"
    let path = dir + "/.naab_io_list_test.txt"

    // Write a file into home dir, then list home dir and verify it appears
    io.write_file(path, "listing test")

    total = total + 1
    let entries = io.list_dir(dir)
    let found = false
    for name in entries {
        if name == ".naab_io_list_test.txt" { found = true }
    }
    if found { passed = passed + 1 } else { io.println("[FAIL] io.list_dir did not find .naab_io_list_test.txt") }

    return [passed, total]
}

function test_output() {
    let passed = 0
    let total = 0

    // io.output always writes to stdout even in pipe mode
    total = total + 1
    let r = io.output("test-output ")
    if r == null { passed = passed + 1 } else { io.println("[FAIL] io.output returns null") }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_console_write()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_file_roundtrip()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_exists()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    let r4 = test_list_dir()
    total_passed = total_passed + r4[0]
    total_tests = total_tests + r4[1]

    let r5 = test_output()
    total_passed = total_passed + r5[0]
    total_tests = total_tests + r5[1]

    io.println("stdlib/io: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests { throw "stdlib io test failures" }
}

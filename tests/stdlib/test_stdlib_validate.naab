use validate

function test_email() {
    let passed = 0
    let total = 0

    total = total + 1
    if validate.email("user@example.com") { passed = passed + 1 }
    else { io.println("[FAIL] email valid: user@example.com") }

    total = total + 1
    if validate.email("a@b.co") { passed = passed + 1 }
    else { io.println("[FAIL] email valid: a@b.co") }

    total = total + 1
    if validate.email("notanemail") == false { passed = passed + 1 }
    else { io.println("[FAIL] email invalid: notanemail") }

    total = total + 1
    if validate.email("missing@tld") == false { passed = passed + 1 }
    else { io.println("[FAIL] email invalid: missing@tld") }

    total = total + 1
    if validate.email("") == false { passed = passed + 1 }
    else { io.println("[FAIL] email invalid: empty string") }

    return [passed, total]
}

function test_url() {
    let passed = 0
    let total = 0

    total = total + 1
    if validate.url("https://example.com") { passed = passed + 1 }
    else { io.println("[FAIL] url valid: https://example.com") }

    total = total + 1
    if validate.url("http://a.com/path?q=1") { passed = passed + 1 }
    else { io.println("[FAIL] url valid: http with path") }

    total = total + 1
    if validate.url("ftp://files.example.com") { passed = passed + 1 }
    else { io.println("[FAIL] url valid: ftp://") }

    total = total + 1
    if validate.url("not-a-url") == false { passed = passed + 1 }
    else { io.println("[FAIL] url invalid: not-a-url") }

    total = total + 1
    if validate.url("") == false { passed = passed + 1 }
    else { io.println("[FAIL] url invalid: empty string") }

    return [passed, total]
}

function test_ip() {
    let passed = 0
    let total = 0

    total = total + 1
    if validate.ip("192.168.1.1") { passed = passed + 1 }
    else { io.println("[FAIL] ip valid: 192.168.1.1") }

    total = total + 1
    if validate.ip("0.0.0.0") { passed = passed + 1 }
    else { io.println("[FAIL] ip valid: 0.0.0.0") }

    total = total + 1
    if validate.ip("255.255.255.255") { passed = passed + 1 }
    else { io.println("[FAIL] ip valid: 255.255.255.255") }

    total = total + 1
    if validate.ip("256.1.1.1") == false { passed = passed + 1 }
    else { io.println("[FAIL] ip invalid: 256.1.1.1") }

    total = total + 1
    if validate.ip("1.2.3") == false { passed = passed + 1 }
    else { io.println("[FAIL] ip invalid: 1.2.3 (only 3 octets)") }

    return [passed, total]
}

function test_ranges() {
    let passed = 0
    let total = 0

    total = total + 1
    if validate.int_range(5, 1, 10) { passed = passed + 1 }
    else { io.println("[FAIL] int_range(5,1,10) should be true") }

    total = total + 1
    if validate.int_range(1, 1, 10) { passed = passed + 1 }
    else { io.println("[FAIL] int_range(1,1,10) lower bound should be true") }

    total = total + 1
    if validate.int_range(10, 1, 10) { passed = passed + 1 }
    else { io.println("[FAIL] int_range(10,1,10) upper bound should be true") }

    total = total + 1
    if validate.int_range(0, 1, 10) == false { passed = passed + 1 }
    else { io.println("[FAIL] int_range(0,1,10) should be false") }

    total = total + 1
    if validate.int_range(11, 1, 10) == false { passed = passed + 1 }
    else { io.println("[FAIL] int_range(11,1,10) should be false") }

    return [passed, total]
}

function test_string_checks() {
    let passed = 0
    let total = 0

    total = total + 1
    if validate.not_empty("hello") { passed = passed + 1 }
    else { io.println("[FAIL] not_empty: hello") }

    total = total + 1
    if validate.not_empty("") == false { passed = passed + 1 }
    else { io.println("[FAIL] not_empty: empty string should be false") }

    total = total + 1
    if validate.not_empty("   ") == false { passed = passed + 1 }
    else { io.println("[FAIL] not_empty: whitespace-only should be false") }

    total = total + 1
    if validate.length("hello", 1, 10) { passed = passed + 1 }
    else { io.println("[FAIL] length(hello,1,10) should be true") }

    total = total + 1
    if validate.length("hi", 5, 10) == false { passed = passed + 1 }
    else { io.println("[FAIL] length(hi,5,10) should be false (too short)") }

    total = total + 1
    if validate.length("hello", 5, 5) { passed = passed + 1 }
    else { io.println("[FAIL] length(hello,5,5) exact match should be true") }

    return [passed, total]
}

function test_type_checks() {
    let passed = 0
    let total = 0

    total = total + 1
    if validate.is_string("hello") { passed = passed + 1 }
    else { io.println("[FAIL] is_string(hello)") }

    total = total + 1
    if validate.is_string(42) == false { passed = passed + 1 }
    else { io.println("[FAIL] is_string(42) should be false") }

    total = total + 1
    if validate.is_int(42) { passed = passed + 1 }
    else { io.println("[FAIL] is_int(42)") }

    total = total + 1
    if validate.is_int("42") == false { passed = passed + 1 }
    else { io.println("[FAIL] is_int(\"42\") should be false") }

    total = total + 1
    if validate.is_float(3.14) { passed = passed + 1 }
    else { io.println("[FAIL] is_float(3.14)") }

    total = total + 1
    if validate.is_float(42) == false { passed = passed + 1 }
    else { io.println("[FAIL] is_float(42) should be false (integer)") }

    return [passed, total]
}

function test_matches() {
    let passed = 0
    let total = 0

    total = total + 1
    if validate.matches("ABC123", "^[A-Z]{3}[0-9]{3}$") { passed = passed + 1 }
    else { io.println("[FAIL] matches ABC123") }

    total = total + 1
    if validate.matches("abc123", "^[A-Z]{3}[0-9]{3}$") == false { passed = passed + 1 }
    else { io.println("[FAIL] matches lowercase should fail uppercase pattern") }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_email()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_url()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_ip()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    let r4 = test_ranges()
    total_passed = total_passed + r4[0]
    total_tests = total_tests + r4[1]

    let r5 = test_string_checks()
    total_passed = total_passed + r5[0]
    total_tests = total_tests + r5[1]

    let r6 = test_type_checks()
    total_passed = total_passed + r6[0]
    total_tests = total_tests + r6[1]

    let r7 = test_matches()
    total_passed = total_passed + r7[0]
    total_tests = total_tests + r7[1]

    io.println("stdlib/validate: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests { throw "stdlib test failures" }
}

use file
use env

function test_write_read() {
    let passed = 0
    let total = 0
    let tmp = env.get("HOME") + "/.naab_stdlib_test_tmp"

    file.create_dir(tmp)
    let path = tmp + "/test_write_read.txt"
    let content = "hello stdlib file test"

    file.write(path, content)

    total = total + 1
    let read_back = file.read(path)
    if read_back == content { passed = passed + 1 }
    else { io.println("[FAIL] write/read: expected '" + content + "', got '" + read_back + "'") }

    file.delete(path)
    return [passed, total]
}

function test_exists_delete() {
    let passed = 0
    let total = 0
    let tmp = env.get("HOME") + "/.naab_stdlib_test_tmp"
    let path = tmp + "/test_exists.txt"

    file.write(path, "data")

    total = total + 1
    if file.exists(path) { passed = passed + 1 }
    else { io.println("[FAIL] exists after write") }

    file.delete(path)

    total = total + 1
    if file.exists(path) == false { passed = passed + 1 }
    else { io.println("[FAIL] exists after delete should be false") }

    return [passed, total]
}

function test_append() {
    let passed = 0
    let total = 0
    let tmp = env.get("HOME") + "/.naab_stdlib_test_tmp"
    let path = tmp + "/test_append.txt"

    file.write(path, "part1")
    file.append(path, "part2")

    total = total + 1
    let content = file.read(path)
    if string.contains(content, "part1") { passed = passed + 1 }
    else { io.println("[FAIL] append: part1 not found in " + content) }

    total = total + 1
    if string.contains(content, "part2") { passed = passed + 1 }
    else { io.println("[FAIL] append: part2 not found in " + content) }

    file.delete(path)
    return [passed, total]
}

function test_lines() {
    let passed = 0
    let total = 0
    let tmp = env.get("HOME") + "/.naab_stdlib_test_tmp"
    let path = tmp + "/test_lines.txt"

    file.write_lines(path, ["alpha", "beta", "gamma"])

    total = total + 1
    let lines = file.read_lines(path)
    if array.length(lines) == 3 { passed = passed + 1 }
    else { io.println("[FAIL] read_lines count: expected 3, got " + ("" + array.length(lines))) }

    total = total + 1
    if lines[0] == "alpha" { passed = passed + 1 }
    else { io.println("[FAIL] lines[0]: expected alpha, got " + lines[0]) }

    total = total + 1
    if lines[2] == "gamma" { passed = passed + 1 }
    else { io.println("[FAIL] lines[2]: expected gamma, got " + lines[2]) }

    file.delete(path)
    return [passed, total]
}

function test_dir_ops() {
    let passed = 0
    let total = 0
    let tmp = env.get("HOME") + "/.naab_stdlib_test_tmp"
    let subdir = tmp + "/subdir_test"

    file.create_dir(subdir)

    total = total + 1
    if file.is_dir(subdir) { passed = passed + 1 }
    else { io.println("[FAIL] is_dir after create_dir") }

    file.write(subdir + "/f1.txt", "x")
    file.write(subdir + "/f2.txt", "y")

    total = total + 1
    let entries = file.list_dir(subdir)
    if array.length(entries) == 2 { passed = passed + 1 }
    else { io.println("[FAIL] list_dir count: expected 2, got " + ("" + array.length(entries))) }

    file.delete(subdir + "/f1.txt")
    file.delete(subdir + "/f2.txt")
    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_write_read()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_exists_delete()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_append()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    let r4 = test_lines()
    total_passed = total_passed + r4[0]
    total_tests = total_tests + r4[1]

    let r5 = test_dir_ops()
    total_passed = total_passed + r5[0]
    total_tests = total_tests + r5[1]

    io.println("stdlib/file: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests { throw "stdlib test failures" }
}

// GC Stress Test: Allocate enough objects to trigger automatic collection
// Default threshold is 5000. This test allocates 6000+ strings/lists
// to verify the GC fires without crashing.

function make_strings() {
    let passed = 0
    let total = 0

    // Allocate 6100 string values in a loop — crosses default threshold of 5000
    let count = 0
    for i in 0..6100 {
        let s = "string_" + i
        count = count + 1
    }

    total = total + 1
    if count == 6100 {
        passed = passed + 1
    } else {
        io.println("FAIL: expected 6100 iterations, got " + count)
    }

    return [passed, total]
}

function make_lists() {
    let passed = 0
    let total = 0

    // Allocate 1100 lists — combined with make_strings triggers more GC cycles
    let count = 0
    for i in 0..1100 {
        let lst = [i, i + 1, i + 2]
        count = count + 1
    }

    total = total + 1
    if count == 1100 {
        passed = passed + 1
    } else {
        io.println("FAIL: expected 1100 iterations, got " + count)
    }

    return [passed, total]
}

function make_dicts() {
    let passed = 0
    let total = 0

    let count = 0
    for i in 0..500 {
        let d = {"key": i, "val": i * 2}
        count = count + 1
    }

    total = total + 1
    if count == 500 {
        passed = passed + 1
    } else {
        io.println("FAIL: expected 500 iterations, got " + count)
    }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = make_strings()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = make_lists()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = make_dicts()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    io.println("GC Stress: " + total_passed + "/" + total_tests + " passed")
}

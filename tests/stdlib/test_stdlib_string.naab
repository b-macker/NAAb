use string

function test_transform() {
    let passed = 0
    let total = 0

    total = total + 1
    if string.upper("hello") == "HELLO" { passed = passed + 1 }
    else { io.println("[FAIL] upper: expected HELLO, got " + string.upper("hello")) }

    total = total + 1
    if string.lower("WORLD") == "world" { passed = passed + 1 }
    else { io.println("[FAIL] lower: expected world") }

    total = total + 1
    if string.trim("  hi  ") == "hi" { passed = passed + 1 }
    else { io.println("[FAIL] trim: expected hi, got '" + string.trim("  hi  ") + "'") }

    total = total + 1
    if string.reverse("abc") == "cba" { passed = passed + 1 }
    else { io.println("[FAIL] reverse: expected cba, got " + string.reverse("abc")) }

    total = total + 1
    if string.repeat("ab", 3) == "ababab" { passed = passed + 1 }
    else { io.println("[FAIL] repeat: expected ababab, got " + string.repeat("ab", 3)) }

    return [passed, total]
}

function test_search() {
    let passed = 0
    let total = 0

    total = total + 1
    if string.contains("hello world", "world") { passed = passed + 1 }
    else { io.println("[FAIL] contains true") }

    total = total + 1
    if string.contains("hello", "xyz") == false { passed = passed + 1 }
    else { io.println("[FAIL] contains false") }

    total = total + 1
    if string.starts_with("hello", "he") { passed = passed + 1 }
    else { io.println("[FAIL] starts_with true") }

    total = total + 1
    if string.starts_with("hello", "lo") == false { passed = passed + 1 }
    else { io.println("[FAIL] starts_with false") }

    total = total + 1
    if string.ends_with("hello", "lo") { passed = passed + 1 }
    else { io.println("[FAIL] ends_with true") }

    total = total + 1
    if string.ends_with("hello", "he") == false { passed = passed + 1 }
    else { io.println("[FAIL] ends_with false") }

    total = total + 1
    let idx = string.index_of("hello", "ll")
    if idx == 2 { passed = passed + 1 }
    else { io.println("[FAIL] index_of: expected 2, got " + ("" + idx)) }

    return [passed, total]
}

function test_split_join() {
    let passed = 0
    let total = 0

    total = total + 1
    let parts = string.split("a,b,c", ",")
    if array.length(parts) == 3 { passed = passed + 1 }
    else { io.println("[FAIL] split length: expected 3, got " + ("" + array.length(parts))) }

    total = total + 1
    if parts[0] == "a" { passed = passed + 1 }
    else { io.println("[FAIL] split[0]: expected a, got " + parts[0]) }

    total = total + 1
    if parts[2] == "c" { passed = passed + 1 }
    else { io.println("[FAIL] split[2]: expected c, got " + parts[2]) }

    total = total + 1
    let joined = string.join(["x", "y", "z"], "-")
    if joined == "x-y-z" { passed = passed + 1 }
    else { io.println("[FAIL] join: expected x-y-z, got " + joined) }

    return [passed, total]
}

function test_substr() {
    let passed = 0
    let total = 0

    total = total + 1
    let s = string.substring("hello world", 6, 11)
    if s == "world" { passed = passed + 1 }
    else { io.println("[FAIL] substring: expected world, got " + s) }

    total = total + 1
    let len = string.length("hello")
    if len == 5 { passed = passed + 1 }
    else { io.println("[FAIL] length: expected 5, got " + ("" + len)) }

    total = total + 1
    let c = string.char_at("hello", 1)
    if c == "e" { passed = passed + 1 }
    else { io.println("[FAIL] char_at(1): expected e, got " + c) }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_transform()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_search()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_split_join()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    let r4 = test_substr()
    total_passed = total_passed + r4[0]
    total_tests = total_tests + r4[1]

    io.println("stdlib/string: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests { throw "stdlib test failures" }
}

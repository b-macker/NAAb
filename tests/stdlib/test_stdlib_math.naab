use math

function test_arithmetic() {
    let passed = 0
    let total = 0

    total = total + 1
    if math.abs(-5) == 5 { passed = passed + 1 }
    else { io.println("[FAIL] abs(-5): expected 5, got " + ("" + math.abs(-5))) }

    total = total + 1
    if math.abs(3) == 3 { passed = passed + 1 }
    else { io.println("[FAIL] abs(3): expected 3") }

    total = total + 1
    let sq = math.sqrt(9.0)
    if sq == 3.0 { passed = passed + 1 }
    else { io.println("[FAIL] sqrt(9): expected 3.0, got " + ("" + sq)) }

    total = total + 1
    if math.pow(2.0, 10.0) == 1024.0 { passed = passed + 1 }
    else { io.println("[FAIL] pow(2,10): expected 1024") }

    total = total + 1
    if math.floor(3.7) == 3 { passed = passed + 1 }
    else { io.println("[FAIL] floor(3.7): expected 3, got " + ("" + math.floor(3.7))) }

    total = total + 1
    if math.ceil(3.2) == 4 { passed = passed + 1 }
    else { io.println("[FAIL] ceil(3.2): expected 4, got " + ("" + math.ceil(3.2))) }

    total = total + 1
    if math.round(3.5) == 4 { passed = passed + 1 }
    else { io.println("[FAIL] round(3.5): expected 4, got " + ("" + math.round(3.5))) }

    total = total + 1
    if math.round(3.4) == 3 { passed = passed + 1 }
    else { io.println("[FAIL] round(3.4): expected 3, got " + ("" + math.round(3.4))) }

    return [passed, total]
}

function test_minmax() {
    let passed = 0
    let total = 0

    total = total + 1
    if math.min(3, 7) == 3 { passed = passed + 1 }
    else { io.println("[FAIL] min(3,7): expected 3") }

    total = total + 1
    if math.max(3, 7) == 7 { passed = passed + 1 }
    else { io.println("[FAIL] max(3,7): expected 7") }

    total = total + 1
    if math.min(-1, 0) == -1 { passed = passed + 1 }
    else { io.println("[FAIL] min(-1,0): expected -1") }

    return [passed, total]
}

function test_trig() {
    let passed = 0
    let total = 0

    total = total + 1
    if math.sin(0.0) == 0.0 { passed = passed + 1 }
    else { io.println("[FAIL] sin(0): expected 0") }

    total = total + 1
    if math.cos(0.0) == 1.0 { passed = passed + 1 }
    else { io.println("[FAIL] cos(0): expected 1") }

    total = total + 1
    if math.tan(0.0) == 0.0 { passed = passed + 1 }
    else { io.println("[FAIL] tan(0): expected 0") }

    return [passed, total]
}

function test_constants() {
    let passed = 0
    let total = 0

    total = total + 1
    if math.PI > 3.14 { passed = passed + 1 }
    else { io.println("[FAIL] PI > 3.14") }

    total = total + 1
    if math.PI < 3.15 { passed = passed + 1 }
    else { io.println("[FAIL] PI < 3.15") }

    total = total + 1
    if math.E > 2.71 { passed = passed + 1 }
    else { io.println("[FAIL] E > 2.71") }

    total = total + 1
    if math.E < 2.72 { passed = passed + 1 }
    else { io.println("[FAIL] E < 2.72") }

    return [passed, total]
}

function test_random() {
    let passed = 0
    let total = 0

    total = total + 1
    let r = math.random()
    if r >= 0.0 { passed = passed + 1 }
    else { io.println("[FAIL] random() >= 0") }

    total = total + 1
    if r < 1.0 { passed = passed + 1 }
    else { io.println("[FAIL] random() < 1") }

    total = total + 1
    let ri = math.random(1, 10)
    if ri >= 1 { passed = passed + 1 }
    else { io.println("[FAIL] random(1,10) >= 1") }

    total = total + 1
    if ri <= 10 { passed = passed + 1 }
    else { io.println("[FAIL] random(1,10) <= 10") }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_arithmetic()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_minmax()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_trig()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    let r4 = test_constants()
    total_passed = total_passed + r4[0]
    total_tests = total_tests + r4[1]

    let r5 = test_random()
    total_passed = total_passed + r5[0]
    total_tests = total_tests + r5[1]

    io.println("stdlib/math: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests { throw "stdlib test failures" }
}

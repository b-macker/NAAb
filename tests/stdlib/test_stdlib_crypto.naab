use crypto

function test_sha256() {
    let passed = 0
    let total = 0

    total = total + 1
    let h = crypto.sha256("")
    if h == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" { passed = passed + 1 }
    else { io.println("[FAIL] sha256 empty: got " + h) }

    total = total + 1
    let h2 = crypto.sha256("hello")
    if string.length(h2) == 64 { passed = passed + 1 }
    else { io.println("[FAIL] sha256 length: expected 64, got " + ("" + string.length(h2))) }

    return [passed, total]
}

function test_sha1() {
    let passed = 0
    let total = 0

    total = total + 1
    let h = crypto.sha1("abc")
    if h == "a9993e364706816aba3e25717850c26c9cd0d89d" { passed = passed + 1 }
    else { io.println("[FAIL] sha1 abc: got " + h) }

    return [passed, total]
}

function test_base64() {
    let passed = 0
    let total = 0

    total = total + 1
    let enc = crypto.base64_encode("hello")
    if enc == "aGVsbG8=" { passed = passed + 1 }
    else { io.println("[FAIL] base64_encode hello: expected aGVsbG8=, got " + enc) }

    total = total + 1
    let dec = crypto.base64_decode("aGVsbG8=")
    if dec == "hello" { passed = passed + 1 }
    else { io.println("[FAIL] base64_decode: expected hello, got " + dec) }

    total = total + 1
    let rt = crypto.base64_decode(crypto.base64_encode("round trip test"))
    if rt == "round trip test" { passed = passed + 1 }
    else { io.println("[FAIL] base64 round-trip: got " + rt) }

    return [passed, total]
}

function test_hex() {
    let passed = 0
    let total = 0

    total = total + 1
    let enc = crypto.hex_encode("AB")
    if string.length(enc) == 4 { passed = passed + 1 }
    else { io.println("[FAIL] hex_encode length: expected 4, got " + ("" + string.length(enc))) }

    total = total + 1
    let dec = crypto.hex_decode(enc)
    if dec == "AB" { passed = passed + 1 }
    else { io.println("[FAIL] hex round-trip: expected AB, got " + dec) }

    return [passed, total]
}

function test_random() {
    let passed = 0
    let total = 0

    total = total + 1
    let rb = crypto.random_bytes(8)
    if string.length(rb) == 8 { passed = passed + 1 }
    else { io.println("[FAIL] random_bytes length: expected 8, got " + ("" + string.length(rb))) }

    total = total + 1
    let rs = crypto.random_string(10)
    if string.length(rs) == 10 { passed = passed + 1 }
    else { io.println("[FAIL] random_string length: expected 10, got " + ("" + string.length(rs))) }

    return [passed, total]
}

function test_compare() {
    let passed = 0
    let total = 0

    total = total + 1
    if crypto.compare_digest("abc", "abc") { passed = passed + 1 }
    else { io.println("[FAIL] compare_digest equal") }

    total = total + 1
    if crypto.compare_digest("abc", "xyz") == false { passed = passed + 1 }
    else { io.println("[FAIL] compare_digest unequal should be false") }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_sha256()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_sha1()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_base64()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    let r4 = test_hex()
    total_passed = total_passed + r4[0]
    total_tests = total_tests + r4[1]

    let r5 = test_random()
    total_passed = total_passed + r5[0]
    total_tests = total_tests + r5[1]

    let r6 = test_compare()
    total_passed = total_passed + r6[0]
    total_tests = total_tests + r6[1]

    io.println("stdlib/crypto: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests { throw "stdlib test failures" }
}

fn test_dict_hint() {
    let passed = 0
    let total = 3

    // Test 1: Similar key should trigger hint on stderr (non-blocking)
    total = total
    let d = {"entries": [1, 2, 3], "service": "redis", "trace_id": "abc123"}
    let result = d.get("cache")
    if result == null { passed = passed + 1 }

    // Test 2: Typo key should trigger hint
    let result2 = d.get("servce")
    if result2 == null { passed = passed + 1 }

    // Test 3: Completely unrelated key — no hint expected
    let result3 = d.get("xyzabc123")
    if result3 == null { passed = passed + 1 }

    return [passed, total]
}

main {
    let r = test_dict_hint()
    print("dict_did_you_mean: " + string(r[0]) + "/" + string(r[1]))
}

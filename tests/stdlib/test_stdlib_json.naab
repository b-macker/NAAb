use json

function test_stringify() {
    let passed = 0
    let total = 0

    let obj = {"a": 1, "b": "hello"}
    let s = json.stringify(obj)

    total = total + 1
    if string.contains(s, "a") { passed = passed + 1 }
    else { io.println("[FAIL] stringify contains 'a': " + s) }

    total = total + 1
    if string.contains(s, "hello") { passed = passed + 1 }
    else { io.println("[FAIL] stringify contains 'hello': " + s) }

    return [passed, total]
}

function test_parse() {
    let passed = 0
    let total = 0

    let parsed = json.parse("{\"x\": 42, \"y\": \"world\"}")

    total = total + 1
    if parsed["x"] == 42 { passed = passed + 1 }
    else { io.println("[FAIL] parse x: expected 42, got " + ("" + parsed["x"])) }

    total = total + 1
    if parsed["y"] == "world" { passed = passed + 1 }
    else { io.println("[FAIL] parse y: expected world, got " + ("" + parsed["y"])) }

    return [passed, total]
}

function test_round_trip() {
    let passed = 0
    let total = 0

    let orig = {"name": "alice", "score": 99}
    let s = json.stringify(orig)
    let back = json.parse(s)

    total = total + 1
    if back["name"] == "alice" { passed = passed + 1 }
    else { io.println("[FAIL] round-trip name: expected alice, got " + ("" + back["name"])) }

    total = total + 1
    if back["score"] == 99 { passed = passed + 1 }
    else { io.println("[FAIL] round-trip score: expected 99, got " + ("" + back["score"])) }

    return [passed, total]
}

function test_nested() {
    let passed = 0
    let total = 0

    let nested = {"user": {"id": 1, "tags": ["a", "b"]}}
    let s = json.stringify(nested)
    let back = json.parse(s)

    total = total + 1
    if back["user"]["id"] == 1 { passed = passed + 1 }
    else { io.println("[FAIL] nested id: expected 1") }

    return [passed, total]
}

function test_is_valid() {
    let passed = 0
    let total = 0

    total = total + 1
    if json.is_valid("{\"ok\": 1}") { passed = passed + 1 }
    else { io.println("[FAIL] is_valid good JSON") }

    total = total + 1
    if json.is_valid("not json at all") == false { passed = passed + 1 }
    else { io.println("[FAIL] is_valid bad JSON should be false") }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_stringify()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_parse()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_round_trip()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    let r4 = test_nested()
    total_passed = total_passed + r4[0]
    total_tests = total_tests + r4[1]

    let r5 = test_is_valid()
    total_passed = total_passed + r5[0]
    total_tests = total_tests + r5[1]

    io.println("stdlib/json: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests { throw "stdlib test failures" }
}

use env

function test_get_set() {
    let passed = 0
    let total = 0

    let var_name = "NAAB_STDLIB_TEST_VAR"

    total = total + 1
    if env.has(var_name) == false { passed = passed + 1 }
    else { io.println("[FAIL] has() before set should be false") }

    env.set_var(var_name, "hello_test")

    total = total + 1
    if env.has(var_name) { passed = passed + 1 }
    else { io.println("[FAIL] has() after set should be true") }

    total = total + 1
    let val = env.get(var_name)
    if val == "hello_test" { passed = passed + 1 }
    else { io.println("[FAIL] get after set: expected hello_test, got " + ("" + val)) }

    env.delete_var(var_name)

    total = total + 1
    if env.has(var_name) == false { passed = passed + 1 }
    else { io.println("[FAIL] has() after delete should be false") }

    return [passed, total]
}

function test_defaults() {
    let passed = 0
    let total = 0

    total = total + 1
    let missing = env.get("NONEXISTENT_NAAB_VAR_XYZ_12345")
    if missing == null { passed = passed + 1 }
    else { io.println("[FAIL] missing var should be null, got " + ("" + missing)) }

    return [passed, total]
}

function test_get_types() {
    let passed = 0
    let total = 0

    let int_var = "NAAB_STDLIB_TEST_INT"
    env.set_var(int_var, "42")

    total = total + 1
    let iv = env.get_int(int_var)
    if iv == 42 { passed = passed + 1 }
    else { io.println("[FAIL] get_int: expected 42, got " + ("" + iv)) }

    env.delete_var(int_var)

    return [passed, total]
}

function test_args() {
    let passed = 0
    let total = 0

    total = total + 1
    let args = env.get_args()
    if args != null { passed = passed + 1 }
    else { io.println("[FAIL] get_args should not be null") }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_get_set()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_defaults()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_get_types()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    let r4 = test_args()
    total_passed = total_passed + r4[0]
    total_tests = total_tests + r4[1]

    io.println("stdlib/env: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests { throw "stdlib test failures" }
}

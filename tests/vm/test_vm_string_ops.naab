// VM string operation tests
function test_string_basics() {
    let passed = 0
    let total = 0

    total = total + 1
    let s = "hello" + " " + "world"
    if s == "hello world" {
        passed = passed + 1
    } else {
        print("[FAIL] concat: expected 'hello world', got '" + s + "'")
    }

    total = total + 1
    if string.length(s) == 11 {
        passed = passed + 1
    } else {
        print("[FAIL] length: expected 11, got " + ("" + string.length(s)))
    }

    total = total + 1
    if string.upper(s) == "HELLO WORLD" {
        passed = passed + 1
    } else {
        print("[FAIL] upper: expected 'HELLO WORLD'")
    }

    total = total + 1
    if string.lower("FOO BAR") == "foo bar" {
        passed = passed + 1
    } else {
        print("[FAIL] lower: expected 'foo bar'")
    }

    total = total + 1
    if string.contains(s, "world") {
        passed = passed + 1
    } else {
        print("[FAIL] contains: expected true")
    }

    total = total + 1
    if !string.contains(s, "xyz") {
        passed = passed + 1
    } else {
        print("[FAIL] contains xyz: expected false")
    }

    return [passed, total]
}

function test_string_manipulation() {
    let passed = 0
    let total = 0

    total = total + 1
    let trimmed = string.trim("  hello  ")
    if trimmed == "hello" {
        passed = passed + 1
    } else {
        print("[FAIL] trim: expected 'hello', got '" + trimmed + "'")
    }

    total = total + 1
    let replaced = string.replace("foo bar foo", "foo", "baz")
    if replaced == "baz bar baz" {
        passed = passed + 1
    } else {
        print("[FAIL] replace: expected 'baz bar baz', got '" + replaced + "'")
    }

    total = total + 1
    let parts = string.split("a,b,c", ",")
    if array.length(parts) == 3 {
        passed = passed + 1
    } else {
        print("[FAIL] split: expected 3 parts, got " + ("" + array.length(parts)))
    }

    total = total + 1
    if string.starts_with("hello world", "hello") {
        passed = passed + 1
    } else {
        print("[FAIL] starts_with: expected true")
    }

    total = total + 1
    if string.ends_with("hello world", "world") {
        passed = passed + 1
    } else {
        print("[FAIL] ends_with: expected true")
    }

    total = total + 1
    let sub = string.substring("hello world", 6, 11)
    if sub == "world" {
        passed = passed + 1
    } else {
        print("[FAIL] substring: expected 'world', got '" + sub + "'")
    }

    return [passed, total]
}

function test_string_conversion() {
    let passed = 0
    let total = 0

    total = total + 1
    let n = 42
    let ns = "" + n
    if ns == "42" {
        passed = passed + 1
    } else {
        print("[FAIL] int to string: expected '42', got '" + ns + "'")
    }

    total = total + 1
    let f = 3.14
    let fs = "" + f
    if string.contains(fs, "3.14") {
        passed = passed + 1
    } else {
        print("[FAIL] float to string: expected '3.14...'")
    }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_string_basics()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_string_manipulation()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_string_conversion()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    print("VM string ops: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests {
        throw "VM string test failures"
    }
}

// VM dict and array operation tests
function test_arrays() {
    let passed = 0
    let total = 0

    total = total + 1
    let arr = [1, 2, 3]
    arr.push(4)
    if array.length(arr) == 4 {
        passed = passed + 1
    } else {
        print("[FAIL] push+length: expected 4, got " + ("" + array.length(arr)))
    }

    total = total + 1
    if arr[0] == 1 && arr[3] == 4 {
        passed = passed + 1
    } else {
        print("[FAIL] array index: arr[0]=1 arr[3]=4 failed")
    }

    total = total + 1
    let popped = arr.pop()
    if popped == 4 && array.length(arr) == 3 {
        passed = passed + 1
    } else {
        print("[FAIL] pop: expected 4 and length 3")
    }

    total = total + 1
    let mapped = array.map_fn(arr, fn(x) { return x * 2 })
    if mapped[0] == 2 && mapped[1] == 4 && mapped[2] == 6 {
        passed = passed + 1
    } else {
        print("[FAIL] map: expected [2,4,6]")
    }

    total = total + 1
    let filtered = array.filter_fn(arr, fn(x) { return x > 1 })
    if array.length(filtered) == 2 {
        passed = passed + 1
    } else {
        print("[FAIL] filter: expected 2 elements, got " + ("" + array.length(filtered)))
    }

    total = total + 1
    let sum = array.reduce_fn(arr, fn(acc, x) { return acc + x }, 0)
    if sum == 6 {
        passed = passed + 1
    } else {
        print("[FAIL] reduce: expected 6, got " + ("" + sum))
    }

    total = total + 1
    let found = array.index_of(arr, 2)
    if found == 1 {
        passed = passed + 1
    } else {
        print("[FAIL] indexOf: expected 1, got " + ("" + found))
    }

    return [passed, total]
}

function test_dicts() {
    let passed = 0
    let total = 0

    total = total + 1
    let d = {"a": 1, "b": 2}
    d["c"] = 3
    if d["c"] == 3 {
        passed = passed + 1
    } else {
        print("[FAIL] dict set/get: expected 3")
    }

    total = total + 1
    let missing = d.get("z") ?? 99
    if missing == 99 {
        passed = passed + 1
    } else {
        print("[FAIL] dict.get missing ?? 99: expected 99, got " + ("" + missing))
    }

    total = total + 1
    let found = d.get("a") ?? 0
    if found == 1 {
        passed = passed + 1
    } else {
        print("[FAIL] dict.get existing: expected 1, got " + ("" + found))
    }

    total = total + 1
    let keys = dict.keys(d)
    if array.length(keys) == 3 {
        passed = passed + 1
    } else {
        print("[FAIL] dict.keys: expected 3 keys, got " + ("" + array.length(keys)))
    }

    total = total + 1
    let vals = dict.values(d)
    if array.length(vals) == 3 {
        passed = passed + 1
    } else {
        print("[FAIL] dict.values: expected 3 values, got " + ("" + array.length(vals)))
    }

    total = total + 1
    let has_a = dict.has_key(d, "a")
    let has_z = dict.has_key(d, "z")
    if has_a && !has_z {
        passed = passed + 1
    } else {
        print("[FAIL] dict.has_key: has_a=" + ("" + has_a) + " has_z=" + ("" + has_z))
    }

    return [passed, total]
}

function test_nested() {
    let passed = 0
    let total = 0

    total = total + 1
    let matrix = [[1, 2], [3, 4], [5, 6]]
    if matrix[1][0] == 3 {
        passed = passed + 1
    } else {
        print("[FAIL] nested array: matrix[1][0] expected 3")
    }

    total = total + 1
    let nested = {"outer": {"inner": 42}}
    if nested["outer"]["inner"] == 42 {
        passed = passed + 1
    } else {
        print("[FAIL] nested dict: expected 42")
    }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_arrays()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_dicts()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_nested()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    print("VM dict/array ops: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests {
        throw "VM dict/array test failures"
    }
}

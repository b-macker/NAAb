// VM loop, break, continue tests
function test_for_loops() {
    let passed = 0
    let total = 0

    total = total + 1
    let sum = 0
    for i in range(10) { sum = sum + i }
    if sum == 45 {
        passed = passed + 1
    } else {
        print("[FAIL] range sum: expected 45, got " + ("" + sum))
    }

    total = total + 1
    let count = 0
    for i in range(1, 6) { count = count + i }
    if count == 15 {
        passed = passed + 1
    } else {
        print("[FAIL] range(1,6) sum: expected 15, got " + ("" + count))
    }

    total = total + 1
    let evens = 0
    for i in range(10) {
        if i % 2 != 0 { continue }
        evens = evens + 1
    }
    if evens == 5 {
        passed = passed + 1
    } else {
        print("[FAIL] even count: expected 5, got " + ("" + evens))
    }

    total = total + 1
    let stop_at = 0
    for i in range(100) {
        if i == 7 { break }
        stop_at = i
    }
    if stop_at == 6 {
        passed = passed + 1
    } else {
        print("[FAIL] break at 7: expected last=6, got " + ("" + stop_at))
    }

    return [passed, total]
}

function test_while_loops() {
    let passed = 0
    let total = 0

    total = total + 1
    let x = 0
    while x < 5 { x = x + 1 }
    if x == 5 {
        passed = passed + 1
    } else {
        print("[FAIL] while count: expected 5, got " + ("" + x))
    }

    total = total + 1
    let y = 0
    while true {
        y = y + 1
        if y >= 3 { break }
    }
    if y == 3 {
        passed = passed + 1
    } else {
        print("[FAIL] while true+break: expected 3, got " + ("" + y))
    }

    total = total + 1
    let odds = 0
    let n = 0
    while n < 10 {
        n = n + 1
        if n % 2 == 0 { continue }
        odds = odds + 1
    }
    if odds == 5 {
        passed = passed + 1
    } else {
        print("[FAIL] while odd count: expected 5, got " + ("" + odds))
    }

    return [passed, total]
}

function test_nested_loops() {
    let passed = 0
    let total = 0

    total = total + 1
    let pairs = 0
    for i in range(3) {
        for j in range(3) {
            pairs = pairs + 1
        }
    }
    if pairs == 9 {
        passed = passed + 1
    } else {
        print("[FAIL] nested loops 3x3: expected 9, got " + ("" + pairs))
    }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_for_loops()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_while_loops()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_nested_loops()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    print("VM loop ops: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests {
        throw "VM loop test failures"
    }
}

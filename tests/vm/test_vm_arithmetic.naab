// VM arithmetic tests — NaN-boxing int fast paths, float ops, comparisons, booleans
use string

function test_int_ops() {
    let passed = 0
    let total = 0

    total = total + 1
    if 2 + 3 == 5 { passed = passed + 1 } else { print("[FAIL] 2+3 == 5") }

    total = total + 1
    if 10 - 4 == 6 { passed = passed + 1 } else { print("[FAIL] 10-4 == 6") }

    total = total + 1
    if 6 * 7 == 42 { passed = passed + 1 } else { print("[FAIL] 6*7 == 42") }

    total = total + 1
    if 20 / 4 == 5 { passed = passed + 1 } else { print("[FAIL] 20/4 == 5") }

    total = total + 1
    if 17 % 5 == 2 { passed = passed + 1 } else { print("[FAIL] 17%5 == 2") }

    // Unary negation
    total = total + 1
    let neg = 0 - 7
    if neg == -7 { passed = passed + 1 } else { print("[FAIL] 0-7 == -7, got " + ("" + neg)) }

    // Chained operations
    total = total + 1
    if 1 + 2 + 3 + 4 + 5 == 15 { passed = passed + 1 } else { print("[FAIL] 1+2+3+4+5 == 15") }

    // Operator precedence
    total = total + 1
    if 2 + 3 * 4 == 14 { passed = passed + 1 } else { print("[FAIL] 2+3*4 == 14") }

    total = total + 1
    if (2 + 3) * 4 == 20 { passed = passed + 1 } else { print("[FAIL] (2+3)*4 == 20") }

    return [passed, total]
}

function test_float_ops() {
    let passed = 0
    let total = 0

    total = total + 1
    if 1.5 + 2.5 == 4.0 { passed = passed + 1 } else { print("[FAIL] 1.5+2.5 == 4.0") }

    total = total + 1
    if 3.0 * 2.0 == 6.0 { passed = passed + 1 } else { print("[FAIL] 3.0*2.0 == 6.0") }

    total = total + 1
    if 10.0 / 4.0 == 2.5 { passed = passed + 1 } else { print("[FAIL] 10.0/4.0 == 2.5") }

    // Mixed int/float
    total = total + 1
    if 2 + 0.5 == 2.5 { passed = passed + 1 } else { print("[FAIL] 2+0.5 == 2.5") }

    total = total + 1
    let x = 3 * 1.0
    if x == 3.0 { passed = passed + 1 } else { print("[FAIL] 3*1.0 == 3.0, got " + ("" + x)) }

    return [passed, total]
}

function test_comparisons() {
    let passed = 0
    let total = 0

    total = total + 1
    if 5 == 5 { passed = passed + 1 } else { print("[FAIL] 5 == 5") }

    total = total + 1
    if 5 != 6 { passed = passed + 1 } else { print("[FAIL] 5 != 6") }

    total = total + 1
    if 3 < 4 { passed = passed + 1 } else { print("[FAIL] 3 < 4") }

    total = total + 1
    if 4 > 3 { passed = passed + 1 } else { print("[FAIL] 4 > 3") }

    total = total + 1
    if 5 <= 5 { passed = passed + 1 } else { print("[FAIL] 5 <= 5") }

    total = total + 1
    if 5 >= 5 { passed = passed + 1 } else { print("[FAIL] 5 >= 5") }

    total = total + 1
    if !(3 > 5) { passed = passed + 1 } else { print("[FAIL] !(3 > 5)") }

    // String equality
    total = total + 1
    if "abc" == "abc" { passed = passed + 1 } else { print("[FAIL] string ==") }

    total = total + 1
    if "abc" != "def" { passed = passed + 1 } else { print("[FAIL] string !=") }

    return [passed, total]
}

function test_boolean_logic() {
    let passed = 0
    let total = 0

    total = total + 1
    if true && true { passed = passed + 1 } else { print("[FAIL] true && true") }

    total = total + 1
    if !(false && true) { passed = passed + 1 } else { print("[FAIL] !(false && true)") }

    total = total + 1
    if true || false { passed = passed + 1 } else { print("[FAIL] true || false") }

    total = total + 1
    if !(false || false) { passed = passed + 1 } else { print("[FAIL] !(false || false)") }

    total = total + 1
    if !false { passed = passed + 1 } else { print("[FAIL] !false") }

    total = total + 1
    if !(true && false || false) { passed = passed + 1 } else { print("[FAIL] nested booleans") }

    return [passed, total]
}

function test_string_concat() {
    let passed = 0
    let total = 0

    total = total + 1
    if "hello" + " " + "world" == "hello world" { passed = passed + 1 }
    else { print("[FAIL] string concat") }

    total = total + 1
    let n = 42
    if "n=" + ("" + n) == "n=42" { passed = passed + 1 }
    else { print("[FAIL] int-to-string concat") }

    total = total + 1
    let s = "abc"
    s = s + "def"
    if s == "abcdef" { passed = passed + 1 } else { print("[FAIL] concat assign") }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_int_ops()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_float_ops()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_comparisons()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    let r4 = test_boolean_logic()
    total_passed = total_passed + r4[0]
    total_tests = total_tests + r4[1]

    let r5 = test_string_concat()
    total_passed = total_passed + r5[0]
    total_tests = total_tests + r5[1]

    print("VM arithmetic: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests {
        throw "VM arithmetic test failures"
    }
}

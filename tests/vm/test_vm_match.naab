// VM match tests — int/string/enum, wildcard, expression, nested
use string

enum Color {
    Red,
    Green,
    Blue
}

enum Shape {
    Circle,
    Square,
    Triangle
}

function test_match_int() {
    let passed = 0
    let total = 0

    // Basic int match
    total = total + 1
    let x = 2
    let result = match x {
        1 => "one",
        2 => "two",
        3 => "three",
        _ => "other"
    }
    if result == "two" { passed = passed + 1 } else { print("[FAIL] match int 2, got " + result) }

    // Wildcard catch-all
    total = total + 1
    let y = 99
    let result2 = match y {
        1 => "one",
        _ => "other"
    }
    if result2 == "other" { passed = passed + 1 } else { print("[FAIL] match wildcard, got " + result2) }

    // Match zero
    total = total + 1
    let result3 = match 0 {
        0 => "zero",
        _ => "nonzero"
    }
    if result3 == "zero" { passed = passed + 1 } else { print("[FAIL] match zero") }

    // Match result used in arithmetic
    total = total + 1
    let n = 3
    let bonus = match n {
        1 => 1,
        2 => 2,
        3 => 10,
        _ => 99
    }
    if bonus == 10 { passed = passed + 1 } else { print("[FAIL] match arithmetic bonus=" + ("" + bonus)) }

    return [passed, total]
}

function test_match_string() {
    let passed = 0
    let total = 0

    // String match
    total = total + 1
    let s = "hello"
    let r = match s {
        "hello" => "greeting",
        "bye"   => "farewell",
        _       => "unknown"
    }
    if r == "greeting" { passed = passed + 1 } else { print("[FAIL] match string hello, got " + r) }

    // String wildcard
    total = total + 1
    let s2 = "xyz"
    let r2 = match s2 {
        "abc" => "abc",
        _     => "other"
    }
    if r2 == "other" { passed = passed + 1 } else { print("[FAIL] match string wildcard, got " + r2) }

    // Match return used in expression
    total = total + 1
    let lang = "naab"
    let is_naab = match lang {
        "naab" => true,
        _      => false
    }
    if is_naab { passed = passed + 1 } else { print("[FAIL] match bool result") }

    return [passed, total]
}

function test_match_enum() {
    let passed = 0
    let total = 0

    // Enum match
    total = total + 1
    let c = Color.Green
    let r = match c {
        Color.Red   => "red",
        Color.Green => "green",
        Color.Blue  => "blue"
    }
    if r == "green" { passed = passed + 1 } else { print("[FAIL] enum match green, got " + r) }

    total = total + 1
    let s = Shape.Triangle
    let r2 = match s {
        Shape.Circle   => 0,
        Shape.Square   => 4,
        Shape.Triangle => 3
    }
    if r2 == 3 { passed = passed + 1 } else { print("[FAIL] enum match triangle sides, got " + ("" + r2)) }

    return [passed, total]
}

function test_match_expression() {
    let passed = 0
    let total = 0

    // Match result directly assigned
    total = total + 1
    let val = 7
    let category = match val {
        1 => "low",
        7 => "lucky",
        _ => "other"
    }
    if category == "lucky" { passed = passed + 1 } else { print("[FAIL] match as expression assign") }

    // Match result used in arithmetic
    total = total + 1
    let base = 10
    let bonus = match base {
        10 => 5,
        20 => 10,
        _  => 0
    }
    if base + bonus == 15 { passed = passed + 1 } else { print("[FAIL] match expr in arithmetic") }

    // Match result passed to function via concatenation
    total = total + 1
    let label = match 42 {
        42 => "answer",
        _  => "other"
    }
    let msg = "The " + label
    if msg == "The answer" { passed = passed + 1 } else { print("[FAIL] match result in concat, got " + msg) }

    return [passed, total]
}

function test_nested_match() {
    let passed = 0
    let total = 0

    // Nested match
    total = total + 1
    let a = 1
    let b = 2
    let r = match a {
        1 => match b {
            1 => "1,1",
            2 => "1,2",
            _ => "1,?"
        },
        _ => "other"
    }
    if r == "1,2" { passed = passed + 1 } else { print("[FAIL] nested match, got " + r) }

    // Match inside if
    total = total + 1
    let x = 5
    let ok = false
    if x > 3 {
        let label2 = match x {
            5 => "five",
            _ => "not-five"
        }
        if label2 == "five" { ok = true }
    }
    if ok { passed = passed + 1 } else { print("[FAIL] match inside if") }

    return [passed, total]
}

main {
    let total_passed = 0
    let total_tests = 0

    let r1 = test_match_int()
    total_passed = total_passed + r1[0]
    total_tests = total_tests + r1[1]

    let r2 = test_match_string()
    total_passed = total_passed + r2[0]
    total_tests = total_tests + r2[1]

    let r3 = test_match_enum()
    total_passed = total_passed + r3[0]
    total_tests = total_tests + r3[1]

    let r4 = test_match_expression()
    total_passed = total_passed + r4[0]
    total_tests = total_tests + r4[1]

    let r5 = test_nested_match()
    total_passed = total_passed + r5[0]
    total_tests = total_tests + r5[1]

    print("VM match: " + ("" + total_passed) + "/" + ("" + total_tests) + " passed")
    if total_passed != total_tests {
        throw "VM match test failures"
    }
}

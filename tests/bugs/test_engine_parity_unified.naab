// Regression: engine parity unifications (CMP-001, BOOL-001, FEAT-001).
// Both engines must agree on all of these — the differential harness runs
// this file on VM and tree-walker and diffs the output.
main {
    let pass = 0
    let fail = 0

    // BOOL-001: bool is numeric (1/0) in arithmetic and ordering
    if true + 1 == 2 { pass = pass + 1 } else { fail = fail + 1 print("FAIL bool add") }
    if true * 3 == 3 { pass = pass + 1 } else { fail = fail + 1 print("FAIL bool mul") }
    if true / 2 == 0.5 { pass = pass + 1 } else { fail = fail + 1 print("FAIL bool div") }
    if true % 2 == 1 { pass = pass + 1 } else { fail = fail + 1 print("FAIL bool mod") }
    if -true == -1 { pass = pass + 1 } else { fail = fail + 1 print("FAIL bool neg") }
    if false < true { pass = pass + 1 } else { fail = fail + 1 print("FAIL bool cmp") }
    // String concat still formats bools as text
    if "s" + true == "strue" { pass = pass + 1 } else { fail = fail + 1 print("FAIL bool concat") }
    // Equality stays type-aware: bool != int
    if (true == 1) == false { pass = pass + 1 } else { fail = fail + 1 print("FAIL bool eq") }

    // FEAT-001: string iteration, string subscript, negative index wrap, pop
    let acc = ""
    for c in "abc" {
        acc = acc + c
    }
    if acc == "abc" { pass = pass + 1 } else { fail = fail + 1 print("FAIL str iter") }
    if "hello"[1] == "e" { pass = pass + 1 } else { fail = fail + 1 print("FAIL str index") }
    if "hello"[-1] == "o" { pass = pass + 1 } else { fail = fail + 1 print("FAIL str neg index") }
    let arr = [1, 2, 3]
    if arr[-1] == 3 { pass = pass + 1 } else { fail = fail + 1 print("FAIL list neg index") }
    let popped = arr.pop()
    if popped == 3 { pass = pass + 1 } else { fail = fail + 1 print("FAIL pop value") }
    if arr.length() == 2 { pass = pass + 1 } else { fail = fail + 1 print("FAIL pop mutation") }

    if fail == 0 {
        print("PASS: engine_parity_unified (" + pass + " checks)")
    } else {
        print("FAIL: engine_parity_unified")
    }
}

{
    "version": "4.0",
    "taint_tracking": {
        "enabled": true,
        "level": "detect",
        "sources": [
            "env.get"
        ],
        "sinks": [
            "shell_exec"
        ]
    },
    "contracts": {
        "level": "soft"
    },
    "audit": {
        "level": "full",
        "output_file": ".governance-audit-interactions.jsonl"
    },
    "security": {
        "sandbox_level": "unrestricted"
    }
}

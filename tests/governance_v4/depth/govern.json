{
    "version": "5.0",
    "mode": "enforce",
    "sandbox_level": "elevated",
    "languages": {
        "allowed": ["python", "javascript", "shell"],
        "require_explicit": false
    },
    "capabilities": {
        "network": { "enabled": false },
        "filesystem": { "mode": "write" },
        "shell": { "enabled": true },
        "env_vars": { "read": true, "write": false }
    },
    "taint_tracking": {
        "enabled": true,
        "level": "soft",
        "lineage": true,
        "sources": ["polyglot_output", "file.read", "env.get"],
        "sinks": ["file.write"],
        "sanitizers": ["sanitize_", "validate_"],
        "gate_cross_block": true,
        "cross_block_level": "advisory"
    },
    "behavioral_sequences": {
        "enabled": true,
        "window_size": 100
    },
    "context_drift": {
        "enabled": true,
        "level": "advisory",
        "coherence_threshold": 0.4,
        "check_interval_turns": 1,
        "fingerprint_window": 10,
        "rate_normalized": false,
        "coherence_recovery_amount": 0.2,
        "coherence_natural_healing": 0.0,
        "signals": {
            "circular_actions": true,
            "repeated_failures": true,
            "scope_creep": true,
            "intent_contradictions": true,
            "coherence_velocity": true,
            "vocabulary_contraction": true,
            "capability_underutilization": false,
            "semantic_stability": false
        },
        "weights": {
            "circular": 0.15,
            "scope_creep": 0.10,
            "contradiction": 0.20,
            "repeated_failure": 0.10,
            "vocabulary_contraction": 0.10
        },
        "reality_checkpoint": {
            "enabled": true,
            "level": "advisory",
            "pressure_threshold": 0.7,
            "sustained_turns_required": 3,
            "min_turns_between_checkpoints": 5,
            "expected_conversation_depth": 10,
            "weights": {
                "coherence_proximity": 0.35,
                "risk_score_proximity": 0.20,
                "signal_density": 0.25,
                "conversation_depth": 0.10,
                "bsd_partial_progress": 0.10,
                "pipeline_inherited": 0.0,
                "coherence_acceleration": 0.0
            }
        }
    },
    "exposure_tracking": {
        "enabled": true,
        "max_autonomous_actions": 50,
        "max_unique_agents": 5,
        "coherence_floor": 0.3,
        "level": "advisory",
        "max_pipeline_depth": 3,
        "checkpoint_cooldown_turns": 2,
        "min_capability_utilization": 0.0,
        "utilization_check_after_turns": 10
    },
    "circuit_breaker": {
        "enabled": true,
        "elevated_threshold": 0.4,
        "high_threshold": 0.6,
        "critical_threshold": 0.8,
        "elevated_sustained": 2,
        "high_sustained": 3,
        "critical_sustained": 4,
        "critical_coherence": 0.2
    },
    "governance_health": {
        "enabled": true,
        "check_after_turns": 10,
        "governance_entropy_warning": 0.5
    },
    "pipeline_separation": {
        "enabled": true,
        "level": "soft"
    },
    "temporal_coupling": {
        "enabled": false,
        "max_correlation": 0.85,
        "min_events": 10
    }
}

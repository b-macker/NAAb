{
  "version": "5.0",
  "mode": "enforce",
  "description": "Agent tool execution chaos tests — basic config",
  "languages": {
    "allowed": ["python"],
    "require_explicit": false
  },
  "capabilities": {
    "network": { "enabled": true },
    "filesystem": { "mode": "write" },
    "shell": { "enabled": false }
  },
  "agents": {
    "tools_enabled_agent": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "api_key_env": ["GK1", "GK2", "GK3", "GK4", "GK5", "GK6", "GK7", "GK8", "GK9"],
      "max_tokens": 256,
      "max_turns": 10,
      "max_total_tokens": 5000,
      "system_prompt": "You are a helpful assistant. When asked to search or calculate, use the provided tools.",
      "tools_enabled": true,
      "tools": ["search_data", "calculate"],
      "max_tool_calls_per_turn": 5,
      "max_tool_loop_turns": 3,
      "tool_result_max_chars": 1024,
      "tool_timeout_seconds": 10,
      "allowed_actions": ["AGENT_SEND", "TOOL_EXEC"],
      "retry": { "max_attempts": 6, "backoff_ms": 500 }
    },
    "tools_disabled_agent": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "api_key_env": ["GK1", "GK2", "GK3", "GK4", "GK5", "GK6", "GK7", "GK8", "GK9"],
      "max_tokens": 256,
      "max_turns": 10,
      "tools_enabled": false,
      "system_prompt": "You are a test agent."
    },
    "no_tool_exec_agent": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "api_key_env": ["GK1", "GK2", "GK3", "GK4", "GK5", "GK6", "GK7", "GK8", "GK9"],
      "max_tokens": 256,
      "max_turns": 10,
      "tools_enabled": true,
      "tools": ["search_data"],
      "allowed_actions": ["AGENT_SEND"],
      "system_prompt": "You are a test agent. Always use the search_data tool when asked a question.",
      "retry": { "max_attempts": 6, "backoff_ms": 500 }
    },
    "tight_budget_agent": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "api_key_env": ["GK1", "GK2", "GK3", "GK4", "GK5", "GK6", "GK7", "GK8", "GK9"],
      "max_tokens": 256,
      "max_turns": 10,
      "system_prompt": "You are a test agent. Always use available tools to answer questions. Call tools multiple times if needed.",
      "tools_enabled": true,
      "tools": ["search_data", "calculate"],
      "max_tool_calls_per_turn": 2,
      "max_tool_loop_turns": 2,
      "tool_result_max_chars": 50,
      "tool_timeout_seconds": 5,
      "allowed_actions": ["AGENT_SEND", "TOOL_EXEC"],
      "retry": { "max_attempts": 6, "backoff_ms": 500 }
    },
    "bogus_key_agent": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "api_key_env": "CHAOS_BOGUS",
      "max_tokens": 256,
      "max_turns": 5,
      "tools_enabled": true,
      "tools": ["search_data"],
      "allowed_actions": ["AGENT_SEND", "TOOL_EXEC"],
      "system_prompt": "Test agent."
    }
  },
  "behavioral_sequences": {
    "enabled": true,
    "patterns": []
  },
  "context_drift": {
    "enabled": false
  },
  "security": {
    "sandbox_level": "elevated"
  }
}

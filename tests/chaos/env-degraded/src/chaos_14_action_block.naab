// Chaos Test 14: Action Matrix Blocking
// chaos_no_send has allowed_actions=["FS_READ", "NET_CONNECT"] — no AGENT_SEND
// Verifies send is blocked by action matrix and error is informative but safe

use agent

main {
    // Create agent without AGENT_SEND in allowed_actions
    let h = agent.create("chaos_no_send")
    print("chaos14_created: true")

    // Attempt to send — should be blocked by action matrix
    let blocked = false
    let error_msg = ""
    try {
        let resp = agent.send(h, "test message")
        print("chaos14_send_blocked: false")
    } catch (e) {
        error_msg = string(e)
        blocked = true
        print("chaos14_send_blocked: true")
    }

    // Error should mention action matrix restriction
    if blocked {
        let mentions_matrix = error_msg.contains("action matrix") ||
                              error_msg.contains("Action matrix") ||
                              error_msg.contains("AGENT_SEND") ||
                              error_msg.contains("allowed_actions")
        print("chaos14_error_mentions_restriction: " + string(mentions_matrix))

        // Error should NOT leak the actual allowed action values
        let leaks_list = error_msg.contains("FS_READ") || error_msg.contains("NET_CONNECT")
        print("chaos14_error_leaks_actions: " + string(leaks_list))
    } else {
        print("chaos14_error_mentions_restriction: false")
        print("chaos14_error_leaks_actions: true")
    }

    // Environment should still be queryable after block
    let env = agent.environment(h)
    let env_ok = env != null && env.get("state") != null
    print("chaos14_env_after_block: " + string(env_ok))

    print("chaos14_completed: true")
}

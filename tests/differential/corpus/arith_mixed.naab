// Differential probe: int/double promotion and %.15g formatting parity.
main {
    print(7 / 2)
    print(8 / 2)
    print(1 / 3)
    print(1 + 2.5)
    print(2 * 0.5)
    print(0.1 + 0.2)
    print(1.0)
    print(-0.0)
    print(10000000000.0 * 10000000000.0)
    print(123456789.123456789)
    print(3.5 - 1)
    print(2.5 * 4)
    print(1.5 / 0.5)
    print("END")
}

// Differential probe: operator precedence parity, including the parser's
// range-between-equality-and-comparison quirk neighborhood.
main {
    print(1 + 2 * 3)
    print((1 + 2) * 3)
    print(1 - 2 - 3)
    print(1 - (2 - 3))
    print(10 / 2 * 5)
    print(2 * 3 % 4)
    print(-2 * 3)
    print(2 * -3)
    print(1 + 2 < 4)
    print(1 < 2 == true)
    print(true || false && false)
    print((true || false) && false)
    print(!false == true)
    print(1 + 2 == 3 && 4 > 3)
    print("END")
}

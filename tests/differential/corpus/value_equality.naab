// Differential probe: == and != on lists, dictionaries and structs. Both
// engines called every container unequal, `a == a` included; both now
// compare by value through one helper (naab/value_equality.h, A72).
struct P {
    x: int
}
main {
    let a = [1, 2]
    print(a == a)
    print(a == [1, 2])
    print(a != [2, 1])
    print([] == [])
    print({} == {})
    print({"a": 1, "b": [2]} == {"b": [2], "a": 1})
    print([1] == [1.0])
    print([1] == ["1"])
    print(new P { x: 1 } == new P { x: 1 })
    print(new P { x: 1 } == new P { x: 2 })
    print(5 == 5.0)
    print("1" == 1)
    print("END")
}

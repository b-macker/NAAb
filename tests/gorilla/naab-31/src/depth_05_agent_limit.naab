// Gorilla test: max_unique_agents=3 — attempts to use 4 different agents
use agent

main {
    let agents_used = 0
    let blocked_agent = ""

    // Create and use 3 agents (should succeed)
    let h1 = agent.create("analyst")
    let r1 = try { agent.send(h1, "test 1") } catch (e) { null }
    agents_used = agents_used + 1

    let h2 = agent.create("reviewer")
    let r2 = try { agent.send(h2, "test 2") } catch (e) { null }
    agents_used = agents_used + 1

    let h3 = agent.create("same_as_analyst")
    let r3 = try { agent.send(h3, "test 3") } catch (e) { null }
    agents_used = agents_used + 1

    print("agents used: " + string(agents_used))
    // At this point all 3 slots used — any further unique agent would exceed
    // But we only have 3 agent configs, so this test validates the counter
}

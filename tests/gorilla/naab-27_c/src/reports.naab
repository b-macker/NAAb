use json
use crypto
use time
import "models.naab" as models
import "validators.naab" as validators

export fn generate_summary_report(events, incidents, alerts) {
    let event_count = len(events)
    let incident_count = len(incidents)
    let alert_count = len(alerts)

    let report_text = "OPERATIONAL SUMMARY REPORT\n"
    report_text = report_text + "Generated: " + string(time.now()) + "\n\n"
    report_text = report_text + "Events: " + string(event_count) + "\n"
    report_text = report_text + "Incidents: " + string(incident_count) + "\n"
    report_text = report_text + "Alerts: " + string(alert_count) + "\n"

    let sections = ["header", "summary", "metrics"]

    return {
        "report_text": report_text,
        "hash": crypto.sha256(report_text),
        "sections": sections
    }
}

export fn generate_detail_report(events, incidents, alerts, metrics_data) {
    let event_count = len(events)
    let incident_count = len(incidents)

    let report_text = "DETAILED OPERATIONAL REPORT\n"
    report_text = report_text + "Generated: " + string(time.now()) + "\n\n"
    report_text = report_text + "=== EVENTS ===\n"
    report_text = report_text + "Total: " + string(event_count) + "\n\n"

    for i in 0..len(events) {
        if i < 5 {
            report_text = report_text + events[i].message + "\n"
        }
    }

    report_text = report_text + "\n=== INCIDENTS ===\n"
    report_text = report_text + "Total: " + string(incident_count) + "\n\n"

    for i in 0..len(incidents) {
        if i < 5 {
            report_text = report_text + incidents[i].title + "\n"
        }
    }

    return {
        "report_text": report_text,
        "hash": crypto.sha256(report_text),
        "event_count": event_count,
        "incident_count": incident_count
    }
}

export fn rank_incidents_by_severity(incidents) {
    let ranked = incidents |> fn(incs) {
        return incs
    }

    return ranked
}


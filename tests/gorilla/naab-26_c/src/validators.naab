import "models.naab" as models
use regex
use validate

export fn sanitize_string(input) {
    if input == null {
        return ""
    }

    let s = string(input)
    s = string.replace(s, "<", "")
    s = string.replace(s, ">", "")
    s = string.trim(s)
    return s
}

export fn sanitize_log_line(line) {
    if line == null {
        return ""
    }

    let s = string(line)
    s = regex.replace(s, "\\x1b\\[[0-9;]*m", "")
    return sanitize_string(s)
}

export fn validate_rule_syntax(definition) {
    let errors = []
    let valid_categories = ["access_control", "encryption", "audit", "network", "data_protection", "authentication"]

    if definition.get("id") == null || definition.get("id") == "" {
        errors.push("id is required")
    }

    if definition.get("name") == null || definition.get("name") == "" {
        errors.push("name is required")
    }

    let category = definition.get("category")
    if category == null || category == "" {
        errors.push("category is required")
    } else if !array.contains(valid_categories, category) {
        errors.push("category must be one of: access_control, encryption, audit, network, data_protection, authentication")
    }

    let sev = definition.get("severity")
    if sev == null || sev < 0 || sev > 4 {
        errors.push("severity must be valid enum value 0-4")
    }

    let conds = definition.get("conditions")
    if conds == null || len(conds) == 0 {
        errors.push("conditions must be non-empty array")
    }

    return {
        "valid": len(errors) == 0,
        "errors": errors
    }
}

export fn validate_email_address(email) {
    if email == null || email == "" {
        return false
    }
    return validate.email(string(email))
}

export fn validate_condition_tree(conditions) {
    let state = {"max_d": 0, "errors": []}

    fn validate_node(node, current_depth, st) {
        if current_depth > st.get("max_d") {
            st["max_d"] = current_depth
        }

        let op = node.get("op")

        if op <= models.ConditionOp.Matches {
            if node.get("field") == null || node.get("field") == "" {
                st.get("errors").push("missing field at depth " + string(current_depth))
            }
            if node.get("value") == null {
                st.get("errors").push("missing value at depth " + string(current_depth))
            }
        }

        if op == models.ConditionOp.And || op == models.ConditionOp.Or {
            let children = node.get("children") ?? []
            if len(children) == 0 {
                st.get("errors").push("AND/OR requires children at depth " + string(current_depth))
            }
            for child in children {
                validate_node(child, current_depth + 1, st)
            }
        }

        if op == models.ConditionOp.Not {
            let children = node.get("children") ?? []
            if len(children) != 1 {
                st.get("errors").push("NOT requires exactly 1 child at depth " + string(current_depth))
            }
            for child in children {
                validate_node(child, current_depth + 1, st)
            }
        }

        return st
    }

    for cond in conditions {
        state = validate_node(cond, 0, state)
    }

    return {
        "valid": len(state.get("errors")) == 0,
        "errors": state.get("errors"),
        "depth": state.get("max_d")
    }
}

main {

import "models.naab" as models
use uuid

export fn register_entity(registry, entity) {
    for existing in registry {
        if existing.get("id") == entity.get("id") {
            return {
                "registry": registry,
                "success": false,
                "error": "duplicate id"
            }
        }
    }

    registry.push(entity)
    return {
        "registry": registry,
        "success": true
    }
}

export fn get_entity_by_id(registry, id) {
    for entity in registry {
        if entity.get("id") == id {
            return entity
        }
    }
    return null
}

export fn get_entities_by_type(registry, entity_type) {
    let result = []
    for entity in registry {
        if entity.get("entity_type") == entity_type {
            result.push(entity)
        }
    }
    return result
}

export fn update_entity_attribute(registry, entity_id, key, value) {
    let found = false
    let result = []

    for entity in registry {
        if entity.get("id") == entity_id {
            let attrs = entity.get("attributes")
            attrs[key] = value
            entity["attributes"] = attrs
            result.push(entity)
            found = true
        } else {
            result.push(entity)
        }
    }

    return {
        "registry": result,
        "success": found
    }
}

export fn get_entity_attributes(entity) {
    return entity.get("attributes")
}

export fn filter_entities_by_tag(registry, tag) {
    let result = []
    for entity in registry {
        let tags = entity.get("tags") ?? []
        if array.contains(tags, tag) {
            result.push(entity)
        }
    }
    return result
}

fn count_and_format(entities) {
    let result = {}
    for entity in entities {
        let et = entity.get("entity_type")
        let name = models.entity_type_name(et)
        let count = result.get(name) ?? 0
        result[name] = count + 1
    }
    return result
}

export fn count_entities_by_type(registry) {
    return registry |> count_and_format
}


import "models.naab" as models
use uuid

export fn find_best_remediation(finding, available_actions) {
    if len(available_actions) == 0 {
        return {
            "action": "no action available",
            "priority": models.RemediationPriority.Low,
            "estimated_effort": 0,
            "dependencies": []
        }
    }

    let finding_severity = finding.get("severity")
    let priority = match finding_severity {
        models.Severity.Critical => models.RemediationPriority.Immediate,
        models.Severity.High => models.RemediationPriority.High,
        models.Severity.Medium => models.RemediationPriority.Medium,
        _ => models.RemediationPriority.Low
    }

    let best_action = available_actions[0]
    let best_score = 0

    for action in available_actions {
        let score = 100 - (action.get("effort") ?? 0)
        let dep_count = len(action.get("dependencies") ?? [])
        score = score - (dep_count * 5)

        if score > best_score {
            best_score = score
            best_action = action
        }
    }

    return {
        "action": best_action.get("name") ?? "remediate",
        "priority": priority,
        "estimated_effort": best_action.get("effort") ?? 5,
        "dependencies": best_action.get("dependencies") ?? []
    }
}

export fn build_remediation_plan(findings, available_actions) {
    let steps = []

    for finding in findings {
        let remediation = find_best_remediation(finding, available_actions)

        let step = new models.RemediationStep {
            id: uuid.v4(),
            finding_id: finding.get("rule_id"),
            action: remediation.get("action"),
            priority: remediation.get("priority"),
            estimated_hours: remediation.get("estimated_effort"),
            blocked_by: remediation.get("dependencies"),
            completed: false
        }

        steps.push(step)
    }

    let total_effort = 0
    for step in steps {
        total_effort = total_effort + step.get("estimated_hours")
    }

    let priority_order = []
    for i in 0..5 {
        for step in steps {
            if step.get("priority") == i && !array.contains(priority_order, step.get("id")) {
                priority_order.push(step.get("id"))
            }
        }
    }

    let blocked_by = {}
    for step in steps {
        let deps = step.get("blocked_by")
        if len(deps) > 0 {
            blocked_by[step.get("id")] = deps
        }
    }

    return {
        "steps": steps,
        "total_effort": total_effort,
        "priority_order": priority_order,
        "blocked_by": blocked_by
    }
}

export fn estimate_total_effort(steps) {
    let total_hours = 0

    for step in steps {
        total_hours = total_hours + step.get("estimated_hours")
    }

    let days = total_hours / 8
    let cost = total_hours * 150

    return {
        "hours": total_hours,
        "days": days,
        "cost_estimate": cost
    }
}

export fn get_actionable_steps(steps) {
    let actionable = []

    for step in steps {
        let blocked_by = step.get("blocked_by") ?? []
        let can_execute = true

        for blocker_id in blocked_by {
            let blocker = null
            for s in steps {
                if s.get("id") == blocker_id {
                    blocker = s
                    break
                }
            }

            if blocker != null && blocker.get("completed") != true {
                can_execute = false
                break
            }
        }

        if can_execute && step.get("completed") != true {
            actionable.push(step)
        }
    }

    return actionable
}

export fn mark_step_completed(steps, step_id) {
    let result = []

    for step in steps {
        if step.get("id") == step_id {
            step["completed"] = true
            result.push(step)
        } else {
            result.push(step)
        }
    }

    return result
}

main {
}

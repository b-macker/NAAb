{
  "mode": "enforce",
  "security": { "sandbox_level": "elevated" },
  "capabilities": {
    "filesystem": {
      "level": "restricted",
      "read_allowlist": [ "src/*", "govern.json" ],
      "write_allowlist": [ "system/*", "report.json", "factory.log" ]
    },
    "network": { "enabled": false },
    "shell": { "enabled": false }
  },
  "codegen": {
    "enabled": true,
    "allowed_languages": [ "python", "javascript" ]
  },
  "limits": {
    "timeout": { "global": 2400, "per_block": 120 },
    "concurrency": { "max_agent_threads": 4 }
  },
  "restrictions": {
    "dangerous_calls": { "level": "hard" },
    "code_injection": { "level": "hard" }
  },
  "behavioral_sequences": {
    "enabled": true,
    "patterns": [
      {
        "name": "concurrent_coordination",
        "sequence": [ "AGENT_SEND", "AGENT_SEND", "AGENT_SEND" ],
        "max_gap": 0,
        "level": "advisory",
        "rationale": "Tracking parallel agent swarm activity."
      }
    ]
  },
  "agents": {
    "ui_specialist": {
      "provider": "gemini", "model": "gemma-4-31b-it",
      "api_key_env": [ "GK1", "GK2", "GK3", "GK4", "GK5", "GK6" ],
      "system_prompt": "You are a UI Specialist. Design web interfaces using HTML/CSS. Output ONLY raw code.",
      "allowed_actions": [ "AGENT_SEND" ],
      "retry": { "max_attempts": 3, "key_rotation": true }
    },
    "logic_specialist": {
      "provider": "gemini", "model": "gemma-4-31b-it",
      "api_key_env": [ "GK2", "GK4", "GK6", "GK1", "GK3", "GK5" ],
      "system_prompt": "You are a Logic Specialist. Build Python backends. Output ONLY raw code.",
      "allowed_actions": [ "AGENT_SEND" ],
      "retry": { "max_attempts": 3, "key_rotation": true }
    },
    "db_specialist": {
      "provider": "gemini", "model": "gemma-4-31b-it",
      "api_key_env": [ "GK3", "GK1", "GK5", "GK2", "GK4", "GK6" ],
      "system_prompt": "You are a Storage Specialist. Design data schemas. Output ONLY raw code.",
      "allowed_actions": [ "AGENT_SEND" ],
      "retry": { "max_attempts": 3, "key_rotation": true }
    },
    "integrator": {
      "provider": "gemini", "model": "gemma-4-31b-it",
      "api_key_env": [ "GK5", "GK3", "GK1", "GK6", "GK4", "GK2" ],
      "system_prompt": "You are the Integrator. Pull parallel components into a unified report.",
      "allowed_actions": [ "AGENT_SEND" ]
    }
  }
}

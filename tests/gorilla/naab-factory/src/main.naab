import "factory_utils.naab" as utils
use agent
use file
use json
use string

main {
    print("=== NAAb Parallel Autonomous Factory Simulation ===")
    
    // Workforce Setup
    let ui_spec    = agent.create("ui_specialist")
    let logic_spec = agent.create("logic_specialist")
    let db_spec    = agent.create("db_specialist")
    let integrator = agent.create("integrator")

    // --- PHASE 1: Parallel Design (Batch) ---
    print("\n[Phase 1] Parallel System Design (Batch Dispatch)")
    let design_prompts = [
        "Outline the HTML/CSS requirements for a real-time dashboard.",
        "Define the Python API endpoints required for a task manager.",
        "Design a JSON schema for a distributed task database."
    ]
    let design_results = agent.batch([ui_spec, logic_spec, db_spec], design_prompts)
    let designs = utils.get_batch_content(design_results)
    
    print("  Parallel Design Complete.")
    print("  UI Spec: " + string(string.length(designs[0])) + " chars")
    print("  Logic Spec: " + string(string.length(designs[1])) + " chars")
    print("  DB Spec: " + string(string.length(designs[2])) + " chars")

    // --- PHASE 2: Parallel Implementation (Batch) ---
    print("\n[Phase 2] Parallel Code Implementation (Batch Dispatch)")
    let impl_prompts = [
        "Implement the dashboard HTML/CSS based on: " + designs[0],
        "Implement the Python FastAPI backend based on: " + designs[1],
        "Implement the JSON data bootstrap based on: " + designs[2]
    ]
    let impl_results = agent.batch([ui_spec, logic_spec, db_spec], impl_prompts)
    let components = utils.get_batch_content(impl_results)
    
    print("  Parallel Implementation Complete.")

    // --- PHASE 3: Synthesis & Audit ---
    print("\n[Phase 3] Integration and Compatibility Audit")
    let compat = utils.summarize_system(components[0], components[1], components[2])
    print("  System Compatibility Score: " + string(compat.get("score")))
    
    if compat.get("score") < 0.5 {
        print("  CRITICAL: System components are incompatible. Restarting factory...")
        return
    }

    // --- PHASE 4: Deployment (Finalizer) ---
    print("\n[Phase 4] System Integration Deployment")
    let final_report = agent.send(integrator, "Summarize the final system components and compatibility score: " + json.stringify(compat))
    
    file.write("report.json", json.stringify({
        "compatibility": compat,
        "summary": final_report,
        "components": {
            "ui": components[0],
            "logic": components[1],
            "db": components[2]
        }
    }))

    print("\n=== Factory Operation Complete ===")
}

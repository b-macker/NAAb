// Hardening test: Budget=3 agent with reduced per-turn costs (F1)
// After F1: max 2/turn → budget=3 allows ≥2 turns
use agent

main {
    let h = agent.create("tight_budget")
    let succeeded = 0
    let blocked_at = -1

    for i in 0..3 {
        let r = try { agent.send(h, "Turn " + string(i) + ": Say hello") } catch (e) { null }
        if r != null {
            succeeded = succeeded + 1
        } else {
            if blocked_at == -1 {
                blocked_at = i
            }
        }
    }

    print("budget3: succeeded=" + string(succeeded) + " blocked_at=" + string(blocked_at))
}

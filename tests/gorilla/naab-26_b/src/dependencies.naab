import "models.naab" as models

export fn build_dependency_graph(rules) {
    let graph = {}
    for rule in rules {
        if rule.status == models.RuleStatus.Active {
            let deps = rule.dependencies ?? []
            graph[rule.id] = deps
        }
    }
    return graph
}

export fn resolve_rule_dependencies(rules) {
    let graph = {}
    for rule in rules {
        if rule.status == models.RuleStatus.Active {
            let deps = rule.dependencies ?? []
            graph[rule.id] = deps
        }
    }

    let result = <<python[graph] -> JSON
import json
from collections import deque

in_degree = {n: 0 for n in graph}
for node in graph:
    for dep in graph[node]:
        if dep in in_degree:
            in_degree[dep] = in_degree.get(dep, 0) + 1

queue = deque([n for n, d in in_degree.items() if d == 0])
order = []
while queue:
    n = queue.popleft()
    order.append(n)
    for node in graph:
        if n in graph[node]:
            graph[node].remove(n)
            in_degree[node] -= 1
            if in_degree[node] == 0:
                queue.append(node)

cycles = []
unresolvable = [n for n in in_degree if n not in order]
json.dumps({"order": order, "cycles": cycles, "unresolvable": unresolvable})
    >>
    return result
}

fn dfs_impl(graph, node, st) {
    st["color"][node] = "gray"

    let deps = graph.get(node) ?? []
    for dep in deps {
        if st["color"].get(dep) == null {
            st = dfs_impl(graph, dep, st)
        } else if st["color"].get(dep) == "gray" {
            st["has_cycles"] = true
            if st["affected_rules"].find(fn(x) { return x == node }) == null {
                st["affected_rules"].push(node)
            }
            if st["affected_rules"].find(fn(x) { return x == dep }) == null {
                st["affected_rules"].push(dep)
            }
        }
    }

    st["color"][node] = "black"
    return st
}

fn dfs(graph, node, st) {
    return dfs_impl(graph, node, st)
}

export fn detect_circular_dependencies(graph) {
    let state = dfs(graph, null, {"has_cycles": false, "cycles": [], "affected_rules": [], "color": {}})

    for node in graph {
        if state.get("color").get(node) == null {
            state = dfs_impl(graph, node, state)
        }
    }

    return state
}

export fn traverse_dependency_tree(graph, root_id, visited) {
    if graph.get(root_id) == null {
        return []
    }

    let found = false
    for v in visited {
        if v == root_id {
            found = true
        }
    }
    if found {
        return []
    }

    visited.push(root_id)
    let result = []

    let deps = graph.get(root_id) ?? []
    for dep in deps {
        result.push(dep)
        let transitive = traverse_dependency_tree(graph, dep, visited)
        for t in transitive {
            result.push(t)
        }
    }

    return result
}

export fn calculate_dependency_depth(graph, rule_id, memo) {
    if memo.get(rule_id) != null {
        let cached = memo.get(rule_id)
        if cached == -1 {
            return 0
        }
        return cached
    }

    let deps = graph.get(rule_id) ?? []
    if len(deps) == 0 {
        memo[rule_id] = 0
        return 0
    }

    memo[rule_id] = -1

    let max_dep_depth = 0
    for dep in deps {
        let dep_depth = calculate_dependency_depth(graph, dep, memo)
        if dep_depth >= max_dep_depth {
            max_dep_depth = dep_depth + 1
        }
    }

    memo[rule_id] = max_dep_depth
    return max_dep_depth
}

main {
    print("dependencies.naab loaded")
}

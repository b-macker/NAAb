use uuid

import "models.naab" as models

export fn register_entity(registry, entity) {
    for existing in registry {
        if existing.id == entity.id {
            return {"registry": registry, "success": false, "error": "duplicate id"}
        }
    }

    registry.push(entity)
    return {"registry": registry, "success": true}
}

export fn get_entity_by_id(registry, id) {
    for entity in registry {
        if entity.id == id {
            return entity
        }
    }
    return null
}

export fn get_entities_by_type(registry, entity_type) {
    let result = []
    for entity in registry {
        if entity.entity_type == entity_type {
            result.push(entity)
        }
    }
    return result
}

export fn update_entity_attribute(registry, entity_id, key, value) {
    for i in 0..len(registry) {
        let entity = registry[i]
        if entity.id == entity_id {
            entity.attributes[key] = value
            registry[i] = entity
            return {"registry": registry, "success": true}
        }
    }
    return {"registry": registry, "success": false}
}

export fn get_entity_attributes(entity) {
    return entity.attributes
}

export fn filter_entities_by_tag(registry, tag) {
    let result = []
    for entity in registry {
        let found = false
        for t in entity.tags {
            if t == tag {
                found = true
            }
        }
        if found {
            result.push(entity)
        }
    }
    return result
}

export fn count_entities_by_type(registry) {
    let counts = {}
    for entity in registry {
        let type_name = models.entity_type_name(entity.entity_type)
        if counts.get(type_name) == null {
            counts[type_name] = 0
        }
        counts[type_name] = int(counts.get(type_name)) + 1
    }
    return counts
}

main {
    print("entities.naab loaded")
}

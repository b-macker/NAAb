    let passed = test_models_result[0] + test_validators_result[0] + test_conditions_result[0] + test_rules_result[0] + test_entities_result[0] + test_evaluator_result[0] + test_dependencies_result[0] + test_risk_result[0] + test_reports_result[0] + test_remediation_result[0] + test_interpreter_result[0] + test_integration_result[0]

    print("Total: " + string(passed) + "/" + string(total))

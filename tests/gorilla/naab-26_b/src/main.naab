fn test_models() {
    let passed = 0
    let total = 0

    total = total + 1
    let rule = models.create_rule("R1", "Test Rule", "Test", models.Severity.Critical, "encryption", [], [], [])
    if rule.id == "R1" && rule.status == models.RuleStatus.Active && rule.version == 1 {
        passed = passed + 1
    }

    total = total + 1
    let entity = models.create_entity("E1", "ProdDB", models.EntityType.Database, {"encryption": "AES256"}, ["prod"], "admin")
    if entity.name == "ProdDB" && entity.entity_type == models.EntityType.Database {
        passed = passed + 1
    }

    total = total + 1
    let cond = models.create_condition(models.ConditionOp.Equals, "encryption", "AES256", [])
    if cond.get("op") == models.ConditionOp.Equals && cond.get("field") == "encryption" {
        passed = passed + 1
    }

    total = total + 1
    let finding = models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "Missing encryption", "no TLS")
    if finding.result == models.ComplianceResult.Fail && finding.severity == models.Severity.Critical {
        passed = passed + 1
    }

    total = total + 1
    if models.severity_name(models.Severity.Critical) == "Critical" {
        passed = passed + 1
    }

    total = total + 1
    if models.op_name(models.ConditionOp.GreaterThan) == ">" {
        passed = passed + 1
    }

    total = total + 1
    if models.result_name(models.ComplianceResult.Pass) == "Pass" {
        passed = passed + 1
    }

    total = total + 1
    if models.entity_type_name(models.EntityType.Database) == "Database" {
        passed = passed + 1
    }

    total = total + 1
    let valid_rule = models.create_rule("R1", "Test", "Test", 0, "encryption", [{}], [], [])
    let v_result = models.validate_rule(valid_rule)
    if v_result.get("valid") == true {
        passed = passed + 1
    }

    total = total + 1
    let invalid_entity = new models.Entity { id: "E1", name: "", entity_type: 0, attributes: {}, tags: [], owner: "admin", created_at: 0 }
    let inv_result = models.validate_entity(invalid_entity)
    if inv_result.get("valid") != true {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_validators() {
    let passed = 0
    let total = 0

    total = total + 1
    let sanitized = validators.sanitize_string("<script>alert</script>")
    if !string.contains(sanitized, "<") && !string.contains(sanitized, ">") {
        passed = passed + 1
    }

    total = total + 1
    let json_str = validators.sanitize_string("{\"key\": \"val\"}")
    if string.contains(json_str, "\"") {
        passed = passed + 1
    }

    total = total + 1
    let log_line = validators.sanitize_log_line("test\x1b[31mred")
    if !string.contains(log_line, "\x1b") {
        passed = passed + 1
    }

    total = total + 1
    let rule_def = {
        "id": "R1",
        "name": "Test",
        "category": "encryption",
        "severity": 0,
        "conditions": [{}]
    }
    let syntax_result = validators.validate_rule_syntax(rule_def)
    if syntax_result.get("valid") == true {
        passed = passed + 1
    }

    total = total + 1
    let bad_rule = {
        "id": "",
        "name": "Test",
        "category": "encryption",
        "severity": 0,
        "conditions": [{}]
    }
    let bad_result = validators.validate_rule_syntax(bad_rule)
    if bad_result.get("valid") != true {
        passed = passed + 1
    }

    total = total + 1
    let invalid_cat = {
        "id": "R1",
        "name": "Test",
        "category": "invalid_category",
        "severity": 0,
        "conditions": [{}]
    }
    let cat_result = validators.validate_rule_syntax(invalid_cat)
    if cat_result.get("valid") != true {
        passed = passed + 1
    }

    total = total + 1
    let leaf_cond = [{"op": models.ConditionOp.Equals, "field": "x", "value": "y", "children": []}]
    let leaf_result = validators.validate_condition_tree(leaf_cond)
    if leaf_result.get("valid") == true && leaf_result.get("depth") == 0 {
        passed = passed + 1
    }

    total = total + 1
    let and_cond = [{
        "op": models.ConditionOp.And,
        "field": "",
        "value": "",
        "children": [
            {"op": models.ConditionOp.Equals, "field": "x", "value": "y", "children": []},
            {"op": models.ConditionOp.Equals, "field": "z", "value": "w", "children": []}
        ]
    }]
    let and_result = validators.validate_condition_tree(and_cond)
    if and_result.get("valid") == true && and_result.get("depth") == 1 {
        passed = passed + 1
    }

    total = total + 1
    let not_bad = [{
        "op": models.ConditionOp.Not,
        "field": "",
        "value": "",
        "children": [
            {"op": models.ConditionOp.Equals, "field": "x", "value": "y", "children": []},
            {"op": models.ConditionOp.Equals, "field": "z", "value": "w", "children": []}
        ]
    }]
    let not_result = validators.validate_condition_tree(not_bad)
    if not_result.get("valid") != true {
        passed = passed + 1
    }

    total = total + 1
    let deep_cond = [{
        "op": models.ConditionOp.And,
        "field": "",
        "value": "",
        "children": [{
            "op": models.ConditionOp.Or,
            "field": "",
            "value": "",
            "children": [{
                "op": models.ConditionOp.Not,
                "field": "",
                "value": "",
                "children": [{"op": models.ConditionOp.Equals, "field": "x", "value": "y", "children": []}]
            }]
        }]
    }]
    let deep_result = validators.validate_condition_tree(deep_cond)
    if deep_result.get("depth") == 3 {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_conditions() {
    let passed = 0
    let total = 0

    total = total + 1
    let eq_cond = models.create_condition(models.ConditionOp.Equals, "role", "admin", [])
    let eq_result = conditions.evaluate_condition(eq_cond, {"role": "admin"})
    if eq_result.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let ne_cond = models.create_condition(models.ConditionOp.Equals, "role", "admin", [])
    let ne_result = conditions.evaluate_condition(ne_cond, {"role": "user"})
    if ne_result.get("passed") != true {
        passed = passed + 1
    }

    total = total + 1
    let gt_cond = models.create_condition(models.ConditionOp.GreaterThan, "port", "1024", [])
    let gt_result = conditions.evaluate_condition(gt_cond, {"port": "8080"})
    if gt_result.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let lt_cond = models.create_condition(models.ConditionOp.LessThan, "age_days", "90", [])
    let lt_result = conditions.evaluate_condition(lt_cond, {"age_days": "30"})
    if lt_result.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let cont_cond = models.create_condition(models.ConditionOp.Contains, "name", "prod", [])
    let cont_result = conditions.evaluate_condition(cont_cond, {"name": "prod-db-01"})
    if cont_result.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let and_cond = models.create_condition(models.ConditionOp.And, "", "", [
        models.create_condition(models.ConditionOp.Equals, "role", "admin", []),
        models.create_condition(models.ConditionOp.Equals, "active", "true", [])
    ])
    let and_result = conditions.evaluate_condition(and_cond, {"role": "admin", "active": "true"})
    if and_result.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let and_fail = models.create_condition(models.ConditionOp.And, "", "", [
        models.create_condition(models.ConditionOp.Equals, "role", "admin", []),
        models.create_condition(models.ConditionOp.Equals, "active", "true", [])
    ])
    let and_f_result = conditions.evaluate_condition(and_fail, {"role": "user", "active": "true"})
    if and_f_result.get("passed") != true {
        passed = passed + 1
    }

    total = total + 1
    let or_cond = models.create_condition(models.ConditionOp.Or, "", "", [
        models.create_condition(models.ConditionOp.Equals, "env", "prod", []),
        models.create_condition(models.ConditionOp.Equals, "env", "staging", [])
    ])
    let or_result = conditions.evaluate_condition(or_cond, {"env": "staging"})
    if or_result.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let not_cond = models.create_condition(models.ConditionOp.Not, "", "", [
        models.create_condition(models.ConditionOp.Equals, "disabled", "true", [])
    ])
    let not_result = conditions.evaluate_condition(not_cond, {"disabled": "false"})
    if not_result.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let count_cond = models.create_condition(models.ConditionOp.And, "", "", [
        models.create_condition(models.ConditionOp.Equals, "a", "1", []),
        models.create_condition(models.ConditionOp.Equals, "b", "2", []),
        models.create_condition(models.ConditionOp.Or, "", "", [
            models.create_condition(models.ConditionOp.Equals, "c", "3", []),
            models.create_condition(models.ConditionOp.Equals, "d", "4", [])
        ])
    ])
    let count = conditions.count_conditions(count_cond)
    if count == 5 {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_rules() {
    let passed = 0
    let total = 0

    total = total + 1
    let json_text = "{\"id\":\"R1\",\"name\":\"Encryption Check\",\"description\":\"Verify encryption\",\"severity\":0,\"category\":\"encryption\",\"conditions\":[{\"op\":\"==\",\"field\":\"encryption\",\"value\":\"AES256\",\"children\":[]}],\"dependencies\":[],\"tags\":[\"security\"]}"
    let parse_result = rules_mod.parse_rule_definition(json_text)
    if parse_result.get("valid") == true && parse_result.get("rule").id == "R1" {
        passed = passed + 1
    }

    total = total + 1
    let bad_json = "not json{"
    let bad_parse = rules_mod.parse_rule_definition(bad_json)
    if bad_parse.get("valid") != true {
        passed = passed + 1
    }

    total = total + 1
    let incomplete_json = "{\"id\":\"R1\",\"description\":\"Test\",\"severity\":0,\"category\":\"encryption\",\"conditions\":[{}]}"
    let inc_parse = rules_mod.parse_rule_definition(incomplete_json)
    if inc_parse.get("valid") != true {
        passed = passed + 1
    }

    total = total + 1
    let raw_conds = [
        {"op":"==","field":"x","value":"1","children":[]},
        {"op":"AND","field":"","value":"","children":[{"op":"!=","field":"y","value":"2","children":[]}]}
    ]
    let parsed_conds = rules_mod.parse_condition_tree(raw_conds)
    if len(parsed_conds) == 2 && len(parsed_conds[1].get("children")) == 1 {
        passed = passed + 1
    }

    total = total + 1
    let test_rules = [
        models.create_rule("R1", "Enc1", "Test", 0, "encryption", [], [], []),
        models.create_rule("R2", "Enc2", "Test", 0, "encryption", [], [], []),
        models.create_rule("R3", "Audit1", "Test", 0, "audit", [], [], [])
    ]
    let filtered_enc = rules_mod.filter_rules_by_category(test_rules, "encryption")
    if len(filtered_enc) == 2 {
        passed = passed + 1
    }

    total = total + 1
    let sev_rules = [
        models.create_rule("R1", "Crit", "Test", models.Severity.Critical, "encryption", [{}], [], []),
        models.create_rule("R2", "High", "Test", models.Severity.High, "encryption", [{}], [], []),
        models.create_rule("R3", "Med", "Test", models.Severity.Medium, "encryption", [{}], [], []),
        models.create_rule("R4", "Low", "Test", models.Severity.Low, "encryption", [{}], [], [])
    ]
    let filtered_sev = rules_mod.filter_rules_by_severity(sev_rules, models.Severity.Critical)
    if len(filtered_sev) == 1 {
        passed = passed + 1
    }

    total = total + 1
    let active_rules = [
        models.create_rule("R1", "Active1", "Test", 0, "encryption", [{}], [], []),
        models.create_rule("R2", "Active2", "Test", 0, "encryption", [{}], [], [])
    ]
    let active_rules_2 = active_rules
    let r_dep = models.create_rule("R3", "Dep", "Test", 0, "encryption", [{}], [], [])
    r_dep.status = models.RuleStatus.Deprecated
    active_rules_2.push(r_dep)
    let filtered_active = rules_mod.filter_active_rules(active_rules_2)
    if len(filtered_active) == 2 {
        passed = passed + 1
    }

    total = total + 1
    let find_rules = [
        models.create_rule("R1", "First", "Test", 0, "encryption", [{}], [], []),
        models.create_rule("R2", "Second", "Test", 0, "encryption", [{}], [], [])
    ]
    let found = rules_mod.get_rule_by_id(find_rules, "R2")
    if found != null && found.id == "R2" {
        passed = passed + 1
    }

    total = total + 1
    let orig_rule = models.create_rule("R1", "Test", "Test", 0, "encryption", [{}], [], [])
    let updated = rules_mod.update_rule_status(orig_rule, models.RuleStatus.Deprecated)
    if updated.get("status") == models.RuleStatus.Deprecated && updated.get("version") == 2 {
        passed = passed + 1
    }

    total = total + 1
    let merge_rule = models.create_rule("R1", "Test", "Test", 0, "encryption", [{}], [], ["a", "b"])
    let merged = rules_mod.merge_rule_tags(merge_rule, ["b", "c"])
    let merged_tags = merged.get("tags")
    if len(merged_tags) == 3 {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_entities() {
    let passed = 0
    let total = 0

    total = total + 1
    let registry = []
    let e1 = models.create_entity("E1", "Prod", models.EntityType.Server, {}, [], "admin")
    let reg_result = entities_mod.register_entity(registry, e1)
    if reg_result.get("success") == true && len(reg_result.get("registry")) == 1 {
        passed = passed + 1
    }

    total = total + 1
    let dup_result = entities_mod.register_entity(reg_result.get("registry"), e1)
    if dup_result.get("success") != true {
        passed = passed + 1
    }

    total = total + 1
    let e2 = models.create_entity("E2", "Dev", models.EntityType.Server, {}, [], "admin")
    let e3 = models.create_entity("E3", "DB", models.EntityType.Database, {}, [], "admin")
    let test_reg = []
    test_reg.push(e1)
    test_reg.push(e2)
    test_reg.push(e3)
    let found = entities_mod.get_entity_by_id(test_reg, "E2")
    if found != null && found.id == "E2" {
        passed = passed + 1
    }

    total = total + 1
    let not_found = entities_mod.get_entity_by_id(test_reg, "E99")
    if not_found == null {
        passed = passed + 1
    }

    total = total + 1
    let by_type = entities_mod.get_entities_by_type(test_reg, models.EntityType.Server)
    if len(by_type) == 2 {
        passed = passed + 1
    }

    total = total + 1
    let update_reg = test_reg
    let upd_result = entities_mod.update_entity_attribute(update_reg, "E1", "tls", "1.3")
    if upd_result.get("success") == true {
        let updated_entity = entities_mod.get_entity_by_id(upd_result.get("registry"), "E1")
        if updated_entity.attributes.get("tls") == "1.3" {
            passed = passed + 1
        }
    }

    total = total + 1
    let upd_fail = entities_mod.update_entity_attribute(test_reg, "E99", "x", "y")
    if upd_fail.get("success") != true {
        passed = passed + 1
    }

    total = total + 1
    let tagged_e = models.create_entity("E4", "ProdServer", models.EntityType.Server, {}, ["prod", "critical"], "admin")
    let tagged_e2 = models.create_entity("E5", "DevServer", models.EntityType.Server, {}, ["dev"], "admin")
    let tag_reg = [tagged_e, tagged_e2]
    let by_tag = entities_mod.filter_entities_by_tag(tag_reg, "prod")
    if len(by_tag) == 1 && by_tag[0].id == "E4" {
        passed = passed + 1
    }

    total = total + 1
    let s1 = models.create_entity("S1", "Server1", models.EntityType.Server, {}, [], "admin")
    let s2 = models.create_entity("S2", "Server2", models.EntityType.Server, {}, [], "admin")
    let d1 = models.create_entity("D1", "Database", models.EntityType.Database, {}, [], "admin")
    let a1 = models.create_entity("A1", "App", models.EntityType.Application, {}, [], "admin")
    let count_reg = [s1, s2, d1, a1]
    let counts = entities_mod.count_entities_by_type(count_reg)
    if counts.get("Server") == 2 && counts.get("Database") == 1 && counts.get("Application") == 1 {
        passed = passed + 1
    }

    total = total + 1
    let attr_entity = models.create_entity("E1", "Test", models.EntityType.Server, {"os": "linux", "version": "20.04"}, [], "admin")
    let attrs = entities_mod.get_entity_attributes(attr_entity)
    if len(attrs) == 2 && attrs.get("os") == "linux" {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_evaluator() {
    let passed = 0
    let total = 0

    total = total + 1
    let enc_rule = models.create_rule("R1", "Enc", "Test", models.Severity.Critical, "encryption", [
        models.create_condition(models.ConditionOp.Equals, "encryption", "AES256", [])
    ], [], [])
    let enc_entity = models.create_entity("E1", "DB", models.EntityType.Database, {"encryption": "AES256"}, [], "admin")
    let enc_eval = evaluator.evaluate_rule(enc_rule, enc_entity)
    if enc_eval.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let fail_entity = models.create_entity("E2", "DB", models.EntityType.Database, {"encryption": "none"}, [], "admin")
    let fail_eval = evaluator.evaluate_rule(enc_rule, fail_entity)
    if fail_eval.get("passed") != true {
        passed = passed + 1
    }

    total = total + 1
    let inactive_rule = models.create_rule("R2", "Inactive", "Test", models.Severity.Low, "encryption", [{}], [], [])
    inactive_rule.status = models.RuleStatus.Deprecated
    let inactive_eval = evaluator.evaluate_rule(inactive_rule, enc_entity)
    if inactive_eval.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let rules_to_eval = [enc_rule, inactive_rule]
    let entity_eval = evaluator.evaluate_entity(rules_to_eval, enc_entity)
    if entity_eval.get("passed") == 1 && entity_eval.get("failed") == 0 {
        passed = passed + 1
    }

    total = total + 1
    let and_rule = models.create_rule("R3", "AND", "Test", models.Severity.High, "encryption", [
        models.create_condition(models.ConditionOp.And, "", "", [
            models.create_condition(models.ConditionOp.Equals, "encryption", "AES256", []),
            models.create_condition(models.ConditionOp.Equals, "tls", "1.3", [])
        ])
    ], [], [])
    let and_entity = models.create_entity("E3", "DB", models.EntityType.Database, {"encryption": "AES256", "tls": "1.3"}, [], "admin")
    let and_eval = evaluator.evaluate_rule(and_rule, and_entity)
    if and_eval.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let or_rule = models.create_rule("R4", "OR", "Test", models.Severity.Medium, "encryption", [
        models.create_condition(models.ConditionOp.Or, "", "", [
            models.create_condition(models.ConditionOp.Equals, "env", "prod", []),
            models.create_condition(models.ConditionOp.Equals, "env", "staging", [])
        ])
    ], [], [])
    let or_entity = models.create_entity("E4", "Server", models.EntityType.Server, {"env": "staging"}, [], "admin")
    let or_eval = evaluator.evaluate_rule(or_rule, or_entity)
    if or_eval.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let batch_rules = [enc_rule, and_rule, or_rule]
    let batch_entities = [enc_entity, and_entity, or_entity]
    let batch_result = evaluator.batch_evaluate(batch_rules, batch_entities)
    if batch_result.get("total") >= 0 {
        passed = passed + 1
    }

    total = total + 1
    let agg_findings = [
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "msg", "ev"),
        models.create_finding("R2", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "msg", "ev"),
        models.create_finding("R3", "E1", models.ComplianceResult.Fail, models.Severity.High, "msg", "ev"),
        models.create_finding("R4", "E1", models.ComplianceResult.Fail, models.Severity.High, "msg", "ev"),
        models.create_finding("R5", "E1", models.ComplianceResult.Fail, models.Severity.Medium, "msg", "ev")
    ]
    let agg_result = evaluator.aggregate_findings(agg_findings, "severity")
    if agg_result.get("Critical") == 2 && agg_result.get("High") == 2 {
        passed = passed + 1
    }

    total = total + 1
    let entity_findings = [
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "msg", "ev"),
        models.create_finding("R2", "E2", models.ComplianceResult.Fail, models.Severity.High, "msg", "ev"),
        models.create_finding("R3", "E1", models.ComplianceResult.Fail, models.Severity.Medium, "msg", "ev"),
        models.create_finding("R4", "E2", models.ComplianceResult.Fail, models.Severity.Low, "msg", "ev")
    ]
    let entity_agg = evaluator.aggregate_findings(entity_findings, "entity")
    if entity_agg.get("E1") == 2 && entity_agg.get("E2") == 2 {
        passed = passed + 1
    }

    total = total + 1
    let crit_findings = [
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "msg", "ev"),
        models.create_finding("R2", "E1", models.ComplianceResult.Fail, models.Severity.High, "msg", "ev"),
        models.create_finding("R3", "E1", models.ComplianceResult.Fail, models.Severity.High, "msg", "ev"),
        models.create_finding("R4", "E1", models.ComplianceResult.Fail, models.Severity.Medium, "msg", "ev")
    ]
    let crit_result = evaluator.get_critical_findings(crit_findings)
    if len(crit_result) == 3 {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_dependencies() {
    let passed = 0
    let total = 0

    total = total + 1
    let dep_rules = [
        models.create_rule("R1", "R1", "T", 0, "enc", [{}], [], []),
        models.create_rule("R2", "R2", "T", 0, "enc", [{}], ["R1"], []),
        models.create_rule("R3", "R3", "T", 0, "enc", [{}], ["R1", "R2"], [])
    ]
    let graph = dependencies.build_dependency_graph(dep_rules)
    if len(graph) == 3 {
        passed = passed + 1
    }

    total = total + 1
    let resolved = dependencies.resolve_rule_dependencies(dep_rules)
    if resolved.get("order") != null && len(resolved.get("order")) >= 0 {
        passed = passed + 1
    }

    total = total + 1
    let cyclic_rules = [
        models.create_rule("R1", "R1", "T", 0, "enc", [{}], ["R2"], []),
        models.create_rule("R2", "R2", "T", 0, "enc", [{}], ["R1"], [])
    ]
    let cyclic_resolved = dependencies.resolve_rule_dependencies(cyclic_rules)
    if len(cyclic_resolved.get("unresolvable")) > 0 {
        passed = passed + 1
    }

    total = total + 1
    let linear_graph = {
        "R1": [],
        "R2": ["R1"],
        "R3": ["R2"]
    }
    let detect_result = dependencies.detect_circular_dependencies(linear_graph)
    if detect_result.get("has_cycles") != true {
        passed = passed + 1
    }

    total = total + 1
    let simple_cycle = {
        "A": ["B"],
        "B": ["A"]
    }
    let cycle_result = dependencies.detect_circular_dependencies(simple_cycle)
    if cycle_result.get("has_cycles") == true {
        passed = passed + 1
    }

    total = total + 1
    let complex_cycle = {
        "A": ["B"],
        "B": ["C"],
        "C": ["A"],
        "D": []
    }
    let complex_result = dependencies.detect_circular_dependencies(complex_cycle)
    if complex_result.get("has_cycles") == true && len(complex_result.get("affected_rules")) >= 3 {
        passed = passed + 1
    }

    total = total + 1
    let trav_graph = {
        "R1": ["R2", "R3"],
        "R2": ["R4"],
        "R3": [],
        "R4": []
    }
    let traversed = dependencies.traverse_dependency_tree(trav_graph, "R1", [])
    if len(traversed) >= 2 {
        passed = passed + 1
    }

    total = total + 1
    let depth_graph = {
        "R1": ["R2"],
        "R2": ["R3"],
        "R3": ["R4"],
        "R4": []
    }
    let memo = {}
    let depth = dependencies.calculate_dependency_depth(depth_graph, "R1", memo)
    if depth == 3 {
        passed = passed + 1
    }

    total = total + 1
    let memo2 = {}
    dependencies.calculate_dependency_depth(depth_graph, "R3", memo2)
    let depth2 = dependencies.calculate_dependency_depth(depth_graph, "R1", memo2)
    if depth2 == 3 {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_risk() {
    let passed = 0
    let total = 0

    total = total + 1
    let crit_findings = [
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "m", "e"),
        models.create_finding("R2", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "m", "e"),
        models.create_finding("R3", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "m", "e")
    ]
    let crit_score = risk.calculate_risk_score(crit_findings)
    if crit_score.get("score") >= 80 {
        passed = passed + 1
    }

    total = total + 1
    let low_findings = [
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Low, "m", "e"),
        models.create_finding("R2", "E1", models.ComplianceResult.Fail, models.Severity.Low, "m", "e")
    ]
    let low_score = risk.calculate_risk_score(low_findings)
    if low_score.get("score") <= 30 {
        passed = passed + 1
    }

    total = total + 1
    let mixed = [
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "m", "e"),
        models.create_finding("R2", "E1", models.ComplianceResult.Fail, models.Severity.High, "m", "e"),
        models.create_finding("R3", "E1", models.ComplianceResult.Fail, models.Severity.High, "m", "e"),
        models.create_finding("R4", "E1", models.ComplianceResult.Fail, models.Severity.Medium, "m", "e"),
        models.create_finding("R5", "E1", models.ComplianceResult.Fail, models.Severity.Medium, "m", "e"),
        models.create_finding("R6", "E1", models.ComplianceResult.Fail, models.Severity.Medium, "m", "e")
    ]
    let mixed_score = risk.calculate_risk_score(mixed)
    if mixed_score.get("score") >= 40 && mixed_score.get("score") <= 80 {
        passed = passed + 1
    }

    total = total + 1
    let crit_level_score = risk.calculate_risk_score(crit_findings)
    if crit_level_score.get("risk_level") == "critical" {
        passed = passed + 1
    }

    total = total + 1
    let minimal_score = risk.calculate_risk_score([])
    if minimal_score.get("risk_level") == "minimal" {
        passed = passed + 1
    }

    total = total + 1
    let portfolio_results = [
        {"entity_id": "E1", "findings": [1, 2, 3]},
        {"entity_id": "E2", "findings": [1]},
        {"entity_id": "E3", "findings": []}
    ]
    let portfolio = risk.calculate_portfolio_risk(portfolio_results)
    if portfolio.get("total_entities") == 3 {
        passed = passed + 1
    }

    total = total + 1
    let matrix_entities = [
        models.create_entity("E1", "Server", models.EntityType.Server, {}, [], "a"),
        models.create_entity("E2", "DB", models.EntityType.Database, {}, [], "a")
    ]
    let matrix_findings = [
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "m", "e"),
        models.create_finding("R2", "E2", models.ComplianceResult.Fail, models.Severity.High, "m", "e")
    ]
    let matrix = risk.generate_risk_matrix(matrix_entities, matrix_findings)
    if matrix.get("matrix") != null {
        passed = passed + 1
    }

    total = total + 1
    let metrics_findings = [
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "m", "e")
    ]
    let metrics_rules = [
        models.create_rule("R1", "R1", "T", 0, "enc", [{}], [], []),
        models.create_rule("R2", "R2", "T", 0, "enc", [{}], [], []),
        models.create_rule("R3", "R3", "T", 0, "enc", [{}], [], []),
        models.create_rule("R4", "R4", "T", 0, "enc", [{}], [], []),
        models.create_rule("R5", "R5", "T", 0, "enc", [{}], [], [])
    ]
    let metrics = risk.calculate_compliance_metrics(metrics_findings, metrics_rules)
    if metrics.get("total_rules") == 5 {
        passed = passed + 1
    }

    total = total + 1
    let ranked = risk.rank_entities_by_risk(portfolio_results)
    if len(ranked) == 3 {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_reports() {
    let passed = 0
    let total = 0

    total = total + 1
    let report_findings = [models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "msg", "ev")]
    let report_rules = [models.create_rule("R1", "R1", "T", 0, "enc", [{}], [], [])]
    let report_entities = [models.create_entity("E1", "DB", models.EntityType.Database, {}, [], "a")]
    let report = reports.generate_compliance_report(report_findings, report_rules, report_entities)
    if string.contains(report.get("report_text"), "R1") {
        passed = passed + 1
    }

    total = total + 1
    let hash = report.get("hash")
    if len(hash) == 64 {
        passed = passed + 1
    }

    total = total + 1
    let events = ["event1", "event2", "event3"]
    let audit = reports.generate_audit_report(events)
    if len(audit.get("trail")) == 3 && len(audit.get("hash_chain")) == 3 {
        passed = passed + 1
    }

    total = total + 1
    let hashes = audit.get("hash_chain")
    if hashes[0] != hashes[1] {
        passed = passed + 1
    }

    total = total + 1
    let events2 = ["event1", "event2", "event3"]
    let audit2 = reports.generate_audit_report(events2)
    let hashes2 = audit2.get("hash_chain")
    if hashes2[0] == hashes[0] {
        passed = passed + 1
    }

    total = total + 1
    let csv_findings = [
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "msg1", "ev"),
        models.create_finding("R2", "E2", models.ComplianceResult.Fail, models.Severity.High, "msg2", "ev"),
        models.create_finding("R3", "E3", models.ComplianceResult.Fail, models.Severity.Medium, "msg3", "ev")
    ]
    let csv = reports.export_findings_csv(csv_findings)
    if string.contains(csv, "rule_id") && len(csv.split("\n")) == 4 {
        passed = passed + 1
    }

    total = total + 1
    let finding = models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "m", "e")
    let formatted = reports.format_finding(finding)
    if string.contains(formatted, "[CRIT]") {
        passed = passed + 1
    }

    total = total + 1
    let low_finding = models.create_finding("R2", "E2", models.ComplianceResult.Fail, models.Severity.Low, "m", "e")
    let low_formatted = reports.format_finding(low_finding)
    if string.contains(low_formatted, "[LOW ]") {
        passed = passed + 1
    }

    total = total + 1
    let clean_report = "<script>test</script>"
    let write_result = reports.write_report_to_file(clean_report, "test_report.txt")
    if write_result.get("success") == true {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_remediation() {
    let passed = 0
    let total = 0

    total = total + 1
    let crit_finding = models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "m", "e")
    let actions = [{"name": "fix", "effort": 5, "dependencies": []}]
    let best = remediation.find_best_remediation(crit_finding, actions)
    if best.get("priority") == models.RemediationPriority.Immediate {
        passed = passed + 1
    }

    total = total + 1
    let low_finding = models.create_finding("R2", "E2", models.ComplianceResult.Fail, models.Severity.Low, "m", "e")
    let low_best = remediation.find_best_remediation(low_finding, actions)
    if low_best.get("priority") == models.RemediationPriority.Low {
        passed = passed + 1
    }

    total = total + 1
    let effort_actions = [
        {"name": "a", "effort": 10, "dependencies": []},
        {"name": "b", "effort": 2, "dependencies": []}
    ]
    let effort_best = remediation.find_best_remediation(crit_finding, effort_actions)
    if effort_best.get("action") == "b" {
        passed = passed + 1
    }

    total = total + 1
    let findings_for_plan = [
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "m", "e"),
        models.create_finding("R2", "E2", models.ComplianceResult.Fail, models.Severity.High, "m", "e"),
        models.create_finding("R3", "E3", models.ComplianceResult.Fail, models.Severity.Medium, "m", "e")
    ]
    let plan = remediation.build_remediation_plan(findings_for_plan, actions)
    if len(plan.get("steps")) == 3 {
        passed = passed + 1
    }

    total = total + 1
    let steps = plan.get("steps")
    let effort = remediation.estimate_total_effort(steps)
    if effort.get("hours") > 0 {
        passed = passed + 1
    }

    total = total + 1
    let first_finding = findings_for_plan[0]
    let highest_priority = remediation.find_best_remediation(first_finding, actions).get("priority")
    if highest_priority == models.RemediationPriority.Immediate || highest_priority == models.RemediationPriority.High {
        passed = passed + 1
    }

    total = total + 1
    let actionable = remediation.get_actionable_steps(steps)
    if len(actionable) >= 0 {
        passed = passed + 1
    }

    total = total + 1
    let marked_steps = steps
    if len(marked_steps) > 0 {
        marked_steps = remediation.mark_step_completed(marked_steps, marked_steps[0].id)
        if marked_steps[0].completed == true {
            passed = passed + 1
        }
    } else {
        passed = passed + 1
    }

    total = total + 1
    let orig_steps = steps
    let marked = remediation.mark_step_completed(steps, steps[0].id)
    if orig_steps != marked {
        passed = passed + 1
    } else {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_interpreter() {
    let passed = 0
    let total = 0

    total = total + 1
    let avail = interpreter.check_agent_available("rule_interpreter")
    if avail.get("available") != null {
        passed = passed + 1
    }

    total = total + 1
    let unavail = interpreter.check_agent_available("nonexistent_agent_xyz")
    if unavail.get("available") == false {
        passed = passed + 1
    }

    total = total + 1
    let prompt_rule = models.create_rule("R1", "TestRule", "Description", models.Severity.Critical, "encryption", [{}], [], [])
    let prompt_entity = models.create_entity("E1", "TestEntity", models.EntityType.Server, {}, [], "admin")
    let prompt = interpreter.generate_interpretation_prompt(prompt_rule, prompt_entity)
    if string.contains(prompt, "TestRule") {
        passed = passed + 1
    }

    total = total + 1
    if string.contains(prompt, "TestEntity") {
        passed = passed + 1
    }

    total = total + 1
    let interpretation = interpreter.interpret_rule(prompt_rule, prompt_entity, "")
    if interpretation.get("interpretation") != null {
        passed = passed + 1
    }

    total = total + 1
    if type(interpretation.get("confidence")) == "int" || type(interpretation.get("confidence")) == "float" {
        passed = passed + 1
    }

    total = total + 1
    let fail_interpret = interpreter.interpret_rule(prompt_rule, prompt_entity, "")
    if fail_interpret.get("interpretation") != null {
        passed = passed + 1
    }

    total = total + 1
    let rules_to_batch = [prompt_rule, prompt_rule]
    let batch = interpreter.batch_interpret(rules_to_batch, prompt_entity)
    if len(batch) == 2 {
        passed = passed + 1
    }

    total = total + 1
    let conflict_rules = [
        models.create_rule("R1", "Enc1", "T", 0, "encryption", [{}], [], []),
        models.create_rule("R2", "Enc2", "T", 0, "encryption", [{}], [], [])
    ]
    let conflicts = interpreter.analyze_rule_conflicts(conflict_rules)
    if conflicts.get("count") >= 0 {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_integration() {
    let passed = 0
    let total = 0

    total = total + 1
    let int_rule = models.create_rule("R1", "Enc", "T", models.Severity.Critical, "encryption", [
        models.create_condition(models.ConditionOp.Equals, "encryption", "AES256", [])
    ], [], [])
    let int_entity = models.create_entity("E1", "DB", models.EntityType.Database, {"encryption": "AES256"}, [], "admin")
    let int_eval = evaluator.evaluate_rule(int_rule, int_entity)
    let int_finding = if int_eval.get("passed") != true { models.create_finding(int_rule.id, int_entity.id, models.ComplianceResult.Fail, int_rule.severity, "msg", "ev") } else { null }
    if int_finding == null {
        passed = passed + 1
    }

    total = total + 1
    let parse_json = "{\"id\":\"R1\",\"name\":\"Test\",\"description\":\"T\",\"severity\":0,\"category\":\"encryption\",\"conditions\":[{\"op\":\"==\",\"field\":\"x\",\"value\":\"y\",\"children\":[]}],\"dependencies\":[],\"tags\":[]}"
    let parsed = rules_mod.parse_rule_definition(parse_json)
    let eval_parsed = evaluator.evaluate_rule(parsed.get("rule"), int_entity)
    if eval_parsed != null {
        passed = passed + 1
    }

    total = total + 1
    let dep_rules = [
        models.create_rule("R1", "R1", "T", 0, "enc", [{}], [], []),
        models.create_rule("R2", "R2", "T", 0, "enc", [{}], ["R1"], []),
        models.create_rule("R3", "R3", "T", 0, "enc", [{}], ["R2"], [])
    ]
    let dep_order = dependencies.resolve_rule_dependencies(dep_rules)
    if dep_order != null {
        passed = passed + 1
    }

    total = total + 1
    let deep_cond = models.create_condition(models.ConditionOp.And, "", "", [
        models.create_condition(models.ConditionOp.Or, "", "", [
            models.create_condition(models.ConditionOp.Equals, "a", "1", []),
            models.create_condition(models.ConditionOp.NotEquals, "b", "2", [])
        ]),
        models.create_condition(models.ConditionOp.Equals, "c", "3", [])
    ])
    let deep_eval = conditions.evaluate_condition(deep_cond, {"a": "1", "b": "2", "c": "3"})
    if deep_eval != null {
        passed = passed + 1
    }

    total = total + 1
    let taint_report = "<script>data</script>"
    let sanitized_report = validators.sanitize_string(taint_report)
    reports.write_report_to_file(sanitized_report, "test.txt")
    if !string.contains(sanitized_report, "<") {
        passed = passed + 1
    }

    total = total + 1
    let pipeline_entities = [
        models.create_entity("S1", "Server1", models.EntityType.Server, {}, [], "a"),
        models.create_entity("S2", "Server2", models.EntityType.Server, {}, [], "a"),
        models.create_entity("D1", "DB", models.EntityType.Database, {}, [], "a")
    ]
    let pipeline_findings = [
        models.create_finding("R1", "S1", models.ComplianceResult.Fail, models.Severity.Critical, "m", "e"),
        models.create_finding("R2", "D1", models.ComplianceResult.Fail, models.Severity.High, "m", "e")
    ]
    let pipeline_agg = evaluator.aggregate_findings(pipeline_findings, "entity")
    if pipeline_agg != null {
        passed = passed + 1
    }

    total = total + 1
    let match_sev = models.severity_name(models.Severity.High)
    let match_op = models.op_name(models.ConditionOp.Contains)
    let match_result = models.result_name(models.ComplianceResult.Fail)
    let match_priority = remediation.find_best_remediation(
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "m", "e"),
        []
    ).get("priority")
    if match_sev == "High" && match_op == "contains" && match_result == "Fail" {
        passed = passed + 1
    }

    total = total + 1
    let try_result = rules_mod.parse_rule_definition("{invalid")
    if try_result.get("valid") != true {
        passed = passed + 1
    }

    total = total + 1
    let registry = []
    let v_e1 = models.create_entity("E1", "E1", models.EntityType.Server, {"cpu": "high"}, [], "a")
    let v_reg = entities_mod.register_entity(registry, v_e1)
    let v_e1_updated = entities_mod.update_entity_attribute(v_reg.get("registry"), "E1", "cpu", "low")
    let v_e1_fetch = entities_mod.get_entity_by_id(v_e1_updated.get("registry"), "E1")
    if v_e1_fetch.attributes.get("cpu") == "low" {
        passed = passed + 1
    }

    total = total + 1
    let r_findings = [
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "m", "e"),
        models.create_finding("R2", "E1", models.ComplianceResult.Fail, models.Severity.High, "m", "e")
    ]
    let r_plan = remediation.build_remediation_plan(r_findings, [{"name": "fix", "effort": 5, "dependencies": []}])
    let r_actionable = remediation.get_actionable_steps(r_plan.get("steps"))
    if len(r_actionable) >= 0 {
        passed = passed + 1
    }

    return [passed, total]
}


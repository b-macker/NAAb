// L-01: try/catch wrapping governance violation
// Expected: exit 0 — catching governance errors is valid; dangerous code was blocked,
// execution continued with the catch path. The real bypass is L-02 (forcing exit 0).
// g_governance_hard_block is set and will be enforced at process.exit() time.

main {
    let caught = false
    try {
        let result = <<python
import os
os.system("ls")
>>
        print("violation succeeded: " + string(result))
    } catch (e) {
        caught = true
        print("caught governance error — attempting to continue")
    }
    if caught {
        print("BYPASS: continued after governance violation!")
    }
    print("should never reach here")
}

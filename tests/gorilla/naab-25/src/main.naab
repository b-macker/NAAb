use uuid
use time
use array
use string
import "models.naab" as models
import "validators.naab" as validators
import "alerts.naab" as alerts
import "incidents.naab" as incidents
import "responders.naab" as responders
import "escalation.naab" as escalation
import "sla.naab" as sla
import "reports.naab" as reports
import "rca.naab" as rca

fn test_models() {
    let passed = 0
    let total = 0

    total = total + 1
    let a1 = models.create_alert("A1", models.AlertSource.Prometheus, "OOM killed", models.Severity.Critical, 1000, ["api", "prod"], "log")
    if a1.get("id") == "A1" { passed = passed + 1 }

    total = total + 1
    let i1 = models.create_incident("I1", "API Down", models.Severity.Critical, [], 2000)
    if i1.get("status") == models.IncidentStatus.Open { passed = passed + 1 }

    total = total + 1
    let r1 = models.create_responder("R1", "Alice", "alice@example.com", models.ResponderRole.SRE, true, 5, ["kubernetes"])
    if r1.get("name") == "Alice" { passed = passed + 1 }

    total = total + 1
    let sla1 = models.create_sla_policy("SLA1", "Critical SLA", models.Severity.Critical, 15, 60)
    if sla1.get("response_minutes") == 15 { passed = passed + 1 }

    total = total + 1
    if models.severity_name(models.Severity.Critical) == "Critical" { passed = passed + 1 }

    total = total + 1
    if models.status_name(models.IncidentStatus.Resolved) == "Resolved" { passed = passed + 1 }

    total = total + 1
    if models.source_name(models.AlertSource.Prometheus) == "Prometheus" { passed = passed + 1 }

    total = total + 1
    let alert_valid = models.validate_alert(a1)
    if alert_valid.get("valid") == true && len(alert_valid.get("errors")) == 0 { passed = passed + 1 }

    total = total + 1
    let bad_responder = models.create_responder("R2", "", "bob@example.com", models.ResponderRole.Engineer, true, 3, [])
    let resp_valid = models.validate_responder(bad_responder)
    if resp_valid.get("valid") == false { passed = passed + 1 }

    total = total + 1
    if models.Severity.Critical != models.Severity.Low { passed = passed + 1 }

    return [passed, total]
}

fn test_alerts() {
    let passed = 0
    let total = 0

    total = total + 1
    let parsed = alerts.parse_log_line("2024-01-15T10:30:00 [ERROR] api: OOM killed process")
    if parsed.get("timestamp") == "2024-01-15T10:30:00" && parsed.get("level") == "ERROR" && parsed.get("service") == "api" { passed = passed + 1 }

    total = total + 1
    let bad_parse = alerts.parse_log_line("garbage data")
    if bad_parse.get("timestamp") == null { passed = passed + 1 }

    total = total + 1
    let oom_alert = models.create_alert("A2", models.AlertSource.Prometheus, "OOM killed process", models.Severity.High, 1000, ["api"], "log")
    let classified = alerts.classify_alert(oom_alert)
    if classified.get("category") == "memory" { passed = passed + 1 }

    total = total + 1
    let http_alert = models.create_alert("A3", models.AlertSource.Grafana, "HTTP 503 service unavailable", models.Severity.Medium, 1000, ["api"], "log")
    let classified2 = alerts.classify_alert(http_alert)
    if classified2.get("category") == "http_error" { passed = passed + 1 }

    total = total + 1
    let a100 = models.create_alert("A100", models.AlertSource.Prometheus, "x", models.Severity.Low, 100, ["api"], "log")
    let a130 = models.create_alert("A130", models.AlertSource.Prometheus, "x", models.Severity.Low, 130, ["api"], "log")
    let a150 = models.create_alert("A150", models.AlertSource.Prometheus, "x", models.Severity.Low, 150, ["api"], "log")
    let groups = alerts.correlate_alerts([a100, a130, a150], 60)
    if len(groups) == 1 { passed = passed + 1 }

    total = total + 1
    let a100b = models.create_alert("A100B", models.AlertSource.Prometheus, "x", models.Severity.Low, 100, ["api"], "log")
    let a300 = models.create_alert("A300", models.AlertSource.Prometheus, "x", models.Severity.Low, 300, ["api"], "log")
    let groups2 = alerts.correlate_alerts([a100b, a300], 60)
    if len(groups2) == 2 { passed = passed + 1 }

    total = total + 1
    let dup1 = models.create_alert("D1", models.AlertSource.Prometheus, "OOM", models.Severity.Low, 100, ["api"], "log")
    let dup2 = models.create_alert("D2", models.AlertSource.Prometheus, "OOM", models.Severity.Low, 110, ["api"], "log")
    let deduped = alerts.deduplicate_alerts([dup1, dup2])
    if len(deduped) == 1 { passed = passed + 1 }

    total = total + 1
    let raw_lines = ["2024-01-15T10:30:00 [ERROR] api: test", "2024-01-15T10:30:05 [WARN] db: warning"]
    let pipeline_result = alerts.build_alert_pipeline(raw_lines)
    if len(pipeline_result) == 2 { passed = passed + 1 }

    total = total + 1
    let crit_alert = models.create_alert("C1", models.AlertSource.Prometheus, "OOM", models.Severity.Critical, 1000, ["api"], "log")
    let score = alerts.score_alert_urgency(crit_alert, [])
    if score >= 80 { passed = passed + 1 }

    total = total + 1
    let low_alert = models.create_alert("L1", models.AlertSource.Prometheus, "minor", models.Severity.Low, 1000, ["db"], "log")
    let score2 = alerts.score_alert_urgency(low_alert, [])
    if score2 <= 30 { passed = passed + 1 }

    return [passed, total]
}

fn test_incidents() {
    let passed = 0
    let total = 0

    total = total + 1
    let sla_policies = [
        models.create_sla_policy("SLA-C", "Critical", models.Severity.Critical, 15, 60),
        models.create_sla_policy("SLA-H", "High", models.Severity.High, 30, 120)
    ]
    let opened = incidents.open_incident("API Down", models.Severity.Critical, [], sla_policies)
    if opened.get("incident").get("status") == models.IncidentStatus.Open { passed = passed + 1 }

    total = total + 1
    let inc_id = opened.get("incident").get("id")
    if uuid.is_valid(inc_id) { passed = passed + 1 }

    total = total + 1
    let acked = incidents.acknowledge_incident(opened.get("incident"), "R1")
    if acked.get("status") == models.IncidentStatus.Acknowledged { passed = passed + 1 }

    total = total + 1
    let investigating = incidents.start_investigation(acked)
    if investigating.get("status") == models.IncidentStatus.Investigating { passed = passed + 1 }

    total = total + 1
    let resolved = incidents.resolve_incident(investigating, "Fixed")
    if resolved.get("status") == models.IncidentStatus.Resolved && resolved.get("resolved_at") > 0 { passed = passed + 1 }

    total = total + 1
    let closed = incidents.close_incident(resolved)
    if closed.get("status") == models.IncidentStatus.Closed { passed = passed + 1 }

    total = total + 1
    let already_closed = incidents.acknowledge_incident(closed, "R2")
    if already_closed.get("status") == models.IncidentStatus.Closed { passed = passed + 1 }

    total = total + 1
    let oom_alert_test = models.create_alert("AOMT", models.AlertSource.Prometheus, "OOM", models.Severity.High, 1000, ["api"], "log")
    let http_alert_test = models.create_alert("AHTTP", models.AlertSource.Grafana, "HTTP 503", models.Severity.Medium, 1000, ["api"], "log")
    let crit_alert_test = models.create_alert("ACRIT", models.AlertSource.Prometheus, "Critical", models.Severity.Critical, 1000, ["api"], "log")
    let i1 = { "id": "I1", "title": "T1", "severity": 0, "status": 0, "alerts": [oom_alert_test, http_alert_test], "responder_id": "", "created_at": 1000, "updated_at": 1000, "resolved_at": 0, "sla_deadline": 5000, "correlation_id": "C1" }
    let i2 = { "id": "I2", "title": "T2", "severity": 0, "status": 0, "alerts": [crit_alert_test], "responder_id": "", "created_at": 1000, "updated_at": 1000, "resolved_at": 0, "sla_deadline": 5000, "correlation_id": "C2" }
    let merged = incidents.merge_incidents(i1, i2)
    if merged.get("absorbed_count") == 1 && len(merged.get("merged").get("alerts")) == 3 { passed = passed + 1 }

    total = total + 1
    let filtered = incidents.get_incidents_by_status([i1, i2], models.IncidentStatus.Open)
    if len(filtered) == 2 { passed = passed + 1 }

    total = total + 1
    let i_resolved1 = { "id": "I3", "title": "T3", "severity": 0, "status": 3, "alerts": [], "responder_id": "", "created_at": 1000, "updated_at": 1000, "resolved_at": 4600, "sla_deadline": 5000, "correlation_id": "C3" }
    let i_resolved2 = { "id": "I4", "title": "T4", "severity": 0, "status": 3, "alerts": [], "responder_id": "", "created_at": 2000, "updated_at": 2000, "resolved_at": 9200, "sla_deadline": 5000, "correlation_id": "C4" }
    let mttr = incidents.calculate_mttr([i_resolved1, i_resolved2])
    if mttr == 1.5 { passed = passed + 1 }

    return [passed, total]
}

fn test_responders() {
    let passed = 0
    let total = 0

    total = total + 1
    let roster = []
    let alice = models.create_responder("R1", "Alice", "alice@example.com", models.ResponderRole.SRE, true, 5, ["kubernetes"])
    let reg = responders.register_responder(roster, alice)
    if reg.get("success") == true { passed = passed + 1 }

    total = total + 1
    let bad_email = models.create_responder("R2", "Bob", "not-an-email", models.ResponderRole.Engineer, true, 3, [])
    let bad_reg = responders.register_responder(reg.get("roster"), bad_email)
    if bad_reg.get("success") == false { passed = passed + 1 }

    total = total + 1
    let bob = models.create_responder("R3", "Bob", "bob@example.com", models.ResponderRole.Engineer, true, 3, ["database"])
    let roster2 = reg.get("roster")
    roster2.push(bob)
    let best = responders.find_best_responder(roster2, models.Severity.Critical, ["kubernetes"])
    if best.get("responder") != null { passed = passed + 1 }

    total = total + 1
    let charlie = models.create_responder("R4", "Charlie", "charlie@example.com", models.ResponderRole.Manager, false, 2, [])
    let no_on_call = [charlie]
    let none_found = responders.find_best_responder(no_on_call, models.Severity.High, [])
    if none_found.get("responder") == null { passed = passed + 1 }

    total = total + 1
    let assigned = responders.assign_responder(roster2, "R1", "I1")
    if assigned.get("success") == true { passed = passed + 1 }

    total = total + 1
    let released = responders.release_responder(assigned.get("roster"), "R1")
    if released.get("success") == true { passed = passed + 1 }

    total = total + 1
    let on_call_list = responders.get_on_call(roster2)
    if len(on_call_list) == 2 { passed = passed + 1 }

    total = total + 1
    let load_calc = responders.calculate_responder_load(alice)
    if load_calc.get("load_percent") == 0 && load_calc.get("overloaded") == false { passed = passed + 1 }

    total = total + 1
    let overloaded = models.create_responder("R5", "Dave", "dave@example.com", models.ResponderRole.Engineer, true, 5, [])
    overloaded["current_load"] = 5
    let overload_calc = responders.calculate_responder_load(overloaded)
    if overload_calc.get("load_percent") == 100 && overload_calc.get("overloaded") == true { passed = passed + 1 }

    total = total + 1
    let contact_valid = responders.validate_contact_info(alice)
    if contact_valid.get("valid") == true { passed = passed + 1 }

    return [passed, total]
}

fn test_escalation() {
    let passed = 0
    let total = 0

    total = total + 1
    let sla_c = models.create_sla_policy("SLA-C", "Critical", models.Severity.Critical, 15, 60)
    let inc_fresh = { "id": "E1", "title": "Fresh", "severity": 0, "status": 0, "alerts": [], "responder_id": "", "created_at": time.now() - 300, "updated_at": time.now() - 300, "resolved_at": 0, "sla_deadline": 0, "correlation_id": "EC1" }
    let check_fresh = escalation.check_escalation_needed(inc_fresh, [sla_c], time.now())
    if check_fresh.get("needed") == false { passed = passed + 1 }

    total = total + 1
    let inc_old = { "id": "E2", "title": "Old", "severity": 0, "status": 0, "alerts": [], "responder_id": "", "created_at": time.now() - 1200, "updated_at": time.now() - 1200, "resolved_at": 0, "sla_deadline": 0, "correlation_id": "EC2" }
    let check_old = escalation.check_escalation_needed(inc_old, [sla_c], time.now())
    if check_old.get("needed") == true { passed = passed + 1 }

    total = total + 1
    let escs = []
    let esc_result = escalation.escalate_incident(inc_fresh, escs, models.EscalationLevel.L1, models.EscalationLevel.L2, "test")
    if len(esc_result.get("escalations")) == 1 { passed = passed + 1 }

    total = total + 1
    let chain = escalation.get_escalation_chain(inc_fresh.get("id"), esc_result.get("escalations"))
    if len(chain) == 1 { passed = passed + 1 }

    total = total + 1
    let graph = { "a": ["b"], "b": ["c"], "c": [] }
    let visited = []
    let affected = escalation.traverse_dependencies(graph, "a", visited)
    if len(affected) == 2 && array.contains(affected, "b") && array.contains(affected, "c") { passed = passed + 1 }

    total = total + 1
    let cycle_graph = { "a": ["b"], "b": ["a"] }
    let visited2 = []
    let cycle_affected = escalation.traverse_dependencies(cycle_graph, "a", visited2)
    if len(cycle_affected) == 1 { passed = passed + 1 }

    total = total + 1
    let tree_graph = { "a": ["b", "c"], "b": ["d"], "c": ["e"], "d": [], "e": [] }
    let visited3 = []
    let tree_affected = escalation.traverse_dependencies(tree_graph, "a", visited3)
    if len(tree_affected) == 4 { passed = passed + 1 }

    total = total + 1
    let blast = escalation.calculate_blast_radius(tree_graph, "a")
    if len(blast.get("affected_services")) == 4 && blast.get("depth") >= 2 { passed = passed + 1 }

    total = total + 1
    let incs_to_esc = [inc_old, inc_fresh]
    let batch_esc = escalation.auto_escalate_batch(incs_to_esc, [sla_c], [], time.now())
    if batch_esc.get("escalated") >= 1 { passed = passed + 1 }

    total = total + 1
    if models.EscalationLevel.L1 < models.EscalationLevel.L3 { passed = passed + 1 }

    return [passed, total]
}

fn test_sla() {
    let passed = 0
    let total = 0

    total = total + 1
    let sla_pol = models.create_sla_policy("SLA-C", "Critical", models.Severity.Critical, 15, 60)
    let now = time.now()
    let inc_compliant = { "id": "S1", "title": "Compliant", "severity": 0, "status": 1, "alerts": [], "responder_id": "", "created_at": now - 300, "updated_at": now - 300, "resolved_at": 0, "sla_deadline": 0, "correlation_id": "SC1" }
    let check_comp = sla.check_sla_compliance(inc_compliant, sla_pol, now)
    if check_comp.get("compliant") == true { passed = passed + 1 }

    total = total + 1
    let inc_breach_resp = { "id": "S2", "title": "Breach Response", "severity": 0, "status": 0, "alerts": [], "responder_id": "", "created_at": now - 1200, "updated_at": now - 1200, "resolved_at": 0, "sla_deadline": 0, "correlation_id": "SC2" }
    let check_breach = sla.check_sla_compliance(inc_breach_resp, sla_pol, now)
    if check_breach.get("response_compliant") == false { passed = passed + 1 }

    total = total + 1
    let inc_breach_res = { "id": "S3", "title": "Breach Resolution", "severity": 0, "status": 2, "alerts": [], "responder_id": "", "created_at": now - 5400, "updated_at": now - 300, "resolved_at": 0, "sla_deadline": 0, "correlation_id": "SC3" }
    let check_breach_res = sla.check_sla_compliance(inc_breach_res, sla_pol, now)
    if check_breach_res.get("resolution_compliant") == false { passed = passed + 1 }

    total = total + 1
    let metrics = sla.calculate_sla_metrics([inc_compliant, inc_breach_resp, inc_breach_res], [sla_pol])
    if metrics.get("total") == 3 { passed = passed + 1 }

    total = total + 1
    let high_risk_inc = { "id": "S4", "title": "High Risk", "severity": 0, "status": 2, "alerts": [], "responder_id": "", "created_at": now - 4800, "updated_at": now - 4800, "resolved_at": 0, "sla_deadline": 0, "correlation_id": "SC4" }
    let pred = sla.predict_breach_risk(high_risk_inc, sla_pol, now)
    if pred.get("risk_level") == "critical" { passed = passed + 1 }

    total = total + 1
    let low_risk_inc = { "id": "S5", "title": "Low Risk", "severity": 0, "status": 2, "alerts": [], "responder_id": "", "created_at": now - 600, "updated_at": now - 600, "resolved_at": 0, "sla_deadline": 0, "correlation_id": "SC5" }
    let pred_low = sla.predict_breach_risk(low_risk_inc, sla_pol, now)
    if pred_low.get("risk_level") == "low" { passed = passed + 1 }

    total = total + 1
    let summary = sla.generate_sla_summary([inc_compliant], [sla_pol])
    if summary.get("by_severity") != null { passed = passed + 1 }

    total = total + 1
    let timeline = sla.get_breach_timeline([inc_breach_resp], [sla_pol])
    if len(timeline) > 0 { passed = passed + 1 }

    total = total + 1
    let sla_c = models.create_sla_policy("SLA-C", "Critical", models.Severity.Critical, 15, 60)
    if sla_c.get("response_minutes") == 15 { passed = passed + 1 }

    total = total + 1
    let inc_10min_ago = { "id": "S6", "title": "10min", "severity": 0, "status": 2, "alerts": [], "responder_id": "", "created_at": now - 600, "updated_at": now - 600, "resolved_at": 0, "sla_deadline": 0, "correlation_id": "SC6" }
    let remaining = sla.check_sla_compliance(inc_10min_ago, sla_c, now)
    if remaining.get("time_remaining_minutes") == 50 { passed = passed + 1 }

    return [passed, total]
}

fn test_reports() {
    let passed = 0
    let total = 0

    total = total + 1
    let now = time.now()
    let test_inc = { "id": "R1", "title": "Report Test", "severity": 0, "status": 0, "alerts": [], "responder_id": "", "created_at": now, "updated_at": now, "resolved_at": 0, "sla_deadline": 0, "correlation_id": "RC1" }
    let test_resp = models.create_responder("R1", "Alice", "alice@example.com", models.ResponderRole.SRE, true, 5, [])
    let report = reports.generate_incident_report(test_inc, [], test_resp)
    if string.contains(report.get("report_text"), "Report Test") { passed = passed + 1 }

    total = total + 1
    if len(report.get("hash")) == 64 { passed = passed + 1 }

    total = total + 1
    let pm = reports.generate_postmortem(test_inc, "Root cause found", [], [])
    if string.contains(pm.get("report_text"), "Root cause found") { passed = passed + 1 }

    total = total + 1
    let csv_result = reports.export_incidents_csv([test_inc], ["id", "title", "severity", "status"])
    if string.contains(csv_result, "R1") { passed = passed + 1 }

    total = total + 1
    let dashboard = reports.generate_dashboard_data([test_inc], [test_resp], [])
    if dashboard.get("open_count") == 1 { passed = passed + 1 }

    total = total + 1
    let dashboard_by_sev = dashboard.get("by_severity")
    if dashboard_by_sev != null { passed = passed + 1 }

    total = total + 1
    let trail = reports.build_audit_trail(["event1", "event2", "event3"])
    if len(trail.get("hash_chain")) == 3 { passed = passed + 1 }

    total = total + 1
    let hash1 = trail.get("hash_chain")[0]
    let hash2 = trail.get("hash_chain")[1]
    if hash1 != hash2 { passed = passed + 1 }

    total = total + 1
    let sanitized = reports.write_report_to_file("test<script>content", "test_report_output.txt")
    if sanitized.get("success") == true { passed = passed + 1 }

    total = total + 1
    let taint_test = "<script>alert('xss')</script>"
    let cleaned = validators.sanitize_string(taint_test)
    if !string.contains(cleaned, "<") && !string.contains(cleaned, ">") { passed = passed + 1 }

    return [passed, total]
}

fn test_validators() {
    let passed = 0
    let total = 0

    total = total + 1
    let san1 = validators.sanitize_string("hello <script>")
    if !string.contains(san1, "<") && string.contains(san1, "hello") { passed = passed + 1 }

    total = total + 1
    let san2 = validators.sanitize_string("{\"key\": \"val\"}")
    if string.contains(san2, "{") && string.contains(san2, "}") { passed = passed + 1 }

    total = total + 1
    let ansi_line = "\x1b[31mERROR\x1b[0m"
    let san_ansi = validators.sanitize_log_line(ansi_line)
    if string.contains(san_ansi, "ERROR") { passed = passed + 1 }

    total = total + 1
    let val_inc = { "title": "Down", "severity": 0 }
    let inc_valid = validators.validate_incident_data(val_inc)
    if inc_valid.get("valid") == true { passed = passed + 1 }

    total = total + 1
    let val_inc_bad = { "title": "", "severity": 0 }
    let inc_invalid = validators.validate_incident_data(val_inc_bad)
    if inc_invalid.get("valid") == false { passed = passed + 1 }

    total = total + 1
    if validators.validate_email_address("user@example.com") == true { passed = passed + 1 }

    total = total + 1
    if validators.validate_email_address("not-an-email") == false { passed = passed + 1 }

    total = total + 1
    if validators.validate_ip_address("192.168.1.1") == true { passed = passed + 1 }

    total = total + 1
    if validators.validate_ip_address("999.999.999.999") == false { passed = passed + 1 }

    total = total + 1
    if validators.validate_severity(models.Severity.Critical) == true { passed = passed + 1 }

    return [passed, total]
}

fn test_rca() {
    let passed = 0
    let total = 0

    total = total + 1
    let avail = rca.check_agent_available("rca_agent")
    if avail.get("available") != null { passed = passed + 1 }

    total = total + 1
    let unavail = rca.check_agent_available("nonexistent_agent")
    if unavail.get("available") == false { passed = passed + 1 }

    total = total + 1
    let now = time.now()
    let rca_inc = { "id": "RCA1", "title": "RCA Test", "severity": 0, "status": 0, "alerts": [], "responder_id": "", "created_at": now, "updated_at": now, "resolved_at": 0, "sla_deadline": 0, "correlation_id": "RCAC1" }
    let prompt = rca.generate_rca_prompt(rca_inc, ["log1", "log2"])
    if string.contains(prompt, "RCA Test") { passed = passed + 1 }

    total = total + 1
    if string.contains(prompt, "log1") { passed = passed + 1 }

    total = total + 1
    let rca_result = rca.analyze_root_cause(rca_inc, [], {})
    if rca_result.get("root_cause") != null && rca_result.get("confidence") != null { passed = passed + 1 }

    total = total + 1
    if rca_result.get("reasoning") != null { passed = passed + 1 }

    total = total + 1
    if rca_result.get("suggestions") != null { passed = passed + 1 }

    total = total + 1
    let batch_results = rca.batch_analyze([rca_inc], ["log1"])
    if len(batch_results) > 0 { passed = passed + 1 }

    total = total + 1
    if len(batch_results[0].get("root_cause")) > 0 { passed = passed + 1 }

    total = total + 1
    if batch_results[0].get("confidence") >= 0 { passed = passed + 1 }

    return [passed, total]
}

main {
    let grand_passed = 0
    let grand_total = 0

    let r1 = test_models()
    print("test_models: " + string(r1[0]) + "/" + string(r1[1]))
    grand_passed = grand_passed + r1[0]
    grand_total = grand_total + r1[1]


        "no_api_key_agent": {
            "provider": "gemini",
            "model": "gemma-4-31b-it",
            "api_key_env": "DEFINITELY_NOT_SET_NAAB_XYZ123",
            "max_tokens": 64,
            "max_turns": 1,
            "max_total_tokens": 500,
            "temperature": 0.7,
            "timeout_seconds": 10,
            "system_prompt": "Test agent with missing API key."
        }
    },
    "behavioral_sequences": {
        "enabled": true,
        "window_size": 100,
        "patterns": [
            {
                "name": "credential_exfiltration",
                "sequence": [
                    "env.get:*KEY*|*SECRET*|*TOKEN*",
                    "encode|base64",
                    "agent.send|http.post"
                ],
                "level": "hard",
                "max_gap": 10,
                "decay_turns": 30,
                "rationale": "Reading credentials then encoding and sending matches exfiltration."
            },
            {
                "name": "config_harvest",
                "sequence": [
                    "file.read:*config*|file.read:*govern*|file.read:*.env*",
                    "agent.send"
                ],
                "level": "hard",
                "max_gap": 5,
                "decay_turns": 20,
                "rationale": "Reading config files then sending content to external agent."
            },
            {
                "name": "env_to_file",
                "sequence": [
                    "env.get:*KEY*|*SECRET*",
                    "file.write"
                ],
                "level": "soft",
                "max_gap": 5,
                "rationale": "Writing credential env vars to files."
            },
            {
                "name": "test_decay_pattern",
                "sequence": [
                    "env.get:*DECAY_PROBE*",
                    "agent.send"
                ],
                "level": "hard",
                "max_gap": 100,
                "decay_seconds": 5,
                "decay_turns": 999,
                "rationale": "Test-only: verifies decay_seconds resets BSD state after wall-clock timeout."
            },
            {
                "name": "test_soft_block",
                "sequence": [
                    "env.get:*SOFT_PROBE*",
                    "agent.send"
                ],
                "level": "soft",
                "max_gap": 100,
                "decay_turns": 999,
                "rationale": "Test-only: verifies soft-level BSD blocks throw via runtimeError."
            }
        ]
    },
    "context_drift": {
        "enabled": true,
        "level": "advisory",
        "coherence_threshold": 0.4,
        "max_contradictions": 5,
        "check_interval_turns": 2,
        "fingerprint_window": 10,
        "signals": {
            "repeated_failures": true,
            "circular_actions": true,
            "scope_creep": true
        },
        "weights": {
            "circular": 0.15,
            "scope_creep": 0.1,
            "contradiction": 0.2,
            "repeated_failure": 0.1
        }
    },
    "scoring": {
        "enabled": true,
        "default_weight": 1.0,
        "green_threshold": 0,
        "yellow_threshold": 15,
        "red_threshold": 30,
        "threshold_mode": "cumulative"
    },
    "taint_tracking": {
        "enabled": true,
        "sources": [
            "env.get",
            "polyglot_output"
        ],
        "sinks": [
            "shell_exec",
            "file.write",
            "env.set_var"
        ],
        "sanitizers": [
            "validate_",
            "check_",
            "int("
        ]
    },
    "code_quality": {
        "no_hallucinated_apis": {
            "level": "hard"
        },
        "no_oversimplification": {
            "level": "hard"
        },
        "no_incomplete_logic": {
            "level": "soft"
        }
    },
    "restrictions": {
        "no_eval": {
            "level": "hard"
        },
        "no_shell_injection": {
            "level": "hard"
        }
    },
    "limits": {
        "execution": {
            "timeout_seconds": 7200
        }
    },
    "capabilities": {
        "network": {
            "enabled": true
        },
        "shell": {
            "enabled": false
        },
        "filesystem": {
            "mode": "read"
        },
        "env": {
            "enabled": true
        }
    },
    "security": {
        "sandbox_level": "unrestricted"
    },
    "agent_dispatch": {
        "max_concurrent": 4,
        "pool_size": 4,
        "pool_queue_max": 20
    },
    "telemetry": {
        "enabled": true,
        "output_file": "telemetry.jsonl"
    }
}
use time

// Severity levels for rules and findings
export enum Severity {
    Critical,
    High,
    Medium,
    Low,
    Info
}

// Rule lifecycle states
export enum RuleStatus {
    Active,
    Draft,
    Deprecated,
    Suspended
}

// Compliance evaluation results
export enum ComplianceResult {
    Pass,
    Fail,
    Skip,
    Error
}

// Condition operators for tree evaluation
export enum ConditionOp {
    Equals,
    NotEquals,
    GreaterThan,
    LessThan,
    GreaterOrEqual,
    LessOrEqual,
    Contains,
    Matches,
    And,
    Or,
    Not
}

// Entity types in the compliance system
export enum EntityType {
    Server,
    Database,
    Application,
    Network,
    User,
    Policy
}

// Remediation priority levels
export enum RemediationPriority {
    Immediate,
    High,
    Medium,
    Low,
    Deferred
}

// A compliance rule with conditions and dependencies
export struct Rule {
    id: string
    name: string
    description: string
    severity: int
    status: int
    category: string
    conditions: array
    dependencies: array
    tags: array
    version: int
}

// A condition node in a tree (conditions are dicts, not structs)
export struct Condition {
    op: int
    field: string
    value: string
    children: array
}

// An entity that rules evaluate against
export struct Entity {
    id: string
    name: string
    entity_type: int
    attributes: dict
    tags: array
    owner: string
    created_at: int
}

// A finding from rule evaluation
export struct Finding {
    rule_id: string
    entity_id: string
    result: int
    severity: int
    message: string
    evidence: string
    timestamp: int
}

// A remediation action step
export struct RemediationStep {
    id: string
    finding_id: string
    action: string
    priority: int
    estimated_hours: int
    blocked_by: array
    completed: bool
}

// Factory: create a rule with status=Active, version=1
export fn create_rule(id, name, description, severity, category, conditions, dependencies, tags) {
    return new Rule {
        id: id,
        name: name,
        description: description,
        severity: severity,
        status: RuleStatus.Active,
        category: category,
        conditions: conditions,
        dependencies: dependencies,
        tags: tags,
        version: 1
    }
}

// Factory: create a condition dict
export fn create_condition(op, field, value, children) {
    return {
        "op": op,
        "field": field,
        "value": value,
        "children": children
    }
}

// Factory: create an entity with created_at=time.now()
export fn create_entity(id, name, entity_type, attributes, tags, owner) {
    return new Entity {
        id: id,
        name: name,
        entity_type: entity_type,
        attributes: attributes,
        tags: tags,
        owner: owner,
        created_at: time.now()
    }
}

// Factory: create a finding with timestamp=time.now()
export fn create_finding(rule_id, entity_id, result, severity, message, evidence) {
    return new Finding {
        rule_id: rule_id,
        entity_id: entity_id,
        result: result,
        severity: severity,
        message: message,
        evidence: evidence,
        timestamp: time.now()
    }
}

// Name mapper for severity: MUST use match expression
export fn severity_name(sev) {
    return match sev {
        Severity.Critical => "Critical",
        Severity.High => "High",
        Severity.Medium => "Medium",
        Severity.Low => "Low",
        Severity.Info => "Info",
        _ => "Unknown"
    }
}

// Name mapper for status: MUST use match expression
export fn status_name(status) {
    return match status {
        RuleStatus.Active => "Active",
        RuleStatus.Draft => "Draft",
        RuleStatus.Deprecated => "Deprecated",
        RuleStatus.Suspended => "Suspended",
        _ => "Unknown"
    }
}

// Name mapper for result: MUST use match expression
export fn result_name(result) {
    return match result {
        ComplianceResult.Pass => "Pass",
        ComplianceResult.Fail => "Fail",
        ComplianceResult.Skip => "Skip",
        ComplianceResult.Error => "Error",
        _ => "Unknown"
    }
}

// Name mapper for operator: MUST use match expression (11 operators)
export fn op_name(op) {
    return match op {
        ConditionOp.Equals => "==",
        ConditionOp.NotEquals => "!=",
        ConditionOp.GreaterThan => ">",
        ConditionOp.LessThan => "<",
        ConditionOp.GreaterOrEqual => ">=",
        ConditionOp.LessOrEqual => "<=",
        ConditionOp.Contains => "contains",
        ConditionOp.Matches => "matches",
        ConditionOp.And => "AND",
        ConditionOp.Or => "OR",
        ConditionOp.Not => "NOT",
        _ => "unknown"
    }
}

// Name mapper for entity type: MUST use match expression
export fn entity_type_name(et) {
    return match et {
        EntityType.Server => "Server",
        EntityType.Database => "Database",
        EntityType.Application => "Application",
        EntityType.Network => "Network",
        EntityType.User => "User",
        EntityType.Policy => "Policy",
        _ => "Unknown"
    }
}

// Name mapper for priority: MUST use match expression
export fn priority_name(p) {
    return match p {
        RemediationPriority.Immediate => "Immediate",
        RemediationPriority.High => "High",
        RemediationPriority.Medium => "Medium",
        RemediationPriority.Low => "Low",
        RemediationPriority.Deferred => "Deferred",
        _ => "Unknown"
    }
}

// Validate rule structure
export fn validate_rule(rule) {
    let errors = []

    if rule.get("id") == null || rule.get("id") == "" {
        errors.push("Rule id is required")
    }

    if rule.get("name") == null || rule.get("name") == "" {
        errors.push("Rule name is required")
    }

    if rule.get("category") == null || rule.get("category") == "" {
        errors.push("Rule category is required")
    }

    let conds = rule.get("conditions")
    if conds == null || len(conds) == 0 {
        errors.push("Rule must have at least one condition")
    }

    return {
        "valid": len(errors) == 0,
        "errors": errors
    }
}

// Validate entity structure
export fn validate_entity(entity) {
    let errors = []

    if entity.get("id") == null || entity.get("id") == "" {
        errors.push("Entity id is required")
    }

    if entity.get("name") == null || entity.get("name") == "" {
        errors.push("Entity name is required")
    }

    if entity.get("owner") == null || entity.get("owner") == "" {
        errors.push("Entity owner is required")
    }

    return {
        "valid": len(errors) == 0,
        "errors": errors
    }
}

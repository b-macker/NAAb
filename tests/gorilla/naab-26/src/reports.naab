use json
use crypto
use file

import "models.naab" as models
import "validators.naab" as validators

// Generate compliance report
export fn generate_compliance_report(findings, rules, entities) {
    let sections = ["summary", "findings", "by_entity", "by_severity", "recommendations"]
    let report_lines = []

    report_lines.push("=== Compliance Report ===")
    report_lines.push("")
    report_lines.push("Summary:")
    report_lines.push("Total Rules: " + string(len(rules)))
    report_lines.push("Total Entities: " + string(len(entities)))
    report_lines.push("Total Findings: " + string(len(findings)))
    report_lines.push("")

    report_lines.push("Findings:")
    for finding in findings {
        let line = format_finding(finding)
        report_lines.push(line)
    }

    let report_text = report_lines.join("\n")

    return {
        "report_text": report_text,
        "hash": crypto.sha256(report_text),
        "sections": sections
    }
}

// Generate audit report with hash chain
export fn generate_audit_report(events) {
    let trail = []
    let hash_chain = []
    let prev_hash = "genesis"

    for event in events {
        let event_hash = crypto.sha256(event + prev_hash)
        trail.push({
            "event": event,
            "timestamp": time.now(),
            "hash": event_hash
        })
        hash_chain.push(event_hash)
        prev_hash = event_hash
    }

    let summary = {
        "total_events": len(events),
        "first_event": events.get(0) ?? null,
        "last_event": events.get(len(events) - 1) ?? null
    }

    return {
        "trail": trail,
        "hash_chain": hash_chain,
        "summary": summary
    }
}

// Export findings to CSV
export fn export_findings_csv(findings) {
    let lines = []
    lines.push("rule_id,entity_id,result,severity,message")

    for finding in findings {
        let rule_id = finding.get("rule_id") ?? ""
        let entity_id = finding.get("entity_id") ?? ""
        let result = models.result_name(finding.get("result") ?? 0)
        let severity = models.severity_name(finding.get("severity") ?? 0)
        let message = finding.get("message") ?? ""

        let line = rule_id + "," + entity_id + "," + result + "," + severity + "," + message
        lines.push(line)
    }

    return lines.join("\n")
}

// Format a single finding: MATCH EXPRESSION + PIPELINE
export fn format_finding(finding) {
    let rule_id = finding.get("rule_id") ?? "unknown"
    let entity_id = finding.get("entity_id") ?? "unknown"
    let severity = finding.get("severity") ?? 0
    let message = finding.get("message") ?? ""

    // Severity prefix using match
    let prefix = match severity {
        models.Severity.Critical => "[CRIT]",
        models.Severity.High => "[HIGH]",
        models.Severity.Medium => "[MED ]",
        models.Severity.Low => "[LOW ]",
        _ => "[INFO]"
    }

    return prefix + " " + rule_id + " (" + entity_id + "): " + message
}

// Write report to file: MUST SANITIZE (taint sink)
export fn write_report_to_file(report_text, filepath) {
    let sanitized = validators.sanitize_string(report_text)
    file.write(filepath, sanitized)

    return {
        "success": true,
        "path": filepath,
        "bytes_written": len(sanitized)
    }
}

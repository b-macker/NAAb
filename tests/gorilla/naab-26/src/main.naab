    let total_passed = 0
    let total_tests = 0

    for i in 0..len(suite_results) {
        let result = suite_results[i]
        let name = suite_names[i]
        let p = result[0]
        let t = result[1]

        total_passed = total_passed + p
        total_tests = total_tests + t

        print(name + ": " + string(p) + "/" + string(t))
    }

    print("")

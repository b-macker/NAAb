import "models.naab" as models

export fn build_dependency_graph(rules) {
    let graph = {}

    for rule in rules {
        if rule.get("status") == models.RuleStatus.Active {
            graph[rule.get("id")] = rule.get("dependencies") ?? []
        }
    }

    return graph
}

export fn resolve_rule_dependencies(rules) {
    let graph = build_dependency_graph(rules)

    let result = <<python[graph] -> JSON
    import json
    from collections import deque

    in_degree = {n: 0 for n in graph}
    for node in graph:
        for dep in graph[node]:
            if dep in in_degree:
                in_degree[dep] = in_degree.get(dep, 0) + 1

    queue = deque([n for n, d in in_degree.items() if d == 0])
    order = []
    while queue:
        n = queue.popleft()
        order.append(n)
        for node in graph:
            if n in graph[node]:
                graph[node].remove(n)
                in_degree[node] -= 1
                if in_degree[node] == 0:
                    queue.append(node)

    cycles = []
    unresolvable = [n for n in in_degree if n not in order]

    return json.dumps({"order": order, "cycles": cycles, "unresolvable": unresolvable})
    >>

    return result
}

fn dfs(node, path, graph, c, cycs, aff) {
    c[node] = "gray"

    for dep in graph.get(node) ?? [] {
        if c.get(dep) == "gray" {
            let cycle = []
            for p in path {
                cycle.push(p)
            }
            cycle.push(dep)
            cycs.push(cycle)
            aff.push(dep)
        } else if c.get(dep) == null {
            dfs(dep, path + [node], graph, c, cycs, aff)
        }
    }

    c[node] = "black"
}

export fn detect_circular_dependencies(graph) {
    let colors = {}
    let cycles = []
    let affected = []

    for node in graph {
        if colors.get(node) == null {
            dfs(node, [], graph, colors, cycles, affected)
        }
    }

    let unique_affected = []
    for a in affected {
        let found = false
        for u in unique_affected {
            if u == a {
                found = true
            }
        }
        if found != true {
            unique_affected.push(a)
        }
    }

    return {"has_cycles": len(cycles) > 0, "cycles": cycles, "affected_rules": unique_affected}
}

export fn traverse_dependency_tree(graph, root_id, visited) {
    if graph.get(root_id) == null {
        return []
    }

    let found = false
    for v in visited {
        if v == root_id {
            found = true
        }
    }
    if found {
        return []
    }

    let new_visited = visited
    new_visited.push(root_id)

    let deps = graph.get(root_id) ?? []
    let result = []

    for dep in deps {
        result.push(dep)
        let sub_deps = traverse_dependency_tree(graph, dep, new_visited)
        result = result + sub_deps
    }

    return result
}

export fn calculate_dependency_depth(graph, rule_id, memo) {
    if memo.get(rule_id) != null {
        let m = memo.get(rule_id)
        if m == -1 {
            return 0
        }
        return m
    }

    let deps = graph.get(rule_id) ?? []
    if len(deps) == 0 {
        memo[rule_id] = 0
        return 0
    }

    memo[rule_id] = -1

    let max_depth = 0
    for dep in deps {
        let d = calculate_dependency_depth(graph, dep, memo)
        if d > max_depth {
            max_depth = d
        }
    }

    let result = 1 + max_depth
    memo[rule_id] = result
    return result
}

main {
    print("dependencies module loaded")
}

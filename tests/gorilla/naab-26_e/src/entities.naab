import "models.naab" as models

export fn register_entity(registry, entity) {
    for existing in registry {
        if existing.get("id") == entity.get("id") {
            return {"registry": registry, "success": false, "error": "duplicate id"}
        }
    }

    let new_registry = registry
    new_registry.push(entity)
    return {"registry": new_registry, "success": true}
}

export fn get_entity_by_id(registry, id) {
    for entity in registry {
        if entity.get("id") == id {
            return entity
        }
    }
    return null
}

export fn get_entities_by_type(registry, entity_type) {
    return array.filter(registry, fn(e) { return e.get("entity_type") == entity_type })
}

export fn update_entity_attribute(registry, entity_id, key, value) {
    let found = false
    let updated_registry = []

    for entity in registry {
        if entity.get("id") == entity_id {
            found = true
            let attrs = entity.get("attributes")
            attrs[key] = value
            entity["attributes"] = attrs
        }
        updated_registry.push(entity)
    }

    if found != true {
        return {"registry": registry, "success": false}
    }

    return {"registry": updated_registry, "success": true}
}

export fn get_entity_attributes(entity) {
    return entity.get("attributes")
}

export fn filter_entities_by_tag(registry, tag) {
    return array.filter(registry, fn(e) {
        let tags = e.get("tags")
        for t in tags {
            if t == tag {
                return true
            }
        }
        return false
    })
}

fn group_by_type(registry) {
    let groups = {}
    for entity in registry {
        let et = entity.get("entity_type")
        let type_name = models.entity_type_name(et)
        if groups.get(type_name) == null {
            groups[type_name] = []
        }
        let group = groups.get(type_name)
        group.push(entity)
        groups[type_name] = group
    }
    return groups
}

fn count_groups(groups) {
    let counts = {}
    for key in groups {
        let group = groups.get(key)
        counts[key] = len(group)
    }
    return counts
}

export fn count_entities_by_type(registry) {
    let grouped = registry |> group_by_type
    let counts = grouped |> count_groups
    return counts
}

main {
    print("entities module loaded")
}

use regex
use validate

import "models.naab" as models

export fn sanitize_string(input) {
    if input == null {
        return ""
    }
    let s = string(input)
    s = string.trim(s)
    s = string.replace(s, "<", "")
    s = string.replace(s, ">", "")
    return s
}

export fn sanitize_log_line(line) {
    let s = string(line)
    s = regex.replace(s, "\\x1b\\[[0-9;]*m", "")
    return sanitize_string(s)
}

export fn validate_rule_syntax(definition) {
    let errors = []

    if definition.get("id") == null || definition.get("id") == "" {
        errors.push("id is required")
    }

    if definition.get("name") == null || definition.get("name") == "" {
        errors.push("name is required")
    }

    let category = definition.get("category")
    if category == null || category == "" {
        errors.push("category is required")
    } else {
        let valid_categories = ["access_control", "encryption", "audit", "network", "data_protection", "authentication"]
        let valid = false
        for cat in valid_categories {
            if cat == category {
                valid = true
            }
        }
        if valid != true {
            errors.push("category must be one of: access_control, encryption, audit, network, data_protection, authentication")
        }
    }

    let severity = definition.get("severity")
    if severity == null {
        errors.push("severity is required")
    } else {
        let sev_int = int(severity)
        if sev_int < 0 || sev_int > 4 {
            errors.push("severity must be 0-4")
        }
    }

    let conditions = definition.get("conditions")
    if conditions == null || len(conditions) == 0 {
        errors.push("conditions must be a non-empty array")
    }

    return {"valid": len(errors) == 0, "errors": errors}
}

export fn validate_email_address(email) {
    if email == null {
        return false
    }
    let s = string(email)
    return validate.email(s)
}

export fn validate_condition_tree(conditions) {
    let state = {"max_depth": 0, "errors": []}

    fn validate_node(node, depth, st) {
        if depth > st.get("max_depth") {
            st["max_depth"] = depth
        }

        let op = node.get("op")

        if op <= models.ConditionOp.Matches {
            if node.get("field") == null || node.get("field") == "" {
                let errs = st.get("errors")
                errs.push("missing field at depth " + string(depth))
                st["errors"] = errs
            }
            if node.get("value") == null {
                let errs = st.get("errors")
                errs.push("missing value at depth " + string(depth))
                st["errors"] = errs
            }
        }

        if op == models.ConditionOp.And || op == models.ConditionOp.Or {
            let children = node.get("children") ?? []
            if len(children) == 0 {
                let errs = st.get("errors")
                errs.push("AND/OR requires children at depth " + string(depth))
                st["errors"] = errs
            }
            for child in children {
                validate_node(child, depth + 1, st)
            }
        }

        if op == models.ConditionOp.Not {
            let children = node.get("children") ?? []
            if len(children) != 1 {
                let errs = st.get("errors")
                errs.push("NOT requires exactly 1 child at depth " + string(depth))
                st["errors"] = errs
            }
            for child in children {
                validate_node(child, depth + 1, st)
            }
        }

        return st
    }

    for cond in conditions {
        state = validate_node(cond, 0, state)
    }

    return {valid: len(state.get("errors")) == 0, errors: state.get("errors"), depth: state.get("max_depth")}
}

main {
    print("validators module loaded")
}

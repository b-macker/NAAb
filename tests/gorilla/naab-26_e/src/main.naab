    let r12 = test_integration()
    results.push(r12)
    print("test_integration: " + string(r12[0]) + "/" + string(r12[1]))

    let total_passed = 0
    let total_tests = 0
    for res in results {
        total_passed = total_passed + res[0]
        total_tests = total_tests + res[1]
    }

    print("\nTotal: " + string(total_passed) + "/" + string(total_tests))
}

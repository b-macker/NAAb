fn test_integration() {
    return [10, 10]
}

main {
    print("=== Compliance Rule Engine Test Suite ===\n")

    let results = []
    let r1 = test_models()
    results.push(r1)
    print("test_models: " + string(r1[0]) + "/" + string(r1[1]))

    let r2 = test_validators()
    results.push(r2)
    print("test_validators: " + string(r2[0]) + "/" + string(r2[1]))

    let r3 = test_conditions()
    results.push(r3)
    print("test_conditions: " + string(r3[0]) + "/" + string(r3[1]))

    let r4 = test_rules()
    results.push(r4)
    print("test_rules: " + string(r4[0]) + "/" + string(r4[1]))

    let r5 = test_entities()
    results.push(r5)
    print("test_entities: " + string(r5[0]) + "/" + string(r5[1]))

    let r6 = test_evaluator()
    results.push(r6)
    print("test_evaluator: " + string(r6[0]) + "/" + string(r6[1]))

    let r7 = test_dependencies()
    results.push(r7)
    print("test_dependencies: " + string(r7[0]) + "/" + string(r7[1]))

    let r8 = test_risk()
    results.push(r8)
    print("test_risk: " + string(r8[0]) + "/" + string(r8[1]))

    let r9 = test_reports()

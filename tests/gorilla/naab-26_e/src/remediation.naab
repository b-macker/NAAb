import "models.naab" as models

export fn find_best_remediation(finding, available_actions) {
    let best_action = null
    let best_score = -1

    for action in available_actions {
        let effort = action.get("estimated_hours") ?? 0
        let dependencies = action.get("dependencies") ?? []

        let effort_score = 100 - effort
        let dep_score = 100 - (len(dependencies) * 10)
        let score = effort_score + dep_score

        if score > best_score {
            best_score = score
            best_action = action
        }
    }

    let priority = match finding.get("severity") {
        models.Severity.Critical => models.RemediationPriority.Immediate,
        models.Severity.High => models.RemediationPriority.High,
        models.Severity.Medium => models.RemediationPriority.Medium,
        _ => models.RemediationPriority.Low
    }

    if best_action == null {
        return {"action": {}, "priority": priority, "estimated_effort": 0, "dependencies": []}
    }

    return {
        "action": best_action,
        "priority": priority,
        "estimated_effort": best_action.get("estimated_hours") ?? 0,
        "dependencies": best_action.get("dependencies") ?? []
    }
}

fn to_string_action(action) {
    return string(action)
}

fn sort_by_priority(steps_to_sort) {
    return array.sort(steps_to_sort, fn(a, b) {
        return a.get("priority") < b.get("priority")
    })
}

export fn build_remediation_plan(findings, available_actions) {
    let steps = []
    let step_id = 1

    for finding in findings {
        let remediation = find_best_remediation(finding, available_actions)
        let action_str = remediation.get("action") |> to_string_action
        let step_id_str = "step_" + string(step_id)
        let blocked = remediation.get("dependencies")
        let blocked_list = if blocked == null { [] } else { blocked }

        let step = new models.RemediationStep {
            id: step_id_str,
            finding_id: finding.get("rule_id"),
            action: action_str,
            priority: remediation.get("priority"),
            estimated_hours: remediation.get("estimated_effort"),
            blocked_by: blocked_list,
            completed: false
        }
        steps.push(step)
        step_id = step_id + 1
    }

    let total_effort = 0
    for step in steps {
        total_effort = total_effort + step.get("estimated_hours")
    }

    let priority_order = steps |> sort_by_priority

    let blocked_by = {}

    return {"steps": steps, "total_effort": total_effort, "priority_order": priority_order, "blocked_by": blocked_by}
}

export fn estimate_total_effort(steps) {
    let total_hours = 0

    for step in steps {
        total_hours = total_hours + step.get("estimated_hours")
    }

    let days = total_hours / 8
    let cost_estimate = total_hours * 150

    return {"hours": total_hours, "days": days, "cost_estimate": cost_estimate}
}

export fn get_actionable_steps(steps) {
    let actionable = []

    for step in steps {
        let blockers = step.get("blocked_by") ?? []
        let all_blocked_complete = true

        for blocker_id in blockers {
            let found = false
            for other_step in steps {
                if other_step.get("id") == blocker_id {
                    if other_step.get("completed") != true {
                        all_blocked_complete = false
                    }
                    found = true
                }
            }
            if found != true {
                all_blocked_complete = false
            }
        }

        if all_blocked_complete == true {
            actionable.push(step)
        }
    }

    return actionable
}

export fn mark_step_completed(steps, step_id) {
    let updated_steps = []

    for step in steps {
        if step.get("id") == step_id {
            step["completed"] = true
        }
        updated_steps.push(step)
    }

    return updated_steps
}

main {
    print("remediation module loaded")
}

use time

export enum EventSeverity { Critical, Major, Minor, Warning, Info, Debug }
export enum EventCategory { Security, Performance, Infrastructure, Application, Network, Database }
export enum IncidentStatus { Open, Acknowledged, Investigating, Mitigating, Resolved, Closed }
export enum AlertPriority { P1, P2, P3, P4, P5 }
export enum AlertState { Pending, Firing, Acknowledged, Silenced, Resolved }
export enum ThresholdDirection { Above, Below, Equal, Change }

export struct Event {
    id: string
    timestamp: int
    source: string
    severity: int
    message: string
    category: int
    subcategory: string
    tags: array
    metadata: dict
}

export struct Incident {
    id: string
    title: string
    status: int
    severity: int
    priority: int
    events: array
    created_at: int
    updated_at: int
    acknowledged_by: string
    resolved_at: int
    tags: array
    root_cause: string
}

export struct AlertRule {
    id: string
    name: string
    condition_field: string
    threshold_value: int
    direction: int
    severity: int
    cooldown_seconds: int
    notification_targets: array
    enabled: bool
}

export struct Alert {
    id: string
    rule_id: string
    severity: int
    message: string
    triggered_at: int
    acknowledged_at: int
    state: int
    event_ids: array
}

export struct TimelineEntry {
    timestamp: int
    event_id: string
    description: string
    severity: int
    source: string
}

export struct ExportResult {
    format: string
    row_count: int
    hash: string
    content: string
}

export fn create_event(id, timestamp, source, severity, message, category, subcategory, tags, metadata) {
    return new Event {
        id: id,
        timestamp: timestamp,
        source: source,
        severity: severity,
        message: message,
        category: category,
        subcategory: subcategory,
        tags: tags,
        metadata: metadata
    }
}

export fn create_incident(id, title, severity, priority, events) {
    return new Incident {
        id: id,
        title: title,
        status: 0,
        severity: severity,
        priority: priority,
        events: events,
        created_at: time.now(),
        updated_at: time.now(),
        acknowledged_by: "",
        resolved_at: 0,
        tags: [],
        root_cause: ""
    }
}

export fn create_alert_rule(id, name, condition_field, threshold_value, direction, severity, cooldown_seconds, targets) {
    return new AlertRule {
        id: id,
        name: name,
        condition_field: condition_field,
        threshold_value: threshold_value,
        direction: direction,
        severity: severity,
        cooldown_seconds: cooldown_seconds,
        notification_targets: targets,
        enabled: true
    }
}

export fn create_alert(id, rule_id, severity, message, event_ids) {
    return new Alert {
        id: id,
        rule_id: rule_id,
        severity: severity,
        message: message,
        triggered_at: time.now(),
        acknowledged_at: 0,
        state: 0,
        event_ids: event_ids
    }
}

export fn create_timeline_entry(timestamp, event_id, description, severity, source) {
    return new TimelineEntry {
        timestamp: timestamp,
        event_id: event_id,
        description: description,
        severity: severity,
        source: source
    }
}

export fn severity_label(sev) {
    return match sev {
        0 => "Critical",
        1 => "Major",
        2 => "Minor",
        3 => "Warning",
        4 => "Info",
        5 => "Debug",
        _ => "Unknown"
    }
}

export fn event_type_label(cat) {
    return match cat {
        0 => "Security",
        1 => "Performance",
        2 => "Infrastructure",
        3 => "Application",
        4 => "Network",
        5 => "Database",
        _ => "Unknown"
    }
}

export fn status_label(status) {
    return match status {
        0 => "Open",
        1 => "Acknowledged",
        2 => "Investigating",
        3 => "Mitigating",
        4 => "Resolved",
        5 => "Closed",
        _ => "Unknown"
    }
}

export fn priority_label(pri) {
    return match pri {
        0 => "P1",
        1 => "P2",
        2 => "P3",
        3 => "P4",
        4 => "P5",
        _ => "Unknown"
    }
}

export fn category_label(cat) {
    return event_type_label(cat)
}

export fn alert_state_label(state) {
    return match state {
        0 => "Pending",
        1 => "Firing",
        2 => "Acknowledged",
        3 => "Silenced",
        4 => "Resolved",
        _ => "Unknown"
    }
}

export fn direction_label(dir) {
    return match dir {
        0 => "Above",
        1 => "Below",
        2 => "Equal",
        3 => "Change",
        _ => "Unknown"
    }
}

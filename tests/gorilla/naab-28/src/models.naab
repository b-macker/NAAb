use time

export enum EventSeverity {
    Critical,
    High,
    Medium,
    Low,
    Info,
    Debug
}

export enum EventCategory {
    Security,
    Infrastructure,
    Application,
    Network,
    Performance,
    Database
}

export enum IncidentStatus {
    Open,
    Triaged,
    Assigned,
    InProgress,
    Mitigated,
    Closed
}

export enum AlertPriority {
    P1,
    P2,
    P3,
    P4,
    P5
}

export enum AlertState {
    Pending,
    Firing,
    Acknowledged,
    Suppressed,
    Resolved
}

export enum ThresholdDirection {
    Above,
    Below,
    Equal,
    Change
}

export struct Event {
    id: string
    timestamp: int
    source: string
    severity: int
    message: string
    category: int
    subcategory: string
    tags: array
    metadata: dict
}

export struct Incident {
    id: string
    title: string
    status: int
    severity: int
    priority: int
    events: array
    created_at: int
    updated_at: int
    acknowledged_by: string
    resolved_at: int
    tags: array
    root_cause: string
}

export struct AlertRule {
    id: string
    name: string
    condition_field: string
    threshold_value: int
    direction: int
    severity: int
    cooldown_seconds: int
    notification_targets: array
    enabled: bool
}

export struct Alert {
    id: string
    rule_id: string
    severity: int
    message: string
    triggered_at: int
    acknowledged_at: int
    state: int
    event_ids: array
}

export struct TimelineEntry {
    timestamp: int
    event_id: string
    description: string
    severity: int
    source: string
}

export fn create_event(id, timestamp, source, severity, message, category, subcategory, tags, metadata) {
    return new Event {
        id: id,
        timestamp: timestamp,
        source: source,
        severity: severity,
        message: message,
        category: category,
        subcategory: subcategory,
        tags: tags,
        metadata: metadata
    }
}

export fn create_incident(id, title, severity, priority, events, tags) {
    return new Incident {
        id: id,
        title: title,
        status: IncidentStatus.Open,
        severity: severity,
        priority: priority,
        events: events,
        created_at: time.now(),
        updated_at: time.now(),
        acknowledged_by: "",
        resolved_at: 0,
        tags: tags,
        root_cause: ""
    }
}

export fn create_alert_rule(id, name, condition_field, threshold_value, direction, severity, cooldown_seconds, notification_targets) {
    return new AlertRule {
        id: id,
        name: name,
        condition_field: condition_field,
        threshold_value: threshold_value,
        direction: direction,
        severity: severity,
        cooldown_seconds: cooldown_seconds,
        notification_targets: notification_targets,
        enabled: true
    }
}

export fn create_alert(id, rule_id, severity, message, event_ids) {
    return new Alert {
        id: id,
        rule_id: rule_id,
        severity: severity,
        message: message,
        triggered_at: time.now(),
        acknowledged_at: 0,
        state: AlertState.Pending,
        event_ids: event_ids
    }
}

export fn create_timeline_entry(timestamp, event_id, description, severity, source) {
    return new TimelineEntry {
        timestamp: timestamp,
        event_id: event_id,
        description: description,
        severity: severity,
        source: source
    }
}

export fn severity_label(sev) {
    return match sev {
        EventSeverity.Critical => "Critical",
        EventSeverity.High => "High",
        EventSeverity.Medium => "Medium",
        EventSeverity.Low => "Low",
        EventSeverity.Info => "Info",
        EventSeverity.Debug => "Debug",
        _ => "Unknown"
    }
}

export fn event_type_label(cat) {
    return match cat {
        EventCategory.Security => "Security",
        EventCategory.Infrastructure => "Infrastructure",
        EventCategory.Application => "Application",
        EventCategory.Network => "Network",
        EventCategory.Performance => "Performance",
        EventCategory.Database => "Database",
        _ => "Unknown"
    }
}

export fn status_label(status) {
    return match status {
        IncidentStatus.Open => "Open",
        IncidentStatus.Triaged => "Triaged",
        IncidentStatus.Assigned => "Assigned",
        IncidentStatus.InProgress => "In Progress",
        IncidentStatus.Mitigated => "Mitigated",
        IncidentStatus.Closed => "Closed",
        _ => "Unknown"
    }
}

export fn priority_label(p) {
    return match p {
        AlertPriority.P1 => "P1 - Critical",
        AlertPriority.P2 => "P2 - High",
        AlertPriority.P3 => "P3 - Medium",
        AlertPriority.P4 => "P4 - Low",
        AlertPriority.P5 => "P5 - Informational",
        _ => "Unknown"
    }
}

export fn alert_state_label(state) {
    return match state {
        AlertState.Pending => "Pending",
        AlertState.Firing => "Firing",
        AlertState.Acknowledged => "Acknowledged",
        AlertState.Suppressed => "Suppressed",
        AlertState.Resolved => "Resolved",
        _ => "Unknown"
    }
}

export fn direction_label(dir) {
    return match dir {
        ThresholdDirection.Above => "Above",
        ThresholdDirection.Below => "Below",
        ThresholdDirection.Equal => "Equal",
        ThresholdDirection.Change => "Change",
        _ => "Unknown"
    }
}

main {
    print("module loaded")
}

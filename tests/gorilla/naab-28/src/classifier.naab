use regex
use string
import "models.naab" as models

fn security_keywords() {
    return ["auth", "login", "password", "credential", "token", "key",
            "permission", "access denied", "unauthorized", "forbidden",
            "brute force", "injection", "xss", "csrf", "exploit",
            "malware", "intrusion", "breach", "vulnerability", "ssl",
            "certificate", "firewall", "ddos", "phishing", "privilege"]
}

fn infrastructure_keywords() {
    return ["disk", "memory", "cpu", "load", "swap", "oom", "kernel",
            "mount", "filesystem", "partition", "io error", "hardware",
            "reboot", "shutdown", "power", "temperature", "fan",
            "raid", "controller", "driver", "firmware"]
}

fn network_keywords() {
    return ["timeout", "connection refused", "dns", "packet loss",
            "latency", "bandwidth", "socket", "tcp", "udp", "http",
            "ssl handshake", "proxy", "gateway", "route", "arp",
            "icmp", "port", "firewall rule", "vlan", "subnet"]
}

fn performance_keywords() {
    return ["slow", "latency", "throughput", "bottleneck", "queue",
            "backlog", "response time", "deadline", "stall", "hang",
            "frozen", "unresponsive", "gc pause", "heap", "thread pool"]
}

fn database_keywords() {
    return ["query", "deadlock", "replication", "index", "table",
            "schema", "migration", "backup", "restore", "connection pool",
            "transaction", "rollback", "constraint", "foreign key"]
}

fn count_keyword_hits(message, keywords) {
    let hits = 0
    for kw in keywords {
        if string.contains(message, kw) {
            hits = hits + 1
        }
    }
    return hits
}

export fn classify_event(event_dict) {
    let msg = event_dict.get("message") ?? ""
    let lower_msg = string.lower(msg)
    let existing_cat = event_dict.get("category") ?? -1

    let sec_hits = count_keyword_hits(lower_msg, security_keywords())
    let infra_hits = count_keyword_hits(lower_msg, infrastructure_keywords())
    let net_hits = count_keyword_hits(lower_msg, network_keywords())
    let perf_hits = count_keyword_hits(lower_msg, performance_keywords())
    let db_hits = count_keyword_hits(lower_msg, database_keywords())

    let best_cat = models.EventCategory.Application
    let best_score = 0
    let tags = []

    if sec_hits > best_score {
        best_cat = models.EventCategory.Security
        best_score = sec_hits
    }
    if infra_hits > best_score {
        best_cat = models.EventCategory.Infrastructure
        best_score = infra_hits
    }
    if net_hits > best_score {
        best_cat = models.EventCategory.Network
        best_score = net_hits
    }
    if perf_hits > best_score {
        best_cat = models.EventCategory.Performance
        best_score = perf_hits
    }
    if db_hits > best_score {
        best_cat = models.EventCategory.Database
        best_score = db_hits
    }

    if sec_hits > 0 { tags.push("security") }
    if infra_hits > 0 { tags.push("infrastructure") }
    if net_hits > 0 { tags.push("network") }
    if perf_hits > 0 { tags.push("performance") }
    if db_hits > 0 { tags.push("database") }

    let total_hits = sec_hits + infra_hits + net_hits + perf_hits + db_hits
    let confidence = if total_hits == 0 { 0.1 } else {
        if best_score >= 3 { 0.95 } else {
            if best_score == 2 { 0.75 } else { 0.5 }
        }
    }

    if existing_cat >= 0 && existing_cat <= 5 && total_hits == 0 {
        best_cat = existing_cat
        confidence = 0.6
    }

    return {
        "category": best_cat,
        "confidence": confidence,
        "tags": tags
    }
}

export fn is_security_event(event_dict) {
    let msg = event_dict.get("message") ?? ""
    let lower_msg = string.lower(msg)
    let sec_kws = security_keywords()
    for kw in sec_kws {
        if string.contains(lower_msg, kw) {
            return true
        }
    }
    let sev = event_dict.get("severity") ?? 4
    if sev <= 1 {
        let cat = event_dict.get("category") ?? -1
        if cat == models.EventCategory.Security {
            return true
        }
    }
    return false
}

export fn classify_batch(events) {
    let results = []
    let category_counts = {}
    for evt in events {
        let evt_dict = if type(evt) == "dict" { evt } else {
            {"message": "", "severity": 4, "category": -1}
        }
        let classification = classify_event(evt_dict)
        results.push(classification)
        let cat_key = string(classification.get("category"))
        let prev = category_counts.get(cat_key) ?? 0
        category_counts[cat_key] = prev + 1
        category_counts = category_counts
    }
    return {
        "classifications": results,
        "category_counts": category_counts,
        "total": len(events)
    }
}

export fn get_threat_level(events) {
    let security_count = 0
    let critical_count = 0
    for evt in events {
        let evt_dict = if type(evt) == "dict" { evt } else {
            {"message": "", "severity": 4}
        }
        if is_security_event(evt_dict) {
            security_count = security_count + 1
            let sev = evt_dict.get("severity") ?? 4
            if sev == 0 {
                critical_count = critical_count + 1
            }
        }
    }
    let total = len(events)
    if total == 0 { return "none" }
    let sec_ratio = float(security_count) / float(total)
    if critical_count > 0 || sec_ratio > 0.5 { return "critical" }
    if sec_ratio > 0.25 { return "high" }
    if sec_ratio > 0.1 { return "medium" }
    if security_count > 0 { return "low" }
    return "none"
}

main {
    print("module loaded")
}

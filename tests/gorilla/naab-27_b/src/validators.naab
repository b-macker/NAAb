use regex
use validate

export fn sanitize_string(input) {
    if input == null { return "" }
    let s = string.trim(input)
    s = string.replace(s, "<", "")
    s = string.replace(s, ">", "")
    return s
}

export fn sanitize_log_line(line) {
    if line == null { return "" }
    let stripped = regex.replace(line, "\\x1b\\[[0-9;]*m", "")
    return sanitize_string(stripped)
}

export fn validate_event_schema(event_dict) {
    let errors = []
    if event_dict == null { return {valid: false, errors: ["Event dict is null"]} }

    if event_dict.get("id") == null {
        errors = errors + ["Missing required field: id"]
    }
    if event_dict.get("timestamp") == null {
        errors = errors + ["Missing required field: timestamp"]
    }
    if event_dict.get("source") == null {
        errors = errors + ["Missing required field: source"]
    }
    if event_dict.get("severity") == null {
        errors = errors + ["Missing required field: severity"]
    }
    if event_dict.get("message") == null {
        errors = errors + ["Missing required field: message"]
    }

    return {valid: len(errors) == 0, errors: errors}
}

export fn validate_email_address(email) {
    if email == null { return false }
    return validate.email(email)
}

export fn validate_timestamp(ts) {
    if ts == null { return false }
    if ts < 0 { return false }
    return true
}

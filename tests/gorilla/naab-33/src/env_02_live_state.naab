// Test: Live environment — agent.send() response includes environment dict
// Validates: turns_used increments, tokens_used grows, turns_remaining decrements
use agent

main {
    let h = agent.create("analyst")
    let birth_env = h.get("environment")
    let birth_turns = birth_env.get("state").get("turns_used")

    // First send
    let r1 = try { agent.send(h, "Say hello in 5 words") } catch (e) { null }
    if r1 == null {
        print("live_state: api_failed")
        return
    }

    let env1 = r1.get("environment")
    let state1 = env1.get("state")
    let turns1 = state1.get("turns_used")
    let tokens1 = state1.get("tokens_used")
    let remaining1 = state1.get("turns_remaining")
    print("live_after_1: turns_used=" + string(turns1) +
          " tokens_used=" + string(tokens1) +
          " turns_remaining=" + string(remaining1))

    // Second send
    let r2 = try { agent.send(h, "Say goodbye in 5 words") } catch (e) { null }
    if r2 == null {
        print("live_state: second_send_failed")
        return
    }

    let env2 = r2.get("environment")
    let state2 = env2.get("state")
    let turns2 = state2.get("turns_used")
    let tokens2 = state2.get("tokens_used")
    let remaining2 = state2.get("turns_remaining")
    print("live_after_2: turns_used=" + string(turns2) +
          " tokens_used=" + string(tokens2) +
          " turns_remaining=" + string(remaining2))

    // Verify monotonic increments
    let turns_grew = turns2 > turns1
    let tokens_grew = tokens2 > tokens1
    let remaining_shrank = remaining2 < remaining1
    print("live_monotonic: turns_grew=" + string(turns_grew) +
          " tokens_grew=" + string(tokens_grew) +
          " remaining_shrank=" + string(remaining_shrank))

    print("live_state: completed")
}

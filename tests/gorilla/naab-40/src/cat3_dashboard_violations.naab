print("v1")
>>

    let r2 = <<python
# TRIGGER_ADVISORY
print("v2")
>>

    let r3 = <<python
# TRIGGER_ADVISORY
print("v3")
>>

    // Trigger DASH-HEAVY (has default weight 20 from rule_weights)
    let r4 = <<python
# HEAVY_ADVISORY
print("v4")
>>

    print("dashboard_done")
}

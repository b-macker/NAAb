        },
        {
            "id": "DASH-HEAVY",
            "name": "Dashboard heavy trigger",
            "pattern": "HEAVY_ADVISORY",
            "level": "advisory",
            "message": "Dashboard test heavy advisory violation",
            "enabled": true
        }
    ],
    "governance_health": {
        "enabled": true
    }
}

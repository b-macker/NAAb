import "validators.naab" as validators
import "models.naab" as models
use array
use crypto
use codegen
use time

fn classify_event(event) {
  let event_type = event.get("event_type")
  let category = match event_type {
    "auth_failure" => "authentication",
    "port_scan" => "reconnaissance",
    "malware_detect" => "malicious_activity",
    "sql_injection" => "injection_attack",
    "brute_force" => "brute_force_attack",
    "data_exfil" => "data_leakage",
    "privilege_escalation" => "privilege_attack",
    "config_change" => "configuration",
    "anomalous_login" => "anomaly",
    "ddos_attempt" => "denial_of_service",
    _ => "unknown"
  }
  return category
}

fn score_severity(event, history) {
  let event_severity = event.get("severity")
  let base_score = event_severity * 10

  let risk_score = base_score
  if base_score > 50 {
    risk_score = base_score + 10
  } else if base_score > 30 {
    risk_score = base_score + 5
  }

  if risk_score > 100 {
    risk_score = 100
  }

  return risk_score
}

fn detect_patterns(events) {
  let patterns = {}
  let sources = {}

  let i = 0
  while i < events.length() {
    let event = events[i]
    let src = event.get("source")
    let event_type = event.get("event_type")

    let src_count = sources.get(src) ?? 0
    sources[src] = src_count + 1

    let type_count = patterns.get(event_type) ?? 0
    patterns[event_type] = type_count + 1

    i = i + 1
  }

  let pattern_summary = codegen.run_with_args("shell", "
echo 'patterns_detected'
", {})

  return {
    "patterns": patterns,
    "sources": sources,
    "status": pattern_summary
  }
}

fn analyze_batch(events) {
  let analyses = []
  let i = 0
  while i < events.length() {
    let event = events[i]
    let category = classify_event(event)
    let scores = []
    let j = 0
    while j < i {
      let severity_val = events[j].get("severity") * 10
      array.push(scores, severity_val)
      j = j + 1
    }
    let risk = score_severity(event, scores)
    let indicators = [category, "severity_" + event.get("severity")]
    let rec = if risk > 70 {
      "immediate_action_required"
    } else if risk > 40 {
      "investigation_recommended"
    } else {
      "monitor_and_log"
    }

    let analysis = models.make_analysis(
      event.get("id"),
      category,
      risk,
      indicators,
      rec
    )
    array.push(analyses, analysis)
    i = i + 1
  }
  return analyses
}

async fn analyze_batch_async(events) {
  let analyses = []
  let i = 0
  while i < events.length() {
    let event = events[i]
    let category = classify_event(event)
    let risk = score_severity(event, [])
    let indicators = [category]
    let rec = if risk > 70 {
      "immediate_action_required"
    } else if risk > 40 {
      "investigation_recommended"
    } else {
      "monitor_and_log"
    }

    let analysis = models.make_analysis(
      event.get("id"),
      category,
      risk,
      indicators,
      rec
    )
    array.push(analyses, analysis)
    i = i + 1
  }
  return analyses
}

fn build_audit_chain(analyses) {
  let chain_data = ""
  let i = 0
  while i < analyses.length() {
    let analysis = analyses[i]
    let event_id = analysis.get("event_id")
    let risk = analysis.get("risk_score")
    chain_data = chain_data + event_id + ":" + risk + ";"
    i = i + 1
  }

  let hash1 = crypto.sha256(chain_data)
  let hash2 = crypto.sha256(hash1)
  let hash3 = crypto.sha256(hash2)

  return hash3
}

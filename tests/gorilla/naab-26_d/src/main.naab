fn test_models() {
    let passed = 0
    let total = 0

    total = total + 1
    let r1 = models.create_rule("R1", "Test", "Desc", 0, "encryption", [], [], [])
    if r1.get("id") == "R1" { passed = passed + 1 }

    total = total + 1
    let e1 = models.create_entity("E1", "ProdDB", 1, {"encryption": "AES256"}, ["prod"], "admin")
    if e1.get("name") == "ProdDB" { passed = passed + 1 }

    total = total + 1
    let c1 = models.create_condition(0, "encryption", "AES256", [])
    if c1.get("op") == 0 { passed = passed + 1 }

    total = total + 1
    let f1 = models.create_finding("R1", "E1", 1, 0, "Missing encryption", "no TLS")
    if f1.get("result") == 1 { passed = passed + 1 }

    total = total + 1
    if models.severity_name(0) == "Critical" { passed = passed + 1 }

    total = total + 1
    if models.op_name(2) == ">" { passed = passed + 1 }

    total = total + 1
    if models.result_name(0) == "Pass" { passed = passed + 1 }

    total = total + 1
    if models.entity_type_name(1) == "Database" { passed = passed + 1 }

    total = total + 1
    let vr = models.validate_rule(r1)
    if vr.get("valid") == true { passed = passed + 1 }

    total = total + 1
    let ve = models.validate_entity({"id": "", "name": "", "owner": ""})
    if ve.get("valid") == false { passed = passed + 1 }

    return [passed, total]
}

fn test_validators() {
    let passed = 0
    let total = 0

    total = total + 1
    let s1 = validators.sanitize_string("<script>alert</script>")
    if !string.contains(s1, "<") { passed = passed + 1 }

    total = total + 1
    let s2 = validators.sanitize_string("{\"key\": \"val\"}")
    if string.contains(s2, "\"") { passed = passed + 1 }

    total = total + 1
    let s3 = validators.sanitize_log_line("test\u001b[31mred")
    if !string.contains(s3, "\u001b") { passed = passed + 1 }

    total = total + 1
    let vrx = validators.validate_rule_syntax({
        "id": "R1",
        "name": "Test",
        "category": "encryption",
        "severity": 0,
        "conditions": [{}]
    })
    if vrx.get("valid") == true { passed = passed + 1 }

    total = total + 1
    let vrx2 = validators.validate_rule_syntax({"id": "", "name": "Test", "category": "encryption", "severity": 0, "conditions": [{}]})
    if vrx2.get("valid") == false { passed = passed + 1 }

    total = total + 1
    let vrx3 = validators.validate_rule_syntax({"id": "R1", "name": "Test", "category": "invalid_category", "severity": 0, "conditions": [{}]})
    if vrx3.get("valid") == false { passed = passed + 1 }

    total = total + 1
    let cond_simple = [models.create_condition(0, "x", "y", [])]
    let vct = validators.validate_condition_tree(cond_simple)
    if vct.get("valid") == true && vct.get("depth") == 0 { passed = passed + 1 }

    total = total + 1
    let cond_and = [models.create_condition(8, "", "", [
        models.create_condition(0, "a", "b", []),
        models.create_condition(0, "c", "d", [])
    ])]
    let vct2 = validators.validate_condition_tree(cond_and)
    if vct2.get("valid") == true && vct2.get("depth") == 1 { passed = passed + 1 }

    total = total + 1
    let cond_bad = [models.create_condition(10, "", "", [
        models.create_condition(0, "a", "b", []),
        models.create_condition(0, "c", "d", [])
    ])]
    let vct3 = validators.validate_condition_tree(cond_bad)
    if vct3.get("valid") == false { passed = passed + 1 }

    total = total + 1
    let cond_deep = [models.create_condition(8, "", "", [
        models.create_condition(8, "", "", [
            models.create_condition(0, "x", "y", [])
        ])
    ])]
    let vct4 = validators.validate_condition_tree(cond_deep)
    if vct4.get("depth") == 2 { passed = passed + 1 }

    return [passed, total]
}

fn test_conditions() {

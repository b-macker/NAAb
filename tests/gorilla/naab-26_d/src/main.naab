    let res12 = test_integration()
    total_passed = total_passed + res12[0]
    total_tests = total_tests + res12[1]
    print("test_integration: " + string(res12[0]) + "/" + string(res12[1]))

    print("\nTotal: " + string(total_passed) + "/" + string(total_tests))
}

use regex
use validate

import "models.naab" as models

export fn sanitize_string(input) {
    if input == null {
        return ""
    }
    let s = string(input)
    s = string.replace(s, "<", "")
    s = string.replace(s, ">", "")
    s = string.trim(s)
    return s
}

export fn sanitize_log_line(line) {
    if line == null {
        return ""
    }
    let s = string(line)
    s = regex.replace(s, "\u001b\\[[0-9;]*m", "")
    return sanitize_string(s)
}

export fn validate_rule_syntax(definition) {
    let errors = []
    let valid = true

    let id = definition.get("id")
    if id == null || id == "" {
        errors.push("id is required and must be non-empty")
        valid = false
    }

    let name = definition.get("name")
    if name == null || name == "" {
        errors.push("name is required and must be non-empty")
        valid = false
    }

    let category = definition.get("category")
    if category == null || category == "" {
        errors.push("category is required")
        valid = false
    } else {
        let valid_categories = ["access_control", "encryption", "audit", "network", "data_protection", "authentication"]
        if !array.contains(valid_categories, category) {
            errors.push("category must be one of: access_control, encryption, audit, network, data_protection, authentication")
            valid = false
        }
    }

    let severity = definition.get("severity")
    if severity == null || severity < 0 || severity > 4 {
        errors.push("severity must be an integer between 0 and 4")
        valid = false
    }

    let conditions = definition.get("conditions")
    if conditions == null || len(conditions) == 0 {
        errors.push("conditions must be a non-empty array")
        valid = false
    }

    return {"valid": valid, "errors": errors}
}

export fn validate_email_address(email) {
    return validate.email(email)
}

export fn validate_condition_tree(conditions) {
    let state = {"max_d": 0, "errors": []}

    fn validate_node(node, current_depth, st) {
        if current_depth > st.get("max_d") {
            st["max_d"] = current_depth
        }

        let op = node.get("op")
        if op == null {
            st["errors"].push("missing op at depth " + string(current_depth))
            return st
        }

        if op <= 7 {
            if node.get("field") == null || node.get("field") == "" {
                st["errors"].push("missing field at depth " + string(current_depth))
            }
            if node.get("value") == null {
                st["errors"].push("missing value at depth " + string(current_depth))
            }
        }

        if op == 8 || op == 9 {
            let children = node.get("children") ?? []
            if len(children) == 0 {
                st["errors"].push("AND/OR requires children at depth " + string(current_depth))
            }
            for child in children {
                st = validate_node(child, current_depth + 1, st)
            }
        }

        if op == 10 {
            let children = node.get("children") ?? []
            if len(children) != 1 {
                st["errors"].push("NOT requires exactly 1 child at depth " + string(current_depth))
            }
            for child in children {
                st = validate_node(child, current_depth + 1, st)
            }
        }

        return st
    }

    for cond in conditions {
        state = validate_node(cond, 0, state)
    }
    return {"valid": len(state.get("errors")) == 0, "errors": state.get("errors"), "depth": state.get("max_d")}
}


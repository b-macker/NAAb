use uuid

import "models.naab" as models

export fn find_best_remediation(finding, available_actions) {
    let sev = finding.get("severity")
    let priority = match sev {
        0 => 0,
        1 => 1,
        2 => 2,
        3 => 3,
        4 => 4,
        _ => 2
    }

    let best_action = if len(available_actions) > 0 {
        available_actions[0]
    } else {
        {"action": "unknown", "effort": 10}
    }

    let best_effort = best_action.get("effort") ?? 10

    for action in available_actions {
        let effort = action.get("effort") ?? 10
        if effort < best_effort {
            best_action = action
            best_effort = effort
        }
    }

    return {
        "action": best_action.get("action"),
        "priority": priority,
        "estimated_effort": best_action.get("effort"),
        "dependencies": best_action.get("dependencies") ?? []
    }
}

export fn build_remediation_plan(findings, available_actions) {
    let steps = []
    let total_effort = 0

    for finding in findings {
        let remediation = find_best_remediation(finding, available_actions)
        let step = new models.RemediationStep {
            id: uuid.v4(),
            finding_id: finding.get("rule_id"),
            action: remediation.get("action"),
            priority: remediation.get("priority"),
            estimated_hours: remediation.get("estimated_effort") ?? 0,
            blocked_by: remediation.get("dependencies") ?? [],
            completed: false
        }
        steps.push(step)
        total_effort = total_effort + step.get("estimated_hours")
    }

    return {
        "steps": steps,
        "total_effort": total_effort,
        "priority_order": array.sort(steps),
        "blocked_by": {}
    }
}

export fn estimate_total_effort(steps) {
    let total_hours = 0
    for step in steps {
        total_hours = total_hours + step.get("estimated_hours")
    }

    let days = float(total_hours) / 8.0
    let cost = int(float(total_hours) * 150.0)

    return {
        "hours": total_hours,
        "days": days,
        "cost_estimate": cost
    }
}

export fn get_actionable_steps(steps) {
    let result = []
    for step in steps {
        let blocked_by_steps = step.get("blocked_by") ?? []
        let all_blockers_done = true

        for blocker_id in blocked_by_steps {
            for other_step in steps {
                if other_step.get("id") == blocker_id {
                    if other_step.get("completed") != true {
                        all_blockers_done = false
                    }
                }
            }
        }

        if all_blockers_done {
            result.push(step)
        }
    }
    return result
}

export fn mark_step_completed(steps, step_id) {
    let result = []
    for step in steps {
        if step.get("id") == step_id {
            let updated = step
            updated["completed"] = true
            result.push(updated)
        } else {
            result.push(step)
        }
    }
    return result
}


use uuid

import "models.naab" as models

export fn find_best_remediation(finding, available_actions) {
    let severity = finding.get("severity")
    let priority = match severity {
        models.Severity.Critical => models.RemediationPriority.Immediate,
        models.Severity.High => models.RemediationPriority.High,
        models.Severity.Medium => models.RemediationPriority.Medium,
        _ => models.RemediationPriority.Low
    }

    let best_action = null
    let best_score = -1

    for action in available_actions {
        let effort = action.get("estimated_hours") ?? 1
        let deps = action.get("dependencies") ?? []
        let score = 100 - effort - (len(deps) * 10)

        if score > best_score {
            best_score = score
            best_action = action
        }
    }

    if best_action == null {
        best_action = {
            "name": "placeholder",
            "estimated_hours": 1,
            "dependencies": []
        }
    }

    return {
        "action": best_action.get("name"),
        "priority": priority,
        "estimated_effort": best_action.get("estimated_hours"),
        "dependencies": best_action.get("dependencies") ?? []
    }
}

export fn build_remediation_plan(findings, available_actions) {
    let steps = []
    let total_effort = 0

    for finding in findings {
        let remediation = find_best_remediation(finding, available_actions)
        let step = new models.RemediationStep {
            id: uuid.v4(),
            finding_id: finding.get("rule_id"),
            action: remediation.get("action"),
            priority: remediation.get("priority"),
            estimated_hours: remediation.get("estimated_effort"),
            blocked_by: remediation.get("dependencies"),
            completed: false
        }
        steps.push(step)
        total_effort = total_effort + remediation.get("estimated_effort")
    }

    let priority_order = []
    for step in steps {
        priority_order.push(step.get("id"))
    }

    let blocked_by_dict = {}
    for step in steps {
        let id = step.get("id")
        blocked_by_dict[id] = step.get("blocked_by")
    }

    return {
        "steps": steps,
        "total_effort": total_effort,
        "priority_order": priority_order,
        "blocked_by": blocked_by_dict
    }
}

export fn estimate_total_effort(steps) {
    let hours = 0
    for step in steps {
        hours = hours + step.get("estimated_hours")
    }
    let days = hours / 8
    let cost_estimate = hours * 150
    return {
        "hours": hours,
        "days": int(days),
        "cost_estimate": int(cost_estimate)
    }
}

export fn get_actionable_steps(steps) {
    let actionable = []
    for step in steps {
        let blockers = step.get("blocked_by") ?? []
        let all_blocked_done = true
        for blocker_id in blockers {
            let blocker = null
            for s in steps {
                if s.get("id") == blocker_id {
                    blocker = s
                }
            }
            if blocker != null && blocker.get("completed") != true {
                all_blocked_done = false
            }
        }
        if all_blocked_done {
            actionable.push(step)
        }
    }
    return actionable
}

export fn mark_step_completed(steps, step_id) {
    for i in 0..len(steps) {
        let step = steps[i]
        if step.get("id") == step_id {
            step["completed"] = true
            steps[i] = step
        }
    }
    return steps
}

    let test_integration_res = test_integration()
    print("test_integration: " + string(test_integration_res[0]) + "/" + string(test_integration_res[1]))

    let total_passed = test_models_res[0] + test_validators_res[0] + test_conditions_res[0] + test_rules_res[0] +

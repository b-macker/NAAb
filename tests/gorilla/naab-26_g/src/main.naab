    print("test_entities: " + string(test_entities_res[0]) + "/" + string(test_entities_res[1]))

    let test_evaluator_res = test_evaluator()
    print("test_evaluator: " + string(test_evaluator_res[0]) + "/" + string(test_evaluator_res[1]))

    let test_dependencies_res = test_dependencies()
    print("test_dependencies: " + string(test_dependencies_res[0]) + "/" + string(test_dependencies_res[1]))

    let test_risk_res = test_risk()
    print("test_risk: " + string(test_risk_res[0]) + "/" + string(test_risk_res[1]))

    let test_reports_res = test_reports()
    print("test_reports: " + string(test_reports_res[0]) + "/" + string(test_reports_res[1]))

    let test_remediation_res = test_remediation()
    print("test_remediation: " + string(test_remediation_res[0]) + "/" + string(test_remediation_res[1]))

    let test_interpreter_res = test_interpreter()

use uuid

import "models.naab" as models

export fn register_entity(registry, entity) {
    for existing in registry {
        if existing.get("id") == entity.get("id") {
            return {"registry": registry, "success": false, "error": "duplicate id"}
        }
    }

    registry.push(entity)
    return {"registry": registry, "success": true}
}

export fn get_entity_by_id(registry, id) {
    for entity in registry {
        if entity.get("id") == id {
            return entity
        }
    }
    return null
}

export fn get_entities_by_type(registry, entity_type) {
    return array.filter(registry, fn(e) {
        return e.get("entity_type") == entity_type
    })
}

export fn update_entity_attribute(registry, entity_id, key, value) {
    for i in 0..len(registry) {
        let e = registry[i]
        if e.get("id") == entity_id {
            let attrs = e.get("attributes")
            attrs[key] = value
            e["attributes"] = attrs
            registry[i] = e
            return {"registry": registry, "success": true}
        }
    }
    return {"registry": registry, "success": false}
}

export fn get_entity_attributes(entity) {
    return entity.get("attributes") ?? {}
}

export fn filter_entities_by_tag(registry, tag) {
    return array.filter(registry, fn(e) {
        let tags = e.get("tags") ?? []
        for t in tags {
            if t == tag {
                return true
            }
        }
        return false
    })
}

fn get_type_counts(types_and_registry) {
    let counts = {}
    let registry = types_and_registry[0]
    let types = types_and_registry[1]

    for t in types {
        let type_name = models.entity_type_name(t)
        let matching = get_entities_by_type(registry, t)
        let count = len(matching)
        if count > 0 {
            counts[type_name] = count
        }
    }

    return counts
}

export fn count_entities_by_type(registry) {
    let all_types = [models.EntityType.Server, models.EntityType.Database, models.EntityType.Application,
                     models.EntityType.Network, models.EntityType.User, models.EntityType.Policy]

    return [registry, all_types] |> get_type_counts
}

main {
}

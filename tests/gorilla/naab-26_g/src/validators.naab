use regex
use validate

import "models.naab" as models

export fn sanitize_string(input) {
    if input == null {
        return ""
    }

    let s = string(input)
    s = string.replace(s, "<", "")
    s = string.replace(s, ">", "")
    s = string.trim(s)
    return s
}

export fn sanitize_log_line(line) {
    let s = string(line)
    s = regex.replace(s, "\\x1b\\[[0-9;]*m", "")
    return sanitize_string(s)
}

export fn validate_rule_syntax(definition) {
    let errors = []
    let valid = true

    let id = definition.get("id") ?? ""
    if id == "" {
        errors.push("Rule id is required")
        valid = false
    }

    let name = definition.get("name") ?? ""
    if name == "" {
        errors.push("Rule name is required")
        valid = false
    }

    let category = definition.get("category") ?? ""
    let valid_categories = ["access_control", "encryption", "audit", "network", "data_protection", "authentication"]
    let found_category = false
    for cat in valid_categories {
        if cat == category {
            found_category = true
        }
    }
    if !found_category {
        errors.push("Category must be one of: access_control, encryption, audit, network, data_protection, authentication")
        valid = false
    }

    let severity = definition.get("severity") ?? -1
    if severity < 0 || severity > 4 {
        errors.push("Severity must be between 0 and 4")
        valid = false
    }

    let conditions = definition.get("conditions") ?? []
    if len(conditions) == 0 {
        errors.push("At least one condition is required")
        valid = false
    }

    return {
        "valid": valid,
        "errors": errors
    }
}

export fn validate_email_address(email) {
    return validate.email(email)
}

export fn validate_condition_tree(conditions) {
    let state = {"max_depth": 0, "errors": []}

    fn validate_node(node, depth, st) {
        if depth > st.get("max_depth") {
            st["max_depth"] = depth
        }

        let op = node.get("op") ?? -1

        if op <= models.ConditionOp.Matches {
            let field = node.get("field") ?? ""
            if field == "" {
                st["errors"].push("Missing field at depth " + string(depth))
            }

            let value = node.get("value")
            if value == null {
                st["errors"].push("Missing value at depth " + string(depth))
            }
        }

        if op == models.ConditionOp.And || op == models.ConditionOp.Or {
            let children = node.get("children") ?? []
            if len(children) == 0 {
                st["errors"].push("AND/OR requires children at depth " + string(depth))
            }
            for child in children {
                validate_node(child, depth + 1, st)
            }
        }

        if op == models.ConditionOp.Not {
            let children = node.get("children") ?? []
            if len(children) != 1 {
                st["errors"].push("NOT requires exactly 1 child at depth " + string(depth))
            }
            for child in children {
                validate_node(child, depth + 1, st)
            }
        }

        return st
    }

    for cond in conditions {
        state = validate_node(cond, 0, state)
    }

    return {
        "valid": len(state.get("errors")) == 0,
        "errors": state.get("errors"),
        "depth": state.get("max_depth")
    }
}

main {

fn make_test_events() {
    let events = []
    let base_ts = 1700000000

    events.push({
        "id": "evt-001", "timestamp": base_ts, "source": "auth-service",
        "severity": 0, "message": "Auth failure: brute force detected from 10.0.0.5",
        "category": 0, "subcategory": "authentication", "tags": ["security", "auth"],
        "metadata": {"ip": "10.0.0.5"}
    })
    events.push({
        "id": "evt-002", "timestamp": base_ts + 5, "source": "auth-service",
        "severity": 1, "message": "Multiple login failures for user admin",
        "category": 0, "subcategory": "login", "tags": ["security"],
        "metadata": {"user": "admin"}
    })
    events.push({
        "id": "evt-003", "timestamp": base_ts + 30, "source": "disk-monitor",
        "severity": 1, "message": "Disk full on /dev/sda1 — partition at 98%",
        "category": 1, "subcategory": "storage", "tags": ["infrastructure", "disk"],
        "metadata": {"partition": "/dev/sda1", "usage_pct": 98}
    })
    events.push({
        "id": "evt-004", "timestamp": base_ts + 60, "source": "app-server",
        "severity": 2, "message": "Request timeout after 30s on /api/users endpoint",
        "category": 4, "subcategory": "latency", "tags": ["performance"],
        "metadata": {"endpoint": "/api/users", "timeout_ms": 30000}
    })
    events.push({
        "id": "evt-005", "timestamp": base_ts + 90, "source": "db-primary",
        "severity": 0, "message": "Deadlock detected in transaction 48271 — replication lag 45s",
        "category": 5, "subcategory": "deadlock", "tags": ["database"],
        "metadata": {"transaction_id": 48271, "replication_lag": 45}
    })
    events.push({
        "id": "evt-006", "timestamp": base_ts + 120, "source": "network-gw",
        "severity": 3, "message": "Packet loss 2% on interface eth0",
        "category": 3, "subcategory": "packet_loss", "tags": ["network"],
        "metadata": {"interface": "eth0", "loss_pct": 2}
    })
    events.push({
        "id": "evt-007", "timestamp": base_ts + 150, "source": "auth-service",
        "severity": 4, "message": "User login successful for user bob",
        "category": 2, "subcategory": "login", "tags": ["info"],
        "metadata": {"user": "bob"}
    })
    events.push({
        "id": "evt-008", "timestamp": base_ts + 180, "source": "app-server",
        "severity": 5, "message": "GC pause 12ms in heap compaction",
        "category": 4, "subcategory": "gc", "tags": ["performance", "debug"],
        "metadata": {"gc_type": "compaction", "pause_ms": 12}
    })
    events.push({
        "id": "evt-009", "timestamp": base_ts + 200, "source": "firewall",
        "severity": 0, "message": "Intrusion attempt blocked from 192.168.1.100 — exploit payload detected",
        "category": 0, "subcategory": "intrusion", "tags": ["security", "firewall"],
        "metadata": {"src_ip": "192.168.1.100"}
    })
    events.push({
        "id": "evt-010", "timestamp": base_ts + 250, "source": "db-primary",
        "severity": 2, "message": "Slow query detected: SELECT * FROM orders WHERE status='pending' took 8.5s",
        "category": 5, "subcategory": "slow_query", "tags": ["database", "performance"],
        "metadata": {"query_time_ms": 8500}
    })

    return events
}

fn test_create_event() {
    let passed = 0
    let total = 0

    total = total + 1
    let evt = models.create_event("test-1", 1700000000, "test-src", 0, "test message", 0, "sub", ["tag1"], {"k": "v"})
    let required_keys = ["id", "timestamp", "source", "severity", "message", "category"]
    let all_present = true
    for k in required_keys {
        if evt.get(k) == null {
            if k != "severity" || evt.get(k) != 0 {
                all_present = false
            }
        }
    }
    if all_present { passed = passed + 1 }

    total = total + 1
    if evt.get("id") == "test-1" && evt.get("source") == "test-src" {
        passed = passed + 1
    }

    total = total + 1
    if evt.get("severity") == 0 && evt.get("category") == 0 {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_normalize_severity() {
    let passed = 0
    let total = 0

    total = total + 1
    if parser.normalize_severity("CRITICAL") == 0 { passed = passed + 1 }

    total = total + 1
    if parser.normalize_severity("WARNING") == 3 { passed = passed + 1 }

    total = total + 1
    if parser.normalize_severity("INFO") == 4 { passed = passed + 1 }

    total = total + 1
    if parser.normalize_severity("ERROR") == 1 { passed = passed + 1 }

    total = total + 1
    if parser.normalize_severity("DEBUG") == 5 { passed = passed + 1 }

    total = total + 1
    if parser.normalize_severity(null) == 4 { passed = passed + 1 }

    return [passed, total]
}

fn test_classify_event() {
    let passed = 0
    let total = 0

    total = total + 1
    let auth_result = classifier.classify_event({"message": "auth failure", "category": 0})
    let disk_result = classifier.classify_event({"message": "disk full", "category": 2})
    if auth_result.get("category") != disk_result.get("category") {
        passed = passed + 1
    }

    total = total + 1
    let keys_ok = auth_result.get("category") != null && auth_result.get("confidence") != null && auth_result.get("tags") != null
    if keys_ok { passed = passed + 1 }

    total = total + 1
    let sec_result = classifier.classify_event({"message": "intrusion exploit malware breach", "category": -1})
    if sec_result.get("confidence") > 0.7 { passed = passed + 1 }

    total = total + 1
    let empty_result = classifier.classify_event({"message": "", "category": -1})
    if empty_result.get("confidence") <= 0.5 { passed = passed + 1 }

    return [passed, total]
}

fn test_is_security_event() {
    let passed = 0
    let total = 0

    total = total + 1
    let r1 = classifier.is_security_event({"message": "Auth failure"})
    let r2 = classifier.is_security_event({"message": "AUTH FAILURE"})
    if r1 == r2 { passed = passed + 1 }

    total = total + 1
    if classifier.is_security_event({"message": "brute force login attempt"}) == true {
        passed = passed + 1
    }

    total = total + 1
    if classifier.is_security_event({"message": "user logged in successfully"}) == false {
        passed = passed + 1
    }

    total = total + 1
    if classifier.is_security_event({"message": "exploit detected in payload"}) == true {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_compute_severity_distribution() {
    let passed = 0
    let total = 0

    let events = make_test_events()
    let result = metrics.compute_severity_distribution(events)

    total = total + 1
    let has_keys = result.get("distribution") != null && result.get("total") != null && result.get("dominant_severity") != null
    if has_keys { passed = passed + 1 }

    total = total + 1
    if result.get("total") == 10 { passed = passed + 1 }

    total = total + 1
    let dist = result.get("distribution") ?? {}
    let crit_count = dist.get("0") ?? 0
    if crit_count == 3 { passed = passed + 1 }

    return [passed, total]
}

fn test_compute_alert_statistics() {
    let passed = 0
    let total = 0

    let alerts_a = [
        {"severity": 0, "state": 0},
        {"severity": 1, "state": 2},
        {"severity": 3, "state": 4}
    ]
    let incidents_a = [{"severity": 0}]
    let result_a = metrics.compute_alert_statistics(alerts_a, incidents_a)

    total = total + 1
    let has_keys = result_a.get("total_alerts") != null && result_a.get("escalation_rate") != null
    if has_keys { passed = passed + 1 }

    total = total + 1
    if result_a.get("total_alerts") == 3 { passed = passed + 1 }

    let alerts_b = [
        {"severity": 4, "state": 0},
        {"severity": 4, "state": 0}
    ]
    let result_b = metrics.compute_alert_statistics(alerts_b, [])

    total = total + 1
    if result_a.get("escalation_rate") != result_b.get("escalation_rate") {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_compute_event_frequency() {
    let passed = 0
    let total = 0

    let events = make_test_events()
    let result = metrics.compute_event_frequency(events)

    total = total + 1
    let has_keys = result.get("events_per_minute") != null && result.get("peak_rate") != null
    if has_keys { passed = passed + 1 }

    total = total + 1
    if result.get("events_per_minute") > 0 { passed = passed + 1 }

    total = total + 1
    let empty_result = metrics.compute_event_frequency([])
    if empty_result.get("events_per_minute") == 0.0 { passed = passed + 1 }

    return [passed, total]
}

fn test_parse_log_entry() {
    let passed = 0
    let total = 0

    total = total + 1
    let json_input = json.stringify({"id": "j1", "source": "test", "severity": "warning", "message": "test warn msg", "timestamp": 1700000000})
    let result = parser.parse_log_entry(json_input)
    let has_keys = result.get("event") != null && result.get("valid") != null && result.get("errors") != null
    if has_keys { passed = passed + 1 }

    total = total + 1
    if result.get("valid") == true { passed = passed + 1 }

    total = total + 1
    let null_result = parser.parse_log_entry(null)
    if null_result.get("valid") == false { passed = passed + 1 }

    total = total + 1
    let empty_result = parser.parse_log_entry("")
    if empty_result.get("valid") == false { passed = passed + 1 }

    total = total + 1
    let syslog_result = parser.parse_log_entry("Jan  5 14:23:01 webserver nginx: connection timeout from 10.0.0.1")
    if syslog_result.get("valid") == true { passed = passed + 1 }

    return [passed, total]
}

fn test_generate_timeline() {
    let passed = 0
    let total = 0

    let events = make_test_events()
    let result = timeline.generate_timeline(events)

    total = total + 1
    let has_keys = result.get("entries") != null && result.get("duration_seconds") != null
    if has_keys { passed = passed + 1 }

    total = total + 1
    let entries = result.get("entries") ?? []
    if len(entries) == len(events) { passed = passed + 1 }

    total = total + 1
    if result.get("duration_seconds") > 0 { passed = passed + 1 }

    total = total + 1
    let empty_result = timeline.generate_timeline([])
    if empty_result.get("duration_seconds") == 0 { passed = passed + 1 }

    return [passed, total]
}

fn test_store_event() {
    let passed = 0
    let total = 0

    let store_obj = storage.create_store()
    let evt = {"id": "s1", "timestamp": 1700000000, "source": "test", "severity": 1, "message": "store test"}
    let result = storage.store_event(store_obj, evt)

    total = total + 1
    let has_keys = result.get("store") != null && result.get("success") != null && result.get("event_id") != null
    if has_keys { passed = passed + 1 }

    total = total + 1
    if result.get("success") == true { passed = passed + 1 }

    total = total + 1
    if result.get("event_id") == "s1" { passed = passed + 1 }

    total = total + 1
    let new_store = result.get("store")
    let retrieved = storage.retrieve_event(new_store, "s1")
    if retrieved.get("found") == true { passed = passed + 1 }

    return [passed, total]
}

fn test_sanitize_string() {
    let passed = 0
    let total = 0

    total = total + 1
    let result = validators.sanitize_string("<script>alert('xss')</script>")
    if string.contains(result, "<") == false && string.contains(result, ">") == false {
        passed = passed + 1
    }

    total = total + 1
    if validators.sanitize_string(null) == "" { passed = passed + 1 }

    total = total + 1
    let clean = validators.sanitize_string("  hello world  ")
    if clean == "hello world" { passed = passed + 1 }

    return [passed, total]
}

fn test_validate_event_schema() {
    let passed = 0
    let total = 0

    total = total + 1
    let valid_evt = {"id": "v1", "timestamp": 1700000000, "source": "test", "severity": 2, "message": "ok"}
    let result = validators.validate_event_schema(valid_evt)
    let has_keys = result.get("valid") != null && result.get("errors") != null
    if has_keys { passed = passed + 1 }

    total = total + 1
    if result.get("valid") == true { passed = passed + 1 }

    total = total + 1
    let invalid_evt = {"id": "", "timestamp": -1}
    let inv_result = validators.validate_event_schema(invalid_evt)
    if inv_result.get("valid") == false { passed = passed + 1 }

    total = total + 1
    if len(inv_result.get("errors") ?? []) > 0 { passed = passed + 1 }

    return [passed, total]
}

fn test_correlator() {
    let passed = 0
    let total = 0

    let events = make_test_events()

    total = total + 1
    let by_source = correlator.correlate_by_source(events)
    let auth_events = by_source.get("auth-service") ?? []
    if len(auth_events) == 3 { passed = passed + 1 }

    total = total + 1
    let windows = correlator.correlate_by_time_window(events, 60)
    if len(windows) > 0 { passed = passed + 1 }

    total = total + 1
    let chains = correlator.find_event_chains(events, 60)
    if len(chains) > 0 { passed = passed + 1 }

    total = total + 1
    let burst = correlator.detect_burst(events, 5)
    if burst.get("peak_rate") != null { passed = passed + 1 }

    total = total + 1
    let score = correlator.compute_correlation_score(events[0], events[1])
    if score > 0.0 { passed = passed + 1 }

    return [passed, total]
}

fn test_alerting() {
    let passed = 0
    let total = 0

    let rule = {
        "id": "rule-1", "name": "Critical severity", "condition_field": "severity",
        "threshold_value": 1, "direction": 1, "severity": 0,
        "cooldown_seconds": 60, "notification_targets": [], "enabled": true
    }

    total = total + 1
    let eval_result = alerting.evaluate_alert_rule(rule, {"severity": 0})
    if eval_result.get("triggered") == true { passed = passed + 1 }

    total = total + 1
    let eval_no = alerting.evaluate_alert_rule(rule, {"severity": 3})
    if eval_no.get("triggered") == false { passed = passed + 1 }

    total = total + 1
    let disabled_rule = {"id": "r2", "enabled": false}
    let disabled_result = alerting.evaluate_alert_rule(disabled_rule, {"severity": 0})
    if disabled_result.get("triggered") == false { passed = passed + 1 }

    total = total + 1
    let events = make_test_events()
    let alerts = alerting.process_event_against_rules(events[0], [rule])
    if len(alerts) > 0 { passed = passed + 1 }

    total = total + 1
    let cooldown_ok = alerting.check_cooldown(rule, 1700000000, 1700000100)
    if cooldown_ok == true { passed = passed + 1 }

    return [passed, total]
}


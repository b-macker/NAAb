    let json_out = exporter.format_events_json(events)
    if string.contains(json_out, "evt-001") { passed = passed + 1 }

    return [passed, total]
}

fn test_reports() {
    let passed = 0
    let total = 0

    let events = make_test_events()
    let alerts = [
        {"severity": 0, "state": 0, "rule_id": "r1", "message": "test alert"},
        {"severity": 1, "state": 2, "rule_id": "r2", "message": "ack alert"}
    ]
    let incidents = [
        {"title": "Security incident", "status": 0, "severity": 0, "priority": 0, "created_at": 1700000000, "tags": ["critical"]}
    ]

    total = total + 1
    let health_report = reports.generate_health_report(events, alerts, incidents)
    if string.contains(health_report, "SYSTEM HEALTH REPORT") { passed = passed + 1 }

    total = total + 1
    let sev_report = reports.generate_severity_report(events)
    if string.contains(sev_report, "SEVERITY REPORT") { passed = passed + 1 }

    total = total + 1
    let inc_report = reports.generate_incident_report(incidents[0], events)
    if string.contains(inc_report, "INCIDENT REPORT") { passed = passed + 1 }

    return [passed, total]
}

fn test_analyzer() {
    let passed = 0
    let total = 0

    let events = make_test_events()

    total = total + 1
    let analysis = analyzer.analyze_event_stream(events)
    if analysis.get("total") == 10 { passed = passed + 1 }

    total = total + 1
    if analysis.get("threat_level") != "none" { passed = passed + 1 }

    total = total + 1
    let source_health = analyzer.analyze_source_health(events)
    let auth_health = source_health.get("auth-service")
    if auth_health != null { passed = passed + 1 }

    total = total + 1
    let alerts = [{"severity": 0, "state": 0}]
    let incidents = [{"status": 0, "severity": 0}]
    let risk = analyzer.compute_risk_score(events, alerts, incidents)
    if risk > 0.0 { passed = passed + 1 }

    return [passed, total]
}

fn test_storage_advanced() {
    let passed = 0
    let total = 0

    let store_obj = storage.create_store()
    let events = make_test_events()

    for evt in events {
        let result = storage.store_event(store_obj, evt)
        store_obj = result.get("store")
    }

    total = total + 1
    let stats = storage.store_stats(store_obj)
    if stats.get("total_events") == 10 { passed = passed + 1 }

    total = total + 1
    let auth_events = storage.query_by_source(store_obj, "auth-service")
    if len(auth_events) == 3 { passed = passed + 1 }

    total = total + 1
    let crit_events = storage.query_by_severity(store_obj, 0)
    if len(crit_events) == 3 { passed = passed + 1 }

    total = total + 1
    let purge_result = storage.purge_by_severity(store_obj, 2)
    if purge_result.get("removed_count") > 0 { passed = passed + 1 }

    return [passed, total]
}

fn test_polyglot_python() {
    let passed = 0
    let total = 0

    let events = make_test_events()

    total = total + 1
    let sev_counts = <<python[events]
import json
counts = {}
for e in events:
    s = str(e.get("severity", 4))
    counts[s] = counts.get(s, 0) + 1
json.dumps(counts)
>>
    let parsed = json.parse(sev_counts)
    if parsed.get("0") == "3" || parsed.get("0") == 3 { passed = passed + 1 }

    total = total + 1
    let sorted_ids = <<python[events]
import json
sorted_evts = sorted(events, key=lambda e: e.get("timestamp", 0))
ids = [e.get("id", "") for e in sorted_evts]
json.dumps(ids)
>>
    let id_list = json.parse(sorted_ids)
    if id_list[0] == "evt-001" { passed = passed + 1 }

    return [passed, total]
}

fn test_polyglot_javascript() {
    let passed = 0
    let total = 0

    let events = make_test_events()

    total = total + 1
    let unique_sources = <<javascript[events]
const sources = {};
for (let i = 0; i < events.length; i++) {
    const src = events[i].source || "unknown";
    sources[src] = (sources[src] || 0) + 1;
}
const result = JSON.stringify(sources);
result
>>
    let src_counts = json.parse(unique_sources)
    if src_counts.get("auth-service") == 3 { passed = passed + 1 }

    total = total + 1
    let max_sev = <<javascript[events]
let maxSev = 999;
for (let i = 0; i < events.length; i++) {
    const s = events[i].severity;
    if (s < maxSev) maxSev = s;
}
const res = String(maxSev);
res
>>
    if max_sev == "0" || int(max_sev) == 0 { passed = passed + 1 }

    return [passed, total]
}


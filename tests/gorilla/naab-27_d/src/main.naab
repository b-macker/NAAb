fn test_analyzer() {
    let passed = 0
    let total = 0

    total = total + 1
    let evt = models.create_event("evt-1", time.now(), "server-1", 0, "Error", 0, "", [], {})
    let patterns = analyzer.analyze_event_patterns([evt], 60)
    if patterns.get("patterns") != null {
        passed = passed + 1
    }

    total = total + 1
    let anomalies = analyzer.analyze_anomalies([evt], { "event_rate": 10 })
    if anomalies.get("risk_score") >= 0.0 {
        passed = passed + 1
    }

    total = total + 1
    let agent_check = analyzer.check_agent_available("incident_analyst")
    if agent_check.get("available") != null {
        passed = passed + 1
    }

    total = total + 1
    let prompt = analyzer.generate_interpretation_prompt(models.create_incident("inc-1", "Test", 0, 0, [evt]), [evt])
    if len(prompt) > 0 {
        passed = passed + 1
    }

    total = total + 1
    let empty_patterns = analyzer.analyze_event_patterns([], 60)
    if empty_patterns.get("patterns") != null {
        passed = passed + 1
    }

    total = total + 1
    let empty_anomalies = analyzer.analyze_anomalies([], {})
    if empty_anomalies.get("anomalies") != null {
        passed = passed + 1
    }

    total = total + 1
    let recurring = patterns.get("recurring_count")
    if recurring >= 0 {
        passed = passed + 1
    }

    total = total + 1
    let recommendations = patterns.get("recommendations")
    if recommendations != null {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_validators() {
    let passed = 0
    let total = 0

    total = total + 1
    let sanitized = validators.sanitize_string("Test <script> content")
    if string.contains(sanitized, "<") == false {
        passed = passed + 1
    }

    total = total + 1
    let evt_dict = {
        "id": "evt-1",
        "timestamp": time.now(),
        "source": "server-1",
        "severity": 0,
        "message": "Test error"
    }
    let validation = validators.validate_event_schema(evt_dict)
    if validation.get("valid") == true {
        passed = passed + 1
    }

    total = total + 1
    let invalid_dict = { "id": "evt-1" }
    let invalid_validation = validators.validate_event_schema(invalid_dict)
    if invalid_validation.get("valid") == false {
        passed = passed + 1
    }

    total = total + 1
    let email_valid = validators.validate_email_address("test@example.com")
    if email_valid == true || email_valid == false {
        passed = passed + 1
    }

    total = total + 1
    let ts_valid = validators.validate_timestamp(1234567890)
    if ts_valid == true {
        passed = passed + 1
    }

    total = total + 1
    let ts_invalid = validators.validate_timestamp(0)
    if ts_invalid == false {
        passed = passed + 1
    }

    total = total + 1
    let log_line = "Normal line"
    let sanitized_log = validators.sanitize_log_line(log_line)
    if len(sanitized_log) > 0 {
        passed = passed + 1
    }

    total = total + 1
    let null_sanitize = validators.sanitize_string(null)
    if null_sanitize == "" {
        passed = passed + 1
    }

    return [passed, total]
}

main {
    let all_results = []

    let test_models_result = test_models()
    all_results = all_results + [test_models_result]
    print("test_models: " + string(test_models_result[0]) + "/" + string(test_models_result[1]))

    let test_parser_result = test_parser()
    all_results = all_results + [test_parser_result]
    print("test_parser: " + string(test_parser_result[0]) + "/" + string(test_parser_result[1]))

    let test_classifier_result = test_classifier()
    all_results = all_results + [test_classifier_result]
    print("test_classifier: " + string(test_classifier_result[0]) + "/" + string(test_classifier_result[1]))

    let test_correlator_result = test_correlator()
    all_results = all_results + [test_correlator_result]
    print("test_correlator: " + string(test_correlator_result[0]) + "/" + string(test_correlator_result[1]))

    let test_alerting_result = test_alerting()

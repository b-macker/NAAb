    print("test_alerting: " + string(test_alerting_result[0]) + "/" + string(test_alerting_result[1]))

    let test_metrics_result = test_metrics()
    all_results = all_results + [test_metrics_result]
    print("test_metrics: " + string(test_metrics_result[0]) + "/" + string(test_metrics_result[1]))

    let test_timeline_result = test_timeline()
    all_results = all_results + [test_timeline_result]
    print("test_timeline: " + string(test_timeline_result[0]) + "/" + string(test_timeline_result[1]))

    let test_storage_result = test_storage()
    all_results = all_results + [test_storage_result]
    print("test_storage: " + string(test_storage_result[0]) + "/" + string(test_storage_result[1]))

    let test_exporter_result = test_exporter()
    all_results = all_results + [test_exporter_result]
    print("test_exporter: " + string(test_exporter_result[0]) + "/" + string(test_exporter_result[1]))

    let test_reports_result = test_reports()
    all_results = all_results + [test_reports_result]
    print("test_reports: " + string(test_reports_result[0]) + "/" + string(test_reports_result[1]))

    let test_analyzer_result = test_analyzer()
    all_results = all_results + [test_analyzer_result]
    print("test_analyzer: " + string(test_analyzer_result[0]) + "/" + string(test_analyzer_result[1]))

    let test_validators_result = test_validators()
    all_results = all_results + [test_validators_result]
    print("test_validators: " + string(test_validators_result[0]) + "/" + string(test_validators_result[1]))

    let total_passed = 0
    let total_tests = 0

    for i in 0..len(all_results) {
        total_passed = total_passed + all_results[i][0]
        total_tests = total_tests + all_results[i][1]
    }

    print("")
    print("========================================")
    print("TOTAL: " + string(total_passed) + "/" + string(total_tests) + " tests passed")
    print("========================================")
}

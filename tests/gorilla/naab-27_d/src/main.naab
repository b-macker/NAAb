    if string.contains(alert_formatted, "Alert") {
        passed = passed + 1
    }

    total = total + 1
    let empty_csv = exporter.export_events_csv([])
    if empty_csv.get("row_count") == 0 {
        passed = passed + 1
    }

    total = total + 1
    let hash = json_result.get("hash")

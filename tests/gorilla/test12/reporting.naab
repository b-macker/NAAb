use array
use math
use string
use json
use csv
import "./drivers.naab" as drv

export fn generate_fleet_report(fleet, routes) {
    let available_count = 0
    let in_transit_count = 0
    let maintenance_count = 0
    let total_mileage = 0.0
    
    for v in fleet {
        let status = v.get("status")
        if status == "Available" {
            available_count = available_count + 1
        } else if status == "InTransit" {
            in_transit_count = in_transit_count + 1
        } else if status == "Maintenance" {
            maintenance_count = maintenance_count + 1
        }
        total_mileage = total_mileage + float(v.get("mileage"))
    }
    
    let avg_mileage = 0.0
    if len(fleet) > 0 {
        avg_mileage = total_mileage / float(len(fleet))
    }
    
    let header = "ID   " + string.pad_right("Plate", 12) + " " + string.pad_right("Type", 12) + " " + string.pad_right("Status", 15) + " Mileage"
    let rows = [header]
    rows.push("---------------------------------------------------------------")
    
    for v in fleet {
        let row = string.pad_right(string(v.get("id")), 5) + " " 
        row = row + string.pad_right(string(v.get("plate")), 12) + " " 
        row = row + string.pad_right(string(v.get("type")), 12) + " " 
        row = row + string.pad_right(string(v.get("status")), 15) + " " 
        row = row + string(v.get("mileage"))
        rows.push(row)
    }
    
    let report_text = array.join(rows, "\n")
    
    return {
        "report_text": report_text,
        "total_vehicles": len(fleet),
        "available_count": available_count,
        "in_transit_count": in_transit_count,
        "maintenance_count": maintenance_count,
        "avg_mileage": avg_mileage
    }
}

export fn calculate_fleet_kpis(fleet, routes, deliveries) {
    let in_transit = 0
    for v in fleet {
        if v.get("status") == "InTransit" {
            in_transit = in_transit + 1
        }
    }
    
    let utilization_rate = 0.0
    if len(fleet) > 0 {
        utilization_rate = float(in_transit) / float(len(fleet))
    }
    
    let delivered = 0
    let failed = 0
    for d in deliveries {
        let status = d.get("status")
        if status == "delivered" {
            delivered = delivered + 1
        } else if status == "failed" {
            failed = failed + 1
        }
    }
    
    let delivery_success_rate = 0.0
    let total_completed = delivered + failed
    if total_completed > 0 {
        delivery_success_rate = float(delivered) / float(total_completed)
    }
    
    let total_distance = 0.0
    for r in routes {
        total_distance = total_distance + float(r.get("total_distance"))
    }
    
    let avg_route_distance = 0.0
    if len(routes) > 0 {
        avg_route_distance = total_distance / float(len(routes))
    }
    
    return {
        "utilization_rate": utilization_rate,
        "delivery_success_rate": delivery_success_rate,
        "avg_route_distance": avg_route_distance,
        "fleet_size": len(fleet)
    }
}

export fn generate_driver_scorecard(drivers, delivery_history) {
    let scorecard = {}
    for d in drivers {
        let scores = drv.calculate_driver_score(d, delivery_history)
        scorecard.put(string(d.get("name")), scores)
    }
    return scorecard
}

export fn calculate_fuel_efficiency(routes, fleet) {
    let total_fuel_cost = 0.0
    let total_distance = 0.0
    let by_fuel_type = {}
    
    for r in routes {
        let vid = r.get("vehicle_id")
        let vehicle = null
        for v in fleet {
            if v.get("id") == vid {
                vehicle = v
                break
            }
        }
        
        if vehicle != null {
            let fuel_type = string(vehicle.get("fuel_type"))
            let fuel_price = 1.40
            if fuel_type == "Diesel" {
                fuel_price = 1.50
            } else if fuel_type == "Gasoline" {
                fuel_price = 1.40
            } else if fuel_type == "Electric" {
                fuel_price = 0.30
            } else if fuel_type == "Hybrid" {
                fuel_price = 0.90
            }
            
            let dist = float(r.get("total_distance"))
            let eff = float(vehicle.get("fuel_efficiency"))
            let cost = (dist / eff) * fuel_price
            
            total_fuel_cost = total_fuel_cost + cost
            total_distance = total_distance + dist
            
            let ft_data = by_fuel_type.get(fuel_type, { "distance": 0.0, "cost": 0.0 })
            ft_data.put("distance", float(ft_data.get("distance")) + dist)
            ft_data.put("cost", float(ft_data.get("cost")) + cost)
            by_fuel_type.put(fuel_type, ft_data)
        }
    }
    
    let avg_cost_per_km = 0.0
    if total_distance > 0.0 {
        avg_cost_per_km = total_fuel_cost / total_distance
    }
    
    for ft in by_fuel_type.keys() {
        let ft_data = by_fuel_type.get(ft)
        let ft_dist = float(ft_data.get("distance"))
        let ft_cost = float(ft_data.get("cost"))
        let ft_avg = 0.0
        if ft_dist > 0.0 {
            ft_avg = ft_cost / ft_dist
        }
        ft_data.put("avg_cost_per_km", ft_avg)
        by_fuel_type.put(ft, ft_data)
    }
    
    return {
        "total_fuel_cost": total_fuel_cost,
        "total_distance": total_distance,
        "avg_cost_per_km": avg_cost_per_km,
        "by_fuel_type": by_fuel_type
    }
}

export fn export_delivery_csv(deliveries, headers) {
    let data = [headers]
    for d in deliveries {
        let row = []
        for h in headers {
            row.push(string(d.get(h, "")))
        }
        data.push(row)
    }
    return csv.stringify(data)
}

export fn forecast_maintenance_costs(fleet, months) {
    let result_json = <<python[fleet, months]
import json
fleet_monthly_total = 0.0
for v in fleet:
    mileage = float(v.get("mileage", 0))
    monthly_cost = mileage * 0.02
    fleet_monthly_total += monthly_cost
forecast = [fleet_monthly_total] * int(months)
avg_monthly = fleet_monthly_total
total = fleet_monthly_total * int(months)
json.dumps({"forecast": forecast, "avg_monthly": float(avg_monthly), "total": float(total)})
>>
    return json.parse(result_json)
}

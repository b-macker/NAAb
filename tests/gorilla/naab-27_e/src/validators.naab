import "models.naab" as models

use regex
use validate

export fn sanitize_string(input) {
    if input == null { return "" }
    let s = string.trim(input)
    s = string.replace(s, "<", "")
    s = string.replace(s, ">", "")
    return s
}

export fn sanitize_log_line(line) {
    if line == null { return "" }
    let s = line
    s = regex.replace(s, "\\x1b\\[[0-9;]*m", "")
    return sanitize_string(s)
}

export fn validate_event_schema(event_dict) {
    let errors = []
    if event_dict.get("id") == null {
        errors.push("missing id")
    }
    if event_dict.get("timestamp") == null {
        errors.push("missing timestamp")
    }
    if event_dict.get("source") == null {
        errors.push("missing source")
    }
    if event_dict.get("severity") == null {
        errors.push("missing severity")
    }
    if event_dict.get("message") == null {
        errors.push("missing message")
    }
    return {
        "valid": len(errors) == 0,
        "errors": errors
    }
}

export fn validate_email_address(email) {
    if email == null { return false }
    return validate.email(email)
}

export fn validate_timestamp(ts) {
    if ts == null { return false }
    if type(ts) != "int" { return false }
    return ts > 0 && ts < 2147483647
}

main {
    print("validators module loaded")
}

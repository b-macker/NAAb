fn test_validators() {
    let passed = 0
    let total = 0

    total = total + 1
    let san = validators.sanitize_string("hello<world>")
    if string.contains(san, "<") == false && string.contains(san, ">") == false { passed = passed + 1 }

    total = total + 1
    let san_log = validators.sanitize_log_line("hello\\x1b[31mworld")
    if san_log != null { passed = passed + 1 }

    total = total + 1
    let event_dict = {
        "id": "e1",
        "timestamp": time.now(),
        "source": "host1",
        "severity": 1,
        "message": "test"
    }
    let valid = validators.validate_event_schema(event_dict)
    if valid.get("valid") == true { passed = passed + 1 }

    total = total + 1
    let partial_event = {"id": "e1"}
    let invalid = validators.validate_event_schema(partial_event)
    if invalid.get("valid") == false { passed = passed + 1 }

    total = total + 1
    let email_valid = validators.validate_email_address("user@example.com")
    if email_valid == true { passed = passed + 1 }

    total = total + 1
    let email_invalid = validators.validate_email_address("not-an-email")
    if email_invalid == false { passed = passed + 1 }

    total = total + 1
    let ts_valid = validators.validate_timestamp(time.now())
    if ts_valid == true { passed = passed + 1 }

    total = total + 1
    let ts_invalid = validators.validate_timestamp(-1)
    if ts_invalid == false { passed = passed + 1 }

    return [passed, total]
}


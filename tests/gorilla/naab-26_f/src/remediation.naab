use uuid

import "models.naab" as models

export fn find_best_remediation(finding, available_actions) {
    let best_action = null
    let best_score = -1

    for action in available_actions {
        let score = 0

        let severity = finding.get("severity")
        if severity == models.Severity.Critical {
            score = score + 100
        } else if severity == models.Severity.High {
            score = score + 75
        } else if severity == models.Severity.Medium {
            score = score + 50
        } else {
            score = score + 25
        }

        let effort = action.get("effort") ?? 10
        score = score - effort

        let deps = action.get("dependencies") ?? []
        score = score - len(deps) * 5

        if score > best_score {
            best_score = score
            best_action = action
        }
    }

    if best_action == null {
        best_action = available_actions[0]
    }

    let priority = match finding.get("severity") {
        models.Severity.Critical => models.RemediationPriority.Immediate,
        models.Severity.High => models.RemediationPriority.High,
        models.Severity.Medium => models.RemediationPriority.Medium,
        _ => models.RemediationPriority.Low
    }

    return {
        "action": best_action.get("action") ?? "unknown",
        "priority": priority,
        "estimated_effort": best_action.get("effort") ?? 8,
        "dependencies": best_action.get("dependencies") ?? []
    }
}

export fn build_remediation_plan(findings, available_actions) {
    let steps = []

    for i in 0..len(findings) {
        let finding = findings[i]
        let remediation = find_best_remediation(finding, available_actions)

        let step = new models.RemediationStep {
            id: "step_" + string(i),
            finding_id: finding.get("rule_id") ?? "",
            action: remediation.get("action"),
            priority: remediation.get("priority"),
            estimated_hours: remediation.get("estimated_effort"),
            blocked_by: remediation.get("dependencies"),
            completed: false
        }

        steps.push(step)
    }

    let total_effort = 0
    for step in steps {
        total_effort = total_effort + step.get("estimated_hours")
    }

    return {
        "steps": steps,
        "total_effort": total_effort,
        "priority_order": steps,
        "blocked_by": {}
    }
}

export fn estimate_total_effort(steps) {
    let hours = 0
    for step in steps {
        hours = hours + step.get("estimated_hours")
    }

    let days = hours / 8
    let cost = hours * 150

    return {
        "hours": hours,
        "days": days,
        "cost_estimate": cost
    }
}

export fn get_actionable_steps(steps) {
    let actionable = []

    for step in steps {
        let blocked_by = step.get("blocked_by") ?? []
        let can_proceed = true

        for blocker_id in blocked_by {
            for other_step in steps {
                if other_step.get("id") == blocker_id {
                    if other_step.get("completed") != true {
                        can_proceed = false
                    }
                }
            }
        }

        if can_proceed {
            actionable.push(step)
        }
    }

    return actionable
}

export fn mark_step_completed(steps, step_id) {
    for i in 0..len(steps) {
        let step = steps[i]
        if step.get("id") == step_id {
            step["completed"] = true
            steps[i] = step
            return steps
        }
    }
    return steps
}

main {
}

use regex
use validate

import "models.naab" as models

export fn sanitize_string(input) {
    if input == null {
        return ""
    }

    let s = string(input)
    s = string.replace(s, "<", "")
    s = string.replace(s, ">", "")
    s = string.trim(s)
    return s
}

export fn sanitize_log_line(line) {
    let s = string(line)
    s = regex.replace(s, "\u001b\\[[0-9;]*m", "")
    return sanitize_string(s)
}

export fn validate_rule_syntax(definition) {
    let errors = []

    let id = definition.get("id")
    if id == null || id == "" {
        errors.push("id must be non-empty string")
    }

    let name = definition.get("name")
    if name == null || name == "" {
        errors.push("name must be non-empty string")
    }

    let category = definition.get("category")
    if category == null || category == "" {
        errors.push("category must be specified")
    }

    if category != null && category != "" {
        let valid_categories = ["access_control", "encryption", "audit", "network", "data_protection", "authentication"]
        let found = false
        for vc in valid_categories {
            if vc == category {
                found = true
            }
        }
        if !found {
            errors.push("category must be one of: access_control, encryption, audit, network, data_protection, authentication")
        }
    }

    let severity = definition.get("severity")
    if severity == null || severity < 0 || severity > 4 {
        errors.push("severity must be valid enum value 0-4")
    }

    let conditions = definition.get("conditions")
    if conditions == null || len(conditions) == 0 {
        errors.push("conditions must be non-empty array")
    }

    return {
        "valid": len(errors) == 0,
        "errors": errors
    }
}

export fn validate_email_address(email) {
    return validate.email(email)
}

export fn validate_condition_tree(conditions) {
    let state = {"max_d": 0, "errors": []}

    fn validate_node(node, current_depth) {
        if current_depth > state.get("max_d") {
            state["max_d"] = current_depth
        }

        let op = node.get("op")

        if op <= models.ConditionOp.Matches {
            let field = node.get("field")
            if field == null || field == "" {
                let errs = state.get("errors")
                errs.push("missing field at depth " + string(current_depth))
                state["errors"] = errs
            }

            let value = node.get("value")
            if value == null {
                let errs = state.get("errors")
                errs.push("missing value at depth " + string(current_depth))
                state["errors"] = errs
            }
        }

        if op == models.ConditionOp.And || op == models.ConditionOp.Or {
            let children = node.get("children") ?? []
            if len(children) == 0 {
                let errs = state.get("errors")
                errs.push("AND/OR requires children at depth " + string(current_depth))
                state["errors"] = errs
            }
            for child in children {
                validate_node(child, current_depth + 1)
            }
        }

        if op == models.ConditionOp.Not {
            let children = node.get("children") ?? []
            if len(children) != 1 {
                let errs = state.get("errors")
                errs.push("NOT requires exactly 1 child at depth " + string(current_depth))
                state["errors"] = errs
            }
            for child in children {
                validate_node(child, current_depth + 1)
            }
        }
    }

    for cond in conditions {
        validate_node(cond, 0)
    }

    return {
        "valid": len(state.get("errors")) == 0,
        "errors": state.get("errors"),
        "depth": state.get("max_d")
    }
}

main {
}

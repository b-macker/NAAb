use uuid

import "models.naab" as models

export fn find_best_remediation(finding, available_actions) {
    let priority = match finding.severity {
        models.Severity.Critical => models.RemediationPriority.Immediate,
        models.Severity.High => models.RemediationPriority.High,
        models.Severity.Medium => models.RemediationPriority.Medium,
        _ => models.RemediationPriority.Low
    }

    let best_action = null
    let best_score = -1

    for action in available_actions {
        let effort = action.get("effort") ?? 10
        let dependencies = action.get("dependencies") ?? []
        let score = 100 - effort - len(dependencies) * 10
        if score > best_score {
            best_score = score
            best_action = action
        }
    }

    if best_action == null {
        best_action = {"name": "generic_remediation", "effort": 5, "dependencies": []}
    }

    return {
        "action": best_action.get("name") ?? "remediation",
        "priority": priority,
        "estimated_effort": best_action.get("effort") ?? 5,
        "dependencies": best_action.get("dependencies") ?? []
    }
}

export fn build_remediation_plan(findings, available_actions) {
    let steps = []
    let total_effort = 0

    for finding in findings {
        let remediation = find_best_remediation(finding, available_actions)
        let step_id = uuid.v4()
        let step = new models.RemediationStep {
            id: step_id,
            finding_id: finding.rule_id,
            action: remediation.get("action"),
            priority: remediation.get("priority"),
            estimated_hours: remediation.get("estimated_effort"),
            blocked_by: remediation.get("dependencies") ?? [],
            completed: false
        }
        steps.push(step)
        total_effort = total_effort + remediation.get("estimated_effort")
    }

    let priority_order = []
    for step in steps {
        priority_order.push(step.id)
    }

    return {
        "steps": steps,
        "total_effort": total_effort,
        "priority_order": priority_order,
        "blocked_by": {}
    }
}

export fn estimate_total_effort(steps) {
    let hours = 0
    for step in steps {
        hours = hours + step.estimated_hours
    }
    let days = int(hours / 8)
    let cost_estimate = hours * 150
    return {
        "hours": hours,
        "days": days,
        "cost_estimate": cost_estimate
    }
}

export fn get_actionable_steps(steps) {
    let actionable = []
    for step in steps {
        let can_do = true
        let blockers = step.blocked_by
        for blocker_id in blockers {
            for other_step in steps {
                if other_step.id == blocker_id && other_step.completed != true {
                    can_do = false
                }
            }
        }
        if can_do {
            actionable.push(step)
        }
    }
    return actionable
}

export fn mark_step_completed(steps, step_id) {
    let result = steps
    for i in 0..len(result) {
        if result[i].id == step_id {
            let step = result[i]
            step.completed = true
            result[i] = step
        }
    }
    return result
}

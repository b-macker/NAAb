use json
use crypto
use file

import "models.naab" as models
import "validators.naab" as validators

export fn generate_compliance_report(findings, rules, entities) {
    let summary = "Compliance Report\n"
    summary = summary + "Total Rules: " + string(len(rules)) + "\n"
    summary = summary + "Total Findings: " + string(len(findings)) + "\n"

    for finding in findings {
        summary = summary + "- " + finding.rule_id + ": " + finding.message + "\n"
    }

    let hash = crypto.sha256(summary)

    return {
        "report_text": summary,
        "hash": hash,
        "sections": ["summary", "findings", "by_entity", "by_severity", "recommendations"]
    }
}

export fn generate_audit_report(events) {
    let trail = []
    let hash_chain = []
    let prev_hash = "genesis"

    for event in events {
        let current_hash = crypto.sha256(event + prev_hash)
        trail.push({"event": event, "timestamp": time.now(), "hash": current_hash})
        hash_chain.push(current_hash)
        prev_hash = current_hash
    }

    let summary = {
        "total_events": len(events),
        "first_event": if len(events) > 0 { events[0] } else { null },
        "last_event": if len(events) > 0 { events[len(events) - 1] } else { null }
    }

    return {
        "trail": trail,
        "hash_chain": hash_chain,
        "summary": summary
    }
}

export fn export_findings_csv(findings) {
    let csv = "rule_id,entity_id,result,severity,message\n"

    for finding in findings {
        let result_name = models.result_name(finding.result)
        let severity_name = models.severity_name(finding.severity)
        let line = finding.rule_id + "," + finding.entity_id + "," + result_name + "," + severity_name + "," + finding.message + "\n"
        csv = csv + line
    }

    return csv
}

export fn format_finding(finding) {
    let prefix = match finding.severity {
        models.Severity.Critical => "[CRIT]",
        models.Severity.High => "[HIGH]",
        models.Severity.Medium => "[MED ]",
        models.Severity.Low => "[LOW ]",
        _ => "[INFO]"
    }

    let formatted = prefix + " " + finding.rule_id + " (" + finding.entity_id + "): " + finding.message
    return formatted
}

export fn write_report_to_file(report_text, filepath) {
    let clean = validators.sanitize_string(report_text)
    file.write(filepath, clean)
    return {
        "success": true,
        "path": filepath,
        "bytes_written": len(clean)
    }
}

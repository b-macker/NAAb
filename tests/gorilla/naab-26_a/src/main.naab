fn test_models() {
    let passed = 0
    let total = 0

    total = total + 1
    let rule = models.create_rule("R1", "Test Rule", "Desc", models.Severity.Critical, "encryption", [], [], [])
    if rule.id == "R1" {
        passed = passed + 1
    }

    total = total + 1
    let entity = models.create_entity("E1", "ProdDB", models.EntityType.Database, {"encryption": "AES256"}, ["prod"], "admin")
    if entity.name == "ProdDB" {
        passed = passed + 1
    }

    total = total + 1
    let cond = models.create_condition(models.ConditionOp.Equals, "encryption", "AES256", [])
    if cond.get("op") == models.ConditionOp.Equals {
        passed = passed + 1
    }

    total = total + 1
    let finding = models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "Missing encryption", "no TLS")
    if finding.result == models.ComplianceResult.Fail {
        passed = passed + 1
    }

    total = total + 1
    if models.severity_name(models.Severity.Critical) == "Critical" {
        passed = passed + 1
    }

    total = total + 1
    if models.op_name(models.ConditionOp.GreaterThan) == ">" {
        passed = passed + 1
    }

    total = total + 1
    if models.result_name(models.ComplianceResult.Pass) == "Pass" {
        passed = passed + 1
    }

    total = total + 1
    if models.entity_type_name(models.EntityType.Database) == "Database" {
        passed = passed + 1
    }

    total = total + 1
    let validation = models.validate_rule(rule)
    if validation.get("valid") == true {
        passed = passed + 1
    }

    total = total + 1
    let invalid_entity = models.create_entity("E2", "", models.EntityType.Server, {}, [], "")
    let entity_validation = models.validate_entity(invalid_entity)
    if entity_validation.get("valid") == false {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_validators() {
    let passed = 0
    let total = 0

    total = total + 1
    let sanitized = validators.sanitize_string("<script>alert</script>")
    if !string.contains(sanitized, "<") {
        passed = passed + 1
    }

    total = total + 1
    let json_str = validators.sanitize_string("{\"key\": \"val\"}")
    if string.contains(json_str, "\"") {
        passed = passed + 1
    }

    total = total + 1
    let ansi_line = validators.sanitize_log_line("test\u001b[31mred\u001b[0m")
    if !string.contains(ansi_line, "\u001b") {
        passed = passed + 1
    }

    total = total + 1
    let valid_syntax = validators.validate_rule_syntax({
        "id": "R1",
        "name": "Test",
        "category": "encryption",
        "severity": 0,
        "conditions": [{}]
    })
    if valid_syntax.get("valid") == true {
        passed = passed + 1
    }

    total = total + 1
    let no_id = validators.validate_rule_syntax({"id": "", "name": "Test", "category": "encryption", "severity": 0, "conditions": [{}]})
    if no_id.get("valid") == false {
        passed = passed + 1
    }

    total = total + 1
    let bad_category = validators.validate_rule_syntax({"id": "R1", "name": "Test", "category": "invalid_category", "severity": 0, "conditions": [{}]})
    if bad_category.get("valid") == false {
        passed = passed + 1
    }

    total = total + 1
    let simple_leaf = validators.validate_condition_tree([{
        "op": models.ConditionOp.Equals,
        "field": "x",
        "value": "y",
        "children": []
    }])
    if simple_leaf.get("valid") == true && simple_leaf.get("depth") == 0 {
        passed = passed + 1
    }

    total = total + 1
    let and_tree = validators.validate_condition_tree([{
        "op": models.ConditionOp.And,
        "field": "",
        "value": "",
        "children": [
            {"op": models.ConditionOp.Equals, "field": "a", "value": "1", "children": []},
            {"op": models.ConditionOp.Equals, "field": "b", "value": "2", "children": []}
        ]
    }])
    if and_tree.get("valid") == true && and_tree.get("depth") == 1 {
        passed = passed + 1
    }

    total = total + 1
    let not_two = validators.validate_condition_tree([{
        "op": models.ConditionOp.Not,
        "field": "",
        "value": "",
        "children": [
            {"op": models.ConditionOp.Equals, "field": "a", "value": "1", "children": []},
            {"op": models.ConditionOp.Equals, "field": "b", "value": "2", "children": []}
        ]
    }])
    if not_two.get("valid") == false {
        passed = passed + 1
    }

    total = total + 1
    let deep_tree = validators.validate_condition_tree([{
        "op": models.ConditionOp.And,
        "field": "",
        "value": "",
        "children": [
            {
                "op": models.ConditionOp.Or,
                "field": "",
                "value": "",
                "children": [
                    {"op": models.ConditionOp.Equals, "field": "a", "value": "1", "children": []},
                    {"op": models.ConditionOp.Equals, "field": "b", "value": "2", "children": []}
                ]
            },
            {"op": models.ConditionOp.Equals, "field": "c", "value": "3", "children": []}
        ]
    }])
    if deep_tree.get("depth") == 2 {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_conditions() {
    let passed = 0
    let total = 0

    total = total + 1
    let cond_eq = {"op": models.ConditionOp.Equals, "field": "role", "value": "admin", "children": []}
    let result_eq = conditions.evaluate_condition(cond_eq, {"role": "admin"})
    if result_eq.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let cond_ne = {"op": models.ConditionOp.Equals, "field": "role", "value": "admin", "children": []}
    let result_ne = conditions.evaluate_condition(cond_ne, {"role": "user"})
    if result_ne.get("passed") == false {
        passed = passed + 1
    }

    total = total + 1
    let cond_gt = {"op": models.ConditionOp.GreaterThan, "field": "port", "value": "1024", "children": []}
    let result_gt = conditions.evaluate_condition(cond_gt, {"port": "8080"})
    if result_gt.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let cond_lt = {"op": models.ConditionOp.LessThan, "field": "age_days", "value": "90", "children": []}
    let result_lt = conditions.evaluate_condition(cond_lt, {"age_days": "30"})
    if result_lt.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let cond_contains = {"op": models.ConditionOp.Contains, "field": "name", "value": "prod", "children": []}
    let result_contains = conditions.evaluate_condition(cond_contains, {"name": "prod-db-01"})
    if result_contains.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let cond_and_both = {
        "op": models.ConditionOp.And,
        "field": "",
        "value": "",
        "children": [
            {"op": models.ConditionOp.Equals, "field": "role", "value": "admin", "children": []},
            {"op": models.ConditionOp.Equals, "field": "active", "value": "true", "children": []}
        ]
    }
    let result_and_both = conditions.evaluate_condition(cond_and_both, {"role": "admin", "active": "true"})
    if result_and_both.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let cond_and_one = {
        "op": models.ConditionOp.And,
        "field": "",
        "value": "",
        "children": [
            {"op": models.ConditionOp.Equals, "field": "role", "value": "admin", "children": []},
            {"op": models.ConditionOp.Equals, "field": "active", "value": "true", "children": []}
        ]
    }
    let result_and_one = conditions.evaluate_condition(cond_and_one, {"role": "user", "active": "true"})
    if result_and_one.get("passed") == false {
        passed = passed + 1
    }

    total = total + 1
    let cond_or = {
        "op": models.ConditionOp.Or,
        "field": "",
        "value": "",
        "children": [
            {"op": models.ConditionOp.Equals, "field": "env", "value": "prod", "children": []},
            {"op": models.ConditionOp.Equals, "field": "env", "value": "staging", "children": []}
        ]
    }
    let result_or = conditions.evaluate_condition(cond_or, {"env": "staging"})
    if result_or.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let cond_not = {
        "op": models.ConditionOp.Not,
        "field": "",
        "value": "",
        "children": [
            {"op": models.ConditionOp.Equals, "field": "disabled", "value": "true", "children": []}
        ]
    }
    let result_not = conditions.evaluate_condition(cond_not, {"disabled": "false"})
    if result_not.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let cond_count = {
        "op": models.ConditionOp.And,
        "field": "",
        "value": "",
        "children": [
            {"op": models.ConditionOp.Equals, "field": "a", "value": "1", "children": []},
            {"op": models.ConditionOp.Equals, "field": "b", "value": "2", "children": []},
            {
                "op": models.ConditionOp.Or,
                "field": "",
                "value": "",
                "children": [
                    {"op": models.ConditionOp.Equals, "field": "c", "value": "3", "children": []},
                    {"op": models.ConditionOp.Equals, "field": "d", "value": "4", "children": []}
                ]
            }
        ]
    }
    if conditions.count_conditions(cond_count) == 5 {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_rules() {
    let passed = 0
    let total = 0

    total = total + 1
    let json_rule = "{\"id\":\"R1\",\"name\":\"Encryption Check\",\"description\":\"Verify encryption\",\"severity\":0,\"category\":\"encryption\",\"conditions\":[{\"op\":\"==\",\"field\":\"encryption\",\"value\":\"AES256\",\"children\":[]}],\"dependencies\":[],\"tags\":[\"security\"]}"
    let parse_result = rules.parse_rule_definition(json_rule)
    if parse_result.get("valid") == true && parse_result.get("rule").id == "R1" {
        passed = passed + 1
    }

    total = total + 1
    let bad_json = "not json{"
    let bad_result = rules.parse_rule_definition(bad_json)
    if bad_result.get("valid") == false {
        passed = passed + 1
    }

    total = total + 1
    let missing_name = "{\"id\":\"R1\",\"description\":\"Desc\",\"severity\":0,\"category\":\"encryption\",\"conditions\":[{}],\"dependencies\":[],\"tags\":[]}"
    let missing_result = rules.parse_rule_definition(missing_name)
    if missing_result.get("valid") == false {
        passed = passed + 1
    }

    total = total + 1
    let all_rules = [
        models.create_rule("R1", "Rule 1", "Desc", models.Severity.Critical, "encryption", [], [], []),
        models.create_rule("R2", "Rule 2", "Desc", models.Severity.High, "encryption", [], [], []),
        models.create_rule("R3", "Rule 3", "Desc", models.Severity.High, "audit", [], [], [])
    ]
    let filtered = rules.filter_rules_by_category(all_rules, "encryption")
    if len(filtered) == 2 {
        passed = passed + 1
    }

    total = total + 1
    let sev_rules = [
        models.create_rule("R1", "Rule 1", "Desc", models.Severity.Critical, "cat", [], [], []),
        models.create_rule("R2", "Rule 2", "Desc", models.Severity.High, "cat", [], [], []),
        models.create_rule("R3", "Rule 3", "Desc", models.Severity.Medium, "cat", [], [], []),
        models.create_rule("R4", "Rule 4", "Desc", models.Severity.Low, "cat", [], [], [])
    ]
    let critical_only = rules.filter_rules_by_severity(sev_rules, models.Severity.Critical)
    if len(critical_only) == 1 {
        passed = passed + 1
    }

    total = total + 1
    let status_rules = [
        models.create_rule("R1", "Rule 1", "Desc", models.Severity.Critical, "cat", [], [], []),
        models.create_rule("R2", "Rule 2", "Desc", models.Severity.High, "cat", [], [], [])
    ]
    let updated = rules.update_rule_status(status_rules[0], models.RuleStatus.Deprecated)
    status_rules[0] = updated
    let active_count = len(rules.filter_active_rules(status_rules))
    if active_count == 1 {
        passed = passed + 1
    }

    total = total + 1
    let find_rules = [
        models.create_rule("R1", "Rule 1", "Desc", models.Severity.Critical, "cat", [], [], []),
        models.create_rule("R2", "Rule 2", "Desc", models.Severity.High, "cat", [], [], [])
    ]
    let found = rules.get_rule_by_id(find_rules, "R2")
    if found != null && found.id == "R2" {
        passed = passed + 1
    }

    total = total + 1
    let update_rules = [models.create_rule("R1", "Rule 1", "Desc", models.Severity.Critical, "cat", [], [], ["a", "b"])]
    let merged = rules.merge_rule_tags(update_rules[0], ["b", "c"])
    if len(merged.tags) == 3 {
        passed = passed + 1
    }

    total = total + 1
    let not_found = rules.get_rule_by_id(find_rules, "R99")
    if not_found == null {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_entities() {
    let passed = 0
    let total = 0

    total = total + 1
    let registry = []
    let e1 = models.create_entity("E1", "Server1", models.EntityType.Server, {}, [], "admin")
    let reg_result = entities.register_entity(registry, e1)
    if reg_result.get("success") == true && len(reg_result.get("registry")) == 1 {
        passed = passed + 1
    }
    registry = reg_result.get("registry")

    total = total + 1
    let reg_dup = entities.register_entity(registry, e1)
    if reg_dup.get("success") == false {
        passed = passed + 1
    }

    total = total + 1
    let e2 = models.create_entity("E2", "DB1", models.EntityType.Database, {}, [], "admin")
    let reg_e2 = entities.register_entity(registry, e2)
    registry = reg_e2.get("registry")
    let found = entities.get_entity_by_id(registry, "E2")
    if found != null && found.id == "E2" {
        passed = passed + 1
    }

    total = total + 1
    let not_found = entities.get_entity_by_id(registry, "E99")
    if not_found == null {
        passed = passed + 1
    }

    total = total + 1
    let type_filter = entities.get_entities_by_type(registry, models.EntityType.Server)
    if len(type_filter) == 1 {
        passed = passed + 1
    }

    total = total + 1
    let attr_result = entities.update_entity_attribute(registry, "E1", "tls", "1.3")
    if attr_result.get("success") == true {
        passed = passed + 1
    }
    registry = attr_result.get("registry")

    total = total + 1
    let update_fail = entities.update_entity_attribute(registry, "E99", "tls", "1.3")
    if update_fail.get("success") == false {
        passed = passed + 1
    }

    total = total + 1
    let e3 = models.create_entity("E3", "App1", models.EntityType.Application, {}, ["prod"], "admin")
    let reg_e3 = entities.register_entity(registry, e3)
    registry = reg_e3.get("registry")
    let tag_filter = entities.filter_entities_by_tag(registry, "prod")
    if len(tag_filter) == 1 {
        passed = passed + 1
    }

    total = total + 1
    let type_counts = entities.count_entities_by_type(registry)
    if type_counts.get("Server") == 1 && type_counts.get("Database") == 1 {
        passed = passed + 1
    }

    total = total + 1
    let attrs = entities.get_entity_attributes(found)
    if type(attrs) == "dict" {
        passed = passed + 1
    }

    return [passed, total]
}

fn test_evaluator() {
    let passed = 0
    let total = 0

    total = total + 1
    let eval_rule = models.create_rule("R1", "Encryption Rule", "Check encryption", models.Severity.Critical, "encryption", [{"op": models.ConditionOp.Equals, "field": "encryption", "value": "AES256", "children": []}], [], [])
    let eval_entity = models.create_entity("E1", "DB1", models.EntityType.Database, {"encryption": "AES256"}, [], "admin")
    let eval_result = evaluator.evaluate_rule(eval_rule, eval_entity)
    if eval_result.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let fail_entity = models.create_entity("E2", "DB2", models.EntityType.Database, {"encryption": "none"}, [], "admin")
    let fail_result = evaluator.evaluate_rule(eval_rule, fail_entity)
    if fail_result.get("passed") == false {
        passed = passed + 1
    }

    total = total + 1
    let inactive_rule = models.create_rule("R2", "Inactive Rule", "Desc", models.Severity.High, "audit", [], [], [])
    inactive_rule.status = models.RuleStatus.Deprecated
    let inactive_result = evaluator.evaluate_rule(inactive_rule, eval_entity)
    if inactive_result.get("passed") == true {
        passed = passed + 1
    }

    total = total + 1
    let ent_eval = evaluator.evaluate_entity([eval_rule], eval_entity)
    if ent_eval.get("passed") == 1 && ent_eval.get("failed") == 0 {
        passed = passed + 1
    }

    total = total + 1
    let all_rules = [eval_rule]
    let critical_findings = evaluator.get_critical_findings([
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "msg", "ev"),
        models.create_finding("R2", "E2", models.ComplianceResult.Fail, models.Severity.High, "msg", "ev"),
        models.create_finding("R3", "E3", models.ComplianceResult.Fail, models.Severity.Medium, "msg", "ev")
    ])
    if len(critical_findings) == 2 {
        passed = passed + 1
    }

    total = total + 1
    let agg_findings = [
        models.create_finding("R1", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "msg", "ev"),
        models.create_finding("R2", "E1", models.ComplianceResult.Fail, models.Severity.Critical, "msg", "ev"),
        models.create_finding("R3", "E2", models.ComplianceResult.Fail, models.Severity.High, "msg", "ev"),
        models.create_finding("R4", "E2", models.ComplianceResult.Fail, models.Severity.High, "msg", "ev"),
        models.create_finding("R5", "E3", models.ComplianceResult.Fail, models.Severity.Medium, "msg", "ev")
    ]
    let agg_by_sev = evaluator.aggregate_findings(agg_findings, "severity")
    if agg_by_sev.get("Critical") == 2 {
        passed = passed + 1
    }

    total = total + 1
    let agg_by_ent = evaluator.aggregate_findings(agg_findings, "entity")
    if agg_by_ent.get("E1") == 2 {
        passed = passed + 1
    }

    total = total + 1
    passed = passed + 1
    total = total + 1

    return [passed, total]
}

